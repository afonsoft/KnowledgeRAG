## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Host-specific compose layer (SPEC-20260916-compose-vault-mount) —
# commit docker-compose.override.yml.example as the reference instead.
docker-compose.override.yml

# Others
~$*
*~
CodeCoverage/

# Deployment artifacts (SPEC-20260913-install-deploy)
publish/
data/
knowledgehub.db

# skills.sh CLI canonical store (.claude/skills/ symlinks here; restore via `npx skills experimental_install`)
.agents/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Agent harness local overrides (never versioned)
.devin/
.claude/settings.local.json

# ONNX model artifacts (SPEC-20260917-onnx-local-embeddings) — downloaded
# externally, never committed (~90 MB).
models/
*.onnx


# Backup/restore runtime artifacts (integration tests + backup.sh)
backups/

# SonarQube autofix artifacts
.sonar_devin_auto_fix/**

# Python SDK (sdks/python)
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/

# Java SDK (sdks/java)
target/

# Go SDK (sdks/go)
sdks/go/knowledgehub
