<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KnowledgeHub.Review</RootNamespace>
    <AssemblyName>knowledge-review</AssemblyName>
    <Description>
      Knowledge Review — self-hosted AI code review CLI (SPEC-20261007-knowledge-review).
      Collects GitHub PR review signals, analyzes the diff with an LLM against repo
      conventions, publishes Devin-Review-style comments/status and approves with
      auto-merge, persisting every review to the Knowledge MCP Hub.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="Octokit.GraphQL" Version="0.4.0-beta" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnowledgeHub.Tests.Unit" />
    <ProjectReference Include="..\..\sdks\dotnet\KnowledgeHub.Sdk\KnowledgeHub.Sdk.csproj" />
  </ItemGroup>

</Project>
