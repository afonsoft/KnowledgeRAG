<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Ship a single ICU variant covering all non-CJK cultures (pt-BR and
         every Latin script) instead of the four files the runtime pack emits —
         the PWA service worker precaches every published asset, so the unused
         full/CJK/EFIGS variants were downloaded on first load regardless. -->
    <BlazorIcuDataFileName>icudt_no_CJK.dat</BlazorIcuDataFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BootstrapBlazor" Version="10.10.2" />
    <PackageReference Include="BootstrapBlazor.FontAwesome" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnowledgeHub.Shared\KnowledgeHub.Shared.csproj" />
  </ItemGroup>

  <!-- PWA (SPEC-20260918-ui-layout-polish): dev worker = no-op, published
       worker precaches the app shell. The SDK swaps them at publish and
       emits service-worker-assets.js with the asset manifest. -->
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
