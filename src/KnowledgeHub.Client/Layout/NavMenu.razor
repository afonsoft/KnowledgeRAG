@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject KhAuthenticationStateProvider AuthState

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback OnNavItemClicked { get; set; }

    private async Task OnItemClick()
    {
        if (OnNavItemClicked.HasDelegate)
            await OnNavItemClicked.InvokeAsync();
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        AuthState.Invalidate();
        Nav.NavigateTo("/login");
    }
}
