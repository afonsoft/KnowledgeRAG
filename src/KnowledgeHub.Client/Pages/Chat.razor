@page "/chat"
@attribute [Authorize]
@using KnowledgeHub.Shared.Contracts
@inject ThreadsApiClient Threads
@inject StreamingApiClient Streaming
@inject ToastService Toast
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["Chat_PageTitle"]</PageTitle>
<h1 class="visually-hidden">Chat</h1>

<div class="row g-3">
    @* Mobile: a lista de conversas cede lugar à conversa aberta — volta pelo
       botão ← no cabeçalho do card. Em ≥lg as duas colunas convivem. *@
    <div class="col-12 col-lg-3 chat-thread-panel @(_current is not null ? "d-none d-lg-block" : "")">
        <Card>
            <HeaderTemplate>
                <div class="d-flex justify-content-between gap-2 align-items-center">
                    <span>@L["Chat_Threads"]</span>
                    <Button Size="Size.Small" Icon="fa-solid fa-plus" Text="@L["Chat_New"]" TooltipText="@L["Chat_NewTooltip"]" IsAsync="true"
                            OnClick="NewThreadAsync" />
                </div>
            </HeaderTemplate>
            <BodyTemplate>
                <div class="list-group list-group-flush">
                    @foreach (var t in _threads)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(t.Id == _current?.Thread.Id ? "active" : "")"
                                @onclick="() => OpenThreadAsync(t.Id)">
                            <div class="text-truncate">@t.Title</div>
                            <small class="@(t.Id == _current?.Thread.Id ? "" : "text-muted")">
                                @L["Chat_Msgs", t.MessageCount]
                                @if (t.Summarized)
                                {
                                    <span>· @L["Chat_Summarized"]</span>
                                }
                            </small>
                        </button>
                    }
                </div>
            </BodyTemplate>
        </Card>
    </div>

    <div class="col-12 col-lg-9">
        @if (_current is null)
        {
            <div class="text-center text-muted py-5">
                @L["Chat_Empty"]
            </div>
        }
        else
        {
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                            <button type="button" class="btn btn-outline-secondary btn-sm d-lg-none"
                                    title="@L["Chat_BackToList"]" aria-label="@L["Chat_BackToList"]"
                                    @onclick="BackToList">
                                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                            </button>
                            <span class="text-truncate">@_current.Thread.Title</span>
                        </div>
                        <div class="flex-shrink-0">
                            @if (_current.Summary is not null)
                            {
                                <Badge Color="Color.Info" class="me-2">@L["Chat_SummaryBadge"]</Badge>
                            }
                            <PopConfirmButton Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-trash" Text="@L["Common_Delete"]"
                                              TooltipText="@L["Chat_DeleteTooltip"]"
                                              Title="@L["Chat_DeleteTitle"]"
                                              Content="@L["Chat_DeleteContent"]"
                                              IsAsync="true" OnConfirm="DeleteThreadAsync" />
                        </div>
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div role="log" aria-live="polite" aria-label="@L["Chat_LogLabel"]"
                         style="max-height: 480px; overflow-y: auto;">
                        @foreach (var m in _current.Messages)
                        {
                            <div class="mb-2 p-2 rounded chat-message-bubble @MessageBubbleClass(m.Role)">
                                <small class="text-muted">
                                    @(m.Role == "tool" ? $"tool {m.ToolName}" : m.Role) · @m.CreatedAt.LocalDateTime.ToString("T")
                                </small>
                                <div style="white-space: pre-wrap;">@m.Content</div>
                            </div>
                        }
                        @if (_pendingUser is not null)
                        {
                            <div class="mb-2 p-2 rounded chat-message-bubble bg-primary bg-opacity-10 ms-auto">
                                <small class="text-muted">user</small>
                                <div style="white-space: pre-wrap;">@_pendingUser</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_streamText))
                        {
                            <div class="mb-2 p-2 rounded chat-message-bubble bg-light">
                                <small class="text-muted">assistant · streaming</small>
                                <div style="white-space: pre-wrap;">@_streamText</div>
                            </div>
                        }
                        else if (_sending)
                        {
                            <div class="mb-2 p-2 rounded chat-message-bubble bg-light kh-action-loading">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                <small class="text-muted">@L["Chat_Waiting"]</small>
                            </div>
                        }
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <BootstrapInput @bind-Value="_draft" PlaceHolder="@L["Chat_Placeholder"]"
                                        IsDisabled="_sending"
                                        OnEnterAsync="_ => SendAsync()" />
                        <Button Color="Color.Primary" Icon="fa-solid fa-paper-plane" Text="@L["Chat_Send"]"
                                TooltipText="@L["Chat_SendTooltip"]"
                                IsAsync="true" OnClick="SendAsync" IsDisabled="_sending" />
                    </div>
                </BodyTemplate>
            </Card>
        }
    </div>
</div>

@code {
    private List<ThreadDto> _threads = [];
    private ThreadDetailDto? _current;
    private string? _draft;
    private bool _sending;
    private string? _pendingUser;
    private string _streamText = "";

    protected override async Task OnInitializedAsync() => await LoadThreadsAsync();

    private async Task LoadThreadsAsync()
    {
        try { _threads = (await Threads.ListAsync()).ToList(); }
        catch (Exception ex) { await Toast.Error(L["Chat_ListError"], ex.Message); }
    }

    private async Task NewThreadAsync()
    {
        var t = await Threads.CreateAsync();
        await LoadThreadsAsync();
        if (t is not null)
            await OpenThreadAsync(t.Id);
    }

    private async Task OpenThreadAsync(Guid id)
    {
        _current = await Threads.GetAsync(id);
    }

    /// <summary>Mobile: fecha a conversa e reexibe a lista de conversas.</summary>
    private void BackToList()
    {
        _current = null;
    }

    private async Task DeleteThreadAsync()
    {
        if (_current is null) return;
        await Threads.DeleteAsync(_current.Thread.Id);
        _current = null;
        await LoadThreadsAsync();
    }

    private async Task SendAsync()
    {
        if (_current is null || string.IsNullOrWhiteSpace(_draft)) return;
        _sending = true;
        _streamText = "";
        var threadId = _current.Thread.Id;
        var content = _draft!;
        _pendingUser = content;
        _draft = null;
        var received = false;
        try
        {
            // Stream via /api/agent/stream (same AgentRequest shape as the
            // blocking /api/threads/{id}/messages). If the connection never
            // yields an event — auth issue, proxy buffering — fall back to the
            // sync POST so no send is silently lost.
            try
            {
                await foreach (var msg in Streaming.StreamAsync(
                                   "api/agent/stream",
                                   new AgentRequest { Prompt = content, ThreadId = threadId }))
                {
                    received = true;
                    HandleStreamEvent(msg);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                if (!received)
                {
                    _streamText = "";
                    await Threads.SendAsync(threadId, content);
                }
                else
                {
                    await Toast.Error(L["Chat_StreamError"], ex.Message);
                }
            }
            _current = await Threads.GetAsync(threadId);
            await LoadThreadsAsync();
        }
        catch (Exception ex)
        {
            await Toast.Error(L["Chat_SendError"], ex.Message);
        }
        finally
        {
            _sending = false;
            _pendingUser = null;
            _streamText = "";
        }
    }

    private void HandleStreamEvent(StreamingApiClient.SseMessage msg)
    {
        var data = msg.Data.TryGetProperty("data", out var d) ? d : msg.Data;
        switch (msg.Event)
        {
            case "token":
                _streamText += data.TryGetProperty("delta", out var delta) ? delta.GetString() : "";
                break;
            case "tool_start":
                _streamText += $"\n\n— tool {(data.TryGetProperty("tool", out var t) ? t.GetString() : "?")} —\n\n";
                break;
            case "awaiting_approval":
                _streamText += L["Chat_AwaitingApproval"].Value;
                break;
            case "error":
                _streamText += "\n\n" + L["Chat_StreamErrFmt", (data.TryGetProperty("message", out var m) ? m.GetString() : null) ?? "stream error"].Value;
                break;
            // done: the persisted thread is reloaded afterwards — ignore.
        }
    }

    private static string MessageBubbleClass(string role) => role switch
    {
        "user" => "bg-primary bg-opacity-10 ms-auto",
        "tool" => "bg-secondary bg-opacity-10",
        _ => "bg-light"
    };
}
