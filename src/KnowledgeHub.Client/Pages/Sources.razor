@page "/sources"
@attribute [Authorize]
@using System.Text.Json.Nodes
@inject SourceApiClient Api
@inject ToastService Toast
@inject McpMonitorClient Hub
@implements IAsyncDisposable

<PageTitle>Fontes — Knowledge</PageTitle>

<h3 class="mb-3">Fontes de conhecimento</h3>

<div class="table-responsive-wrapper">
    <Table TItem="KnowledgeSourceDto" Items="_sources" ShowLoading="true" ShowLoadingInFirstRender="true"
           IsStriped="true" ShowToolbar="true" ShowDefaultButtons="false" ShowEmpty="true"
           EmptyText="Nenhuma fonte cadastrada.">
    <TableToolbarTemplate>
        <TableToolbarButton TItem="KnowledgeSourceDto" Text="Nova fonte" Icon="fa-solid fa-plus"
                            Title="Nova fonte" Color="Color.Primary" OnClick="ShowCreate" />
    </TableToolbarTemplate>
    <TableColumns>
        <TableColumn Field="@context.Name" FieldExpression="@(() => context.Name)" Text="Nome" />
        <TableColumn Field="@context.Type" FieldExpression="@(() => context.Type)" Text="Tipo">
            <Template Context="v">
                <Badge Color="Color.Info">@v.Value</Badge>
            </Template>
        </TableColumn>
        <TableColumn Field="@context.IsActive" FieldExpression="@(() => context.IsActive)" Text="Ativa">
            <Template Context="v">
                @if (v.Value)
                {
                    <Badge Color="Color.Success">ativa</Badge>
                }
                else
                {
                    <Badge Color="Color.Secondary">inativa</Badge>
                }
            </Template>
        </TableColumn>
        <TableColumn Field="@context.LastSyncAt" FieldExpression="@(() => context.LastSyncAt)" Text="Último sync" Width="120">
            <Template Context="v">
                @(v.Value?.LocalDateTime.ToString("dd/MM/yy HH:mm") ?? "—")
            </Template>
        </TableColumn>
        <TableColumn Field="@context.LastSyncStatus" FieldExpression="@(() => context.LastSyncStatus)" Text="Status" Width="110">
            <Template Context="v">
                @* SPEC-20260925-sources-grid-ux RF-003: status badge opens the
                   error/job detail modal when there is something to show. *@
                @{
                    var hasDetail = !string.IsNullOrEmpty(v.Row.LastError);
                }
                @switch (v.Row.LastSyncStatus)
                {
                    case "completed":
                        @* completed jobs can carry warnings — keep the detail
                           modal reachable (it lists them when present). *@
                        <button type="button" class="kh-badge-btn" title="Clique para ver detalhes"
                                aria-label="Ver detalhes do status"
                                @onclick="() => ShowStatusDetail(v.Row)">
                            <Badge Color="Color.Success">ok</Badge>
                        </button>
                        break;
                    case "failed":
                        <button type="button" class="kh-badge-btn" title="Clique para ver detalhes"
                                aria-label="Ver detalhes do status"
                                @onclick="() => ShowStatusDetail(v.Row)">
                            <Badge Color="Color.Danger">falhou</Badge>
                        </button>
                        break;
                    case "skipped":
                        <button type="button" class="kh-badge-btn" title="Clique para ver detalhes"
                                aria-label="Ver detalhes do status"
                                @onclick="() => ShowStatusDetail(v.Row)">
                            <Badge Color="Color.Warning">skip</Badge>
                        </button>
                        break;
                    default:
                        <span class="text-muted">—</span>
                        break;
                }
            </Template>
        </TableColumn>
        <TableColumn Field="@context.Id" FieldExpression="@(() => context.Id)" Text="Ações" Width="120">
            <Template Context="v">
                <div class="kh-actions">
                    <Button Size="Size.ExtraSmall" Icon="fa-solid fa-pen" TooltipText="Editar"
                            TooltipPlacement="Placement.Top"
                            OnClick="() => ShowEdit(v.Row)" />
                    <Button Size="Size.ExtraSmall" Icon="fa-solid fa-rotate" TooltipText="Sync"
                            TooltipPlacement="Placement.Top"
                            OnClick="() => SyncNow(v.Row)" />
                    <Button Size="Size.ExtraSmall" Color="Color.Warning"
                            Icon="@(v.Row.IsActive ? "fa-solid fa-pause" : "fa-solid fa-play")"
                            TooltipText="@(v.Row.IsActive ? "Desativar" : "Ativar")"
                            TooltipPlacement="Placement.Top"
                            OnClick="() => ToggleActive(v.Row)" />
                    <PopConfirmButton Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-trash"
                                      TooltipText="Excluir" TooltipPlacement="Placement.Top"
                                      Title="Confirmar exclusão"
                                      Content="Documentos e chunks indexados serão removidos."
                                      OnConfirm="() => DeleteSource(v.Row)" />
                </div>
            </Template>
        </TableColumn>
    </TableColumns>
    </Table>
</div>

<Modal @ref="_modal">
    <ModalDialog Title="@(_editModel.Id is null ? "Nova fonte" : $"Editar — {_editModel.Name}")"
                 Size="Size.Large" ShowSaveButton="true" SaveButtonText="Salvar" SaveButtonIcon="fa-solid fa-floppy-disk"
                 CloseButtonText="Cancelar" CloseButtonIcon="fa-solid fa-xmark" OnSaveAsync="SaveAsync">
        <BodyTemplate>
            @* String params need @ — bare Error="_editError" passes the literal
               text, not the field value (Blazor string-attribute rule). *@
            <SourceEditDialog @ref="_edit" Model="_editModel" Error="@_editError" ErrorDetail="@_editErrorDetail"
                              Source="_editSource" Documents="_editDocuments"
                              SummaryLoading="_summaryLoading" SummaryFailed="_summaryFailed"
                              SyncResult="_syncResult" SyncRunning="_syncRunning" SyncError="@_syncError"
                              OnSyncRequested="SyncFromDialogAsync" />
        </BodyTemplate>
    </ModalDialog>
</Modal>

@* SPEC-20260925-sources-grid-ux RF-003: status/error detail modal. *@
<Modal @ref="_statusModal">
    <ModalDialog Title="@($"Status — {_statusSource?.Name}")" ShowSaveButton="false" CloseButtonText="Fechar" CloseButtonIcon="fa-solid fa-xmark">
        <BodyTemplate>
            @if (_statusSource is not null)
            {
                <dl class="row mb-3">
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@_statusSource.LastSyncStatus</dd>
                    <dt class="col-sm-3">Último sync</dt>
                    <dd class="col-sm-9">@(_statusSource.LastSyncAt?.LocalDateTime.ToString("g") ?? "—")</dd>
                </dl>

                @if (!string.IsNullOrEmpty(_statusSource.LastError))
                {
                    <h6>Erro / log</h6>
                    <div style="max-height:200px;overflow-y:auto">
                        <ul class="mb-0 small">
                            @foreach (var line in _statusSource.LastError.Split("; ", StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>
                }

                <h6 class="mt-3">Último job</h6>
                @if (_statusJobLoading)
                {
                    <p class="text-muted small mb-0">Carregando…</p>
                }
                else if (_statusJob is null)
                {
                    <p class="text-muted small mb-0">Nenhum job registrado.</p>
                }
                else
                {
                    <dl class="row mb-0 small">
                        <dt class="col-sm-3">Tipo</dt>
                        <dd class="col-sm-9">@_statusJob.Kind</dd>
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">@_statusJob.Status</dd>
                        <dt class="col-sm-3">Docs</dt>
                        <dd class="col-sm-9">
                            <Badge Color="Color.Success">@_statusJob.DocsProcessed ok</Badge>
                            <Badge Color="Color.Secondary">@_statusJob.DocsSkipped pulados</Badge>
                            <Badge Color="Color.Danger">@_statusJob.DocsFailed falhas</Badge>
                            <span class="text-muted"> — @_statusJob.ChunksCreated chunks</span>
                        </dd>
                        <dt class="col-sm-3">Início/Fim</dt>
                        <dd class="col-sm-9">
                            @(_statusJob.StartedAt?.LocalDateTime.ToString("g") ?? "—")
                            → @(_statusJob.FinishedAt?.LocalDateTime.ToString("g") ?? "—")
                        </dd>
                        @if (!string.IsNullOrEmpty(_statusJob.Error))
                        {
                            <dt class="col-sm-3">Erro</dt>
                            <dd class="col-sm-9 text-danger">@_statusJob.Error</dd>
                        }
                    </dl>

                    @* SPEC-20260926-job-error-details RF-005: warnings agrupados
                       por causa raiz — 465 docs com a mesma exceção viram um grupo. *@
                    @if (_statusJob.Warnings is { Count: > 0 } warnings)
                    {
                        <h6 class="mt-3">Falhas / avisos (@warnings.Count)</h6>
                        <div style="max-height:240px;overflow-y:auto">
                            @foreach (var group in GroupWarnings(warnings))
                            {
                                <div class="border rounded p-2 mb-2">
                                    <div class="text-danger small mb-1">
                                        <strong>@group.Docs.Count×</strong> @group.Message
                                    </div>
                                    <ul class="mb-0 small text-muted">
                                        @foreach (var docName in group.Docs.Take(5))
                                        {
                                            <li><code>@docName</code></li>
                                        }
                                        @if (group.Docs.Count > 5)
                                        {
                                            <li>… e mais @(group.Docs.Count - 5) documento(s)</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </BodyTemplate>
    </ModalDialog>
</Modal>

@code {
    private List<KnowledgeSourceDto>? _sources;
    private Modal? _modal;
    private SourceEditDialog? _edit;
    private SourceEditDialog.SourceEditModel _editModel = new();
    private string? _editError;
    private string? _editErrorDetail;
    private KnowledgeSourceDto? _editSource;
    private List<KnowledgeDocumentDto>? _editDocuments;
    private bool _summaryLoading;
    private bool _summaryFailed;
    private SyncResultDto? _syncResult;
    private bool _syncRunning;
    private string? _syncError;
    private Modal? _statusModal;
    private KnowledgeSourceDto? _statusSource;
    private IngestionJobDto? _statusJob;
    private bool _statusJobLoading;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _sources = await Api.ListAsync() ?? [];
        }
        catch (Exception ex)
        {
            _sources = [];
            await Toast.Error("Erro", $"Falha ao carregar fontes: {ex.Message}");
        }
    }

    private Task ShowCreate()
    {
        _editModel = new SourceEditDialog.SourceEditModel();
        _editSource = null;
        ResetDialogState();
        return _modal!.Toggle();
    }

    private Task ShowEdit(KnowledgeSourceDto dto)
    {
        _editModel = SourceEditDialog.SourceEditModel.FromDto(dto);
        _editSource = dto;
        ResetDialogState();
        _summaryLoading = true;
        _ = LoadSummaryAsync(dto.Id);
        return _modal!.Toggle();
    }

    private void ResetDialogState()
    {
        _editError = null;
        _editErrorDetail = null;
        _editDocuments = null;
        _summaryLoading = false;
        _summaryFailed = false;
        _syncResult = null;
        _syncError = null;
    }

    private async Task LoadSummaryAsync(Guid id)
    {
        try
        {
            _editDocuments = await Api.DocumentsAsync(id) ?? [];
            _summaryFailed = false;
        }
        catch
        {
            _editDocuments = null;
            _summaryFailed = true;
        }
        finally
        {
            _summaryLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncFromDialogAsync()
    {
        if (_editModel.Id is not { } id || _syncRunning) return;
        _syncRunning = true;
        _syncResult = null;
        _syncError = null;
        try
        {
            var result = await Api.SyncAsync(id);
            if (result.IsSuccess)
            {
                _syncResult = result.Value;
                await ReloadAsync();
                _editSource = _sources?.FirstOrDefault(s => s.Id == id) ?? _editSource;
                await LoadSummaryAsync(id);
            }
            else
            {
                _syncError = result.Error;
            }
        }
        finally
        {
            _syncRunning = false;
        }
    }

    private async Task<bool> SaveAsync()
    {
        _editError = _edit!.Validate();
        if (_editError is not null) return false;

        JsonObject config = _edit.BuildConfiguration();
        ApiResult<KnowledgeSourceDto> result = _editModel.Id is { } id
            ? await Api.UpdateAsync(id, new UpdateKnowledgeSourceRequest
            {
                Name = _editModel.Name,
                Description = _editModel.Description,
                Configuration = config,
                IsActive = _editModel.IsActive,
                AutoSyncEnabled = _editModel.AutoSyncEnabled,
                SyncIntervalMinutes = _editModel.SyncIntervalMinutes
            })
            : await Api.CreateAsync(new CreateKnowledgeSourceRequest
            {
                Name = _editModel.Name,
                Description = _editModel.Description,
                Type = _editModel.Type,
                Configuration = config,
                IsActive = _editModel.IsActive,
                AutoSyncEnabled = _editModel.AutoSyncEnabled,
                SyncIntervalMinutes = _editModel.SyncIntervalMinutes
            });

        if (!result.IsSuccess)
        {
            _editError = result.Error;
            _editErrorDetail = result.Detail;
            return false;
        }

        await Toast.Success("Fonte salva", $"'{_editModel.Name}' salva com sucesso.");
        await ReloadAsync();
        return true;
    }

    private async Task ToggleActive(KnowledgeSourceDto dto)
    {
        var result = await Api.SetActiveAsync(dto.Id, !dto.IsActive);
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error!);
            return;
        }
        await ReloadAsync();
    }

    private async Task SyncNow(KnowledgeSourceDto dto)
    {
        // SPEC-20260924-async-ingestion-queue: enqueue + poll until terminal.
        var enqueued = await Api.EnqueueSyncAsync(dto.Id);
        if (!enqueued.IsSuccess)
        {
            await Toast.Error("Sync falhou", enqueued.Error!);
            return;
        }
        var job = enqueued.Value!;
        await Toast.Information("Sync enfileirado",
            job.Existing ? "Já existe um job em andamento para esta fonte." : $"Job {job.JobId:N}");

        // SPEC-20260925-job-progress-feed RF-002: pushed terminal event wins;
        // polling remains the fallback when the hub is unavailable.
        var pushDone = new TaskCompletionSource<IngestionProgressEventDto>();
        void OnProgress(IngestionProgressEventDto e)
        {
            if (e.JobId == job.JobId && e.Status is "done" or "failed" or "cancelled")
                pushDone.TrySetResult(e);
        }
        var hubStarted = false;
        try
        {
            await Hub.StartAsync();
            Hub.IngestionProgress += OnProgress;
            hubStarted = true;
        }
        catch { /* hub unavailable — polling fallback below */ }

        try
        {
            for (var i = 0; i < 150; i++)
            {
                var wait = Task.WhenAny(Task.Delay(2000), pushDone.Task);
                if (await wait == pushDone.Task)
                {
                    var e = pushDone.Task.Result;
                    await ReportJobTerminal(e.Status, e.Processed, e.ChunksCreated, e.Failed, null);
                    await ReloadAsync();
                    return;
                }

                var j = await Api.GetJobAsync(job.JobId);
                if (j is null || j.Status is "queued" or "running")
                    continue;
                await ReportJobTerminal(j.Status, j.DocsProcessed, j.ChunksCreated, j.DocsFailed, j.Error);
                await ReloadAsync();
                return;
            }
            await Toast.Warning("Sync em andamento", "O job continua em background.");
        }
        finally
        {
            if (hubStarted)
                Hub.IngestionProgress -= OnProgress;
        }
    }

    private async Task ReportJobTerminal(string status, int processed, int chunks, int failed, string? error)
    {
        if (status == "done")
            await Toast.Success("Sync concluído",
                $"{processed} docs, {chunks} chunks" + (failed > 0 ? $" — {failed} doc(s) falharam" : ""));
        else
            await Toast.Error($"Sync {status}", error ?? "");
    }

    /// <summary>SPEC-20260925-sources-grid-ux RF-003: opens the status detail
    /// modal and lazy-loads the latest ingestion job for the source.</summary>
    private async Task ShowStatusDetail(KnowledgeSourceDto dto)
    {
        if (string.IsNullOrEmpty(dto.LastError) && dto.LastSyncStatus is null)
            return;

        _statusSource = dto;
        _statusJob = null;
        _statusJobLoading = true;
        await _statusModal!.Toggle();

        try
        {
            _statusJob = (await Api.JobsAsync(dto.Id, 1))?.FirstOrDefault();
        }
        catch
        {
            _statusJob = null;
        }
        finally
        {
            _statusJobLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>SPEC-20260926-job-error-details RF-005: agrupa warnings pelo
    /// texto do erro. Formatos emitidos pelo server: "{doc}: {erro}",
    /// "graph extraction failed for '{doc}': {erro}" e flags livres
    /// ("{doc}: N chunk(s) flagged (...)").</summary>
    private static List<(string Message, List<string> Docs)> GroupWarnings(IReadOnlyList<string> warnings)
    {
        var groups = new Dictionary<string, List<string>>(StringComparer.Ordinal);
        foreach (var w in warnings)
        {
            var idx = w.IndexOf(": ", StringComparison.Ordinal);
            if (idx < 0)
            {
                AddGroup(w, "aviso");
                continue;
            }
            var doc = w[..idx];
            var msg = w[(idx + 2)..];
            if (doc.StartsWith("graph extraction failed for '", StringComparison.Ordinal)
                && doc.EndsWith('\''))
                doc = $"grafo: {doc["graph extraction failed for '".Length..^1]}";
            AddGroup(msg, doc);
        }
        return groups.Select(kv => (kv.Key, kv.Value))
            .OrderByDescending(g => g.Value.Count).ToList();

        void AddGroup(string msg, string doc)
        {
            if (!groups.TryGetValue(msg, out var list))
                groups[msg] = list = [];
            list.Add(doc);
        }
    }

    private async Task DeleteSource(KnowledgeSourceDto dto)
    {
        var result = await Api.DeleteAsync(dto.Id);
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error!);
            return;
        }
        await Toast.Success("Excluída", $"'{dto.Name}' removida.");
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync() => await Hub.DisposeAsync();
}
