@page "/api-keys"
@attribute [Authorize]
@inject AuthApiClient Api
@inject SettingsApiClient SettingsApi
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>API Keys — Knowledge</PageTitle>

<h1 class="h3 mb-3">API Keys</h1>
<p class="text-muted">
    Chaves <code>aft_*</code> autenticam clients não-browser (Cursor, Claude Desktop, scripts)
    em <code>/mcp</code>, <code>/api/*</code> e <code>/hubs/mcp</code> via
    <code>Authorization: Bearer aft_…</code>.
</p>

<div class="table-responsive-wrapper">
    <Table TItem="ApiKeyDto" Items="_keys" ShowLoading="true" ShowLoadingInFirstRender="true"
           IsStriped="true" ShowToolbar="true" ShowDefaultButtons="false" ShowEmpty="true"
           EmptyText="Nenhuma chave criada." CreateItemCallback="CreatePlaceholder">
    <TableToolbarTemplate>
        <TableToolbarButton TItem="ApiKeyDto" Text="Nova chave" Icon="fa-solid fa-plus"
                            Title="Nova chave" Color="Color.Primary" OnClick="ShowCreate" />
    </TableToolbarTemplate>
    <TableColumns>
        <TableColumn Field="@context.Name" FieldExpression="@(() => context.Name)" Text="Nome" />
        <TableColumn Field="@context.Prefix" FieldExpression="@(() => context.Prefix)" Text="Prefixo">
            <Template Context="v"><code>@v.Value…</code></Template>
        </TableColumn>
        <TableColumn Field="@context.CreatedAt" FieldExpression="@(() => context.CreatedAt)" Text="Criada">
            <Template Context="v">@v.Value.LocalDateTime.ToString("g")</Template>
        </TableColumn>
        <TableColumn Field="@context.LastUsedAt" FieldExpression="@(() => context.LastUsedAt)" Text="Último uso">
            <Template Context="v">@(v.Value?.LocalDateTime.ToString("g") ?? "—")</Template>
        </TableColumn>
        <TableColumn Field="@context.RevokedAt" FieldExpression="@(() => context.RevokedAt)" Text="Status">
            <Template Context="v">
                @if (v.Value is not null)
                {
                    <Badge Color="Color.Danger">revogada</Badge>
                }
                else
                {
                    <Badge Color="Color.Success">ativa</Badge>
                }
            </Template>
        </TableColumn>
        <TableColumn Field="@context.Id" FieldExpression="@(() => context.Id)" Text="Ações" Width="120">
            <Template Context="v">
                <div class="kh-actions">
                    <Button Size="Size.ExtraSmall" Color="Color.Info" Icon="fa-solid fa-chart-line"
                            TooltipText="Uso" TooltipPlacement="Placement.Top" OnClick="() => ShowUsage(v.Row)" />
                    <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-gear"
                            TooltipText="Config" TooltipPlacement="Placement.Top" OnClick="() => ShowSettings(v.Row)" />
                    @if (v.Row.RevokedAt is null)
                    {
                        <PopConfirmButton Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-ban"
                                          TooltipText="Revogar" Title="Confirmar revogação"
                                          Content="Clients usando esta chave perdem acesso imediatamente."
                                          OnConfirm="() => Revoke(v.Row)" />
                    }
                </div>
            </Template>
        </TableColumn>
    </TableColumns>
    </Table>
</div>

<Modal @ref="_createModal">
    <ModalDialog Title="Nova API key" ShowSaveButton="true" SaveButtonText="Criar"
                 SaveButtonIcon="fa-solid fa-plus" CloseButtonText="Cancelar"
                 CloseButtonIcon="fa-solid fa-xmark" OnSaveAsync="CreateAsync">
        <BodyTemplate>
            <label class="form-label">Nome do client</label>
            <input class="form-control" @bind="_newName" placeholder="ex.: cursor-laptop" />
            @if (_createError is not null)
            {
                <div class="alert alert-danger py-2 mt-2 mb-0">@_createError</div>
            }
        </BodyTemplate>
    </ModalDialog>
</Modal>

<Modal @ref="_revealModal">
    <ModalDialog Title="Chave criada" ShowCloseButton="false" ShowFooter="false">
        <BodyTemplate>
            <div class="alert alert-warning">
                Copie a chave agora — ela <strong>não será exibida de novo</strong>.
            </div>
            <div class="input-group">
                <input class="form-control font-monospace" readonly value="@_createdKey" />
                <Button Color="Color.Secondary" Icon="fa-solid fa-copy" TooltipText="Copiar"
                        TooltipPlacement="Placement.Top" OnClick="CopyKey" />
            </div>
        </BodyTemplate>
    </ModalDialog>
</Modal>

<Modal @ref="_usageModal">
    <ModalDialog Title="Detalhes e uso da chave" Size="Size.Large" ShowSaveButton="false"
                 CloseButtonText="Fechar" CloseButtonIcon="fa-solid fa-xmark">
        <BodyTemplate>
            @if (_usageKey is not null)
            {
                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                        <div>
                            <span class="fs-5 fw-bold me-2">@_usageKey.Name</span>
                            <small class="text-muted">id <code>@_usageKey.Id</code></small>
                        </div>
                    </div>
                    <div class="text-muted small mb-2">
                        criada @_usageKey.CreatedAt.LocalDateTime.ToString("g") ·
                        último uso @(_usageKey.LastUsedAt?.LocalDateTime.ToString("g") ?? "—")
                    </div>

                    @* SPEC-20260924-api-key-reveal-and-copy RF-003: Secret reveal & copy *@
                    @if (_usageKeySecretLoading)
                    {
                        <div class="text-muted small"><i class="fa-solid fa-spinner fa-spin"></i> Carregando chave…</div>
                    }
                    else if (_usageKeySecret is { IsAvailable: true, Secret: not null })
                    {
                        <div class="input-group input-group-sm mb-1" style="max-width: 520px;">
                            <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                            <input type="@(_revealSecret ? "text" : "password")" class="form-control font-monospace"
                                   readonly value="@_usageKeySecret.Secret" />
                            <Button Size="Size.Small" Color="Color.Secondary"
                                    Icon="@(_revealSecret ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"
                                    Title="@(_revealSecret ? "Ocultar segredo" : "Revelar segredo")"
                                    OnClick="() => _revealSecret = !_revealSecret" />
                            <Button Size="Size.Small" Color="Color.Primary" Icon="fa-solid fa-copy"
                                    TooltipText="Copiar chave completa" TooltipPlacement="Placement.Top"
                                    Title="Copiar chave completa" OnClick="CopySecretAsync" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-1 px-2 mb-1 d-flex align-items-center gap-2" style="max-width: 520px;">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <small>Chave legada (<code>@_usageKey.Prefix…</code>): o segredo completo não está disponível para chaves criadas antes do armazenamento protegido.</small>
                        </div>
                    }
                </div>

                @* SPEC-20260923-per-key-rate-limits RF-004: per-key override —
                   blank fields inherit the global RateLimiting:* values. *@
                <div class="mb-3">
                    <h6 class="text-muted mb-2">Rate limit (override por chave)</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label"><small>LLM permits</small></label>
                            <input type="number" class="form-control form-control-sm" min="1" max="100000"
                                   @bind="_rl.LlmPermits" placeholder="global" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label"><small>LLM janela (s)</small></label>
                            <input type="number" class="form-control form-control-sm" min="1" max="86400"
                                   @bind="_rl.LlmWindowSeconds" placeholder="global" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label"><small>Sync permits</small></label>
                            <input type="number" class="form-control form-control-sm" min="1" max="100000"
                                   @bind="_rl.SyncPermits" placeholder="global" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label"><small>Sync janela (s)</small></label>
                            <input type="number" class="form-control form-control-sm" min="1" max="86400"
                                   @bind="_rl.SyncWindowSeconds" placeholder="global" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 kh-icon-btns">
                        <Button Size="Size.ExtraSmall" Color="Color.Primary" Icon="fa-solid fa-floppy-disk"
                                Text="Salvar limites" IsAsync="true" IsDisabled="_rl.Saving"
                                OnClick="SaveRateLimitAsync" />
                        @if (_usageKey.LlmRateLimitPermits is not null || _usageKey.LlmRateLimitWindowSeconds is not null
                            || _usageKey.SyncRateLimitPermits is not null || _usageKey.SyncRateLimitWindowSeconds is not null)
                        {
                            <PopConfirmButton Size="Size.ExtraSmall" Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Limpar override" Title="Limpar override"
                                              Content="A chave volta aos limites globais."
                                              OnConfirm="ClearRateLimitAsync" />
                        }
                    </div>
                </div>
            }
            @if (_usageLoading)
            {
                <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando métricas…</div>
            }
            else if (_usage is not null)
            {
                <div class="row g-2 mb-3 text-center">
                    <div class="col"><Card><BodyTemplate><div class="fs-5 fw-bold">@_usage.TotalCalls</div><small class="text-muted">total</small></BodyTemplate></Card></div>
                    <div class="col"><Card><BodyTemplate><div class="fs-5 fw-bold">@_usage.CallsLast24h</div><small class="text-muted">24h</small></BodyTemplate></Card></div>
                    <div class="col"><Card><BodyTemplate><div class="fs-5 fw-bold">@_usage.CallsLast7d</div><small class="text-muted">7d</small></BodyTemplate></Card></div>
                    <div class="col"><Card><BodyTemplate><div class="fs-5 fw-bold">@_usage.AvgDurationMs.ToString("F0") ms</div><small class="text-muted">média</small></BodyTemplate></Card></div>
                    <div class="col"><Card><BodyTemplate><div class="fs-5 fw-bold">@((_usage.ErrorRate * 100).ToString("F1"))%</div><small class="text-muted">erros</small></BodyTemplate></Card></div>
                </div>
                <div style="max-height: 320px; overflow-y: auto;">
                    <div class="table-responsive-wrapper">
                        <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr><th>Hora</th><th>Método</th><th>Path</th><th>Status</th><th>ms</th><th>Client</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in _usage.RecentEvents)
                            {
                                <tr>
                                    <td>@e.Timestamp.LocalDateTime.ToString("g")</td>
                                    <td><code>@e.HttpMethod</code></td>
                                    <td><code>@e.Path</code></td>
                                    <td>
                                        @if (e.StatusCode >= 400)
                                        {
                                            <Badge Color="Color.Danger">@e.StatusCode</Badge>
                                        }
                                        else
                                        {
                                            <Badge Color="Color.Success">@e.StatusCode</Badge>
                                        }
                                    </td>
                                    <td>@e.DurationMs.ToString("F0")</td>
                                    <td><small class="text-muted">@(e.UserAgent ?? "—")</small></td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                    @if (_usage.RecentEvents.Count == 0)
                    {
                        <div class="text-muted p-2">Nenhuma chamada registrada para esta chave.</div>
                    }
                </div>
            }
        </BodyTemplate>
    </ModalDialog>
</Modal>

<Modal @ref="_settingsModal">
    <ModalDialog Title="@(_settingsKey is not null ? $"Configurações — {_settingsKey.Name}" : "Configurações da chave")"
                 Size="Size.Large" ShowSaveButton="true" SaveButtonText="Salvar"
                 SaveButtonIcon="fa-solid fa-floppy-disk"
                 CloseButtonText="Cancelar" CloseButtonIcon="fa-solid fa-xmark" OnSaveAsync="SaveSettingsAsync">
        <BodyTemplate>
            @if (_settings is null)
            {
                <div class="text-muted"><i class="fa-solid fa-spinner fa-spin"></i> Carregando…</div>
            }
            else
            {
                <h6 class="text-muted mb-2"><i class="fa-solid fa-shield-halved me-1"></i>Permissões</h6>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <Switch Value="_keyAllowWrite" OnValueChanged="SetWriteAccessAsync" ShowLabel="false" />
                    <div class="small">
                        <span class="fw-semibold">Tools de escrita (write)</span><br />
                        <small class="text-muted">Desligado a chave fica somente-leitura — tools que alteram dados respondem "sem permissão".</small>
                    </div>
                </div>

                <h6 class="text-muted mb-2"><i class="fa-solid fa-comments me-1"></i>Chat (LLM)</h6>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="useGlobal"
                           @bind="_useGlobal" @bind:after="OnUseGlobalChanged" />
                    <label class="form-check-label" for="useGlobal">
                        Usar configuração global
                    </label>
                </div>

                @if (_useGlobal)
                {
                    <div class="alert alert-info">
                        <div><i class="fa-solid fa-link me-1"></i><strong>Endpoint (global):</strong> <code>@_settings.Endpoint</code></div>
                        <div><i class="fa-solid fa-microchip me-1"></i><strong>Model (global):</strong> <code>@_settings.Model</code></div>
                        <div><i class="fa-solid fa-key me-1"></i><strong>Key:</strong> @(_settings.HasApiKey ? _settings.ApiKeyHint : "não configurada")</div>
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-7">
                            <label class="form-label"><i class="fa-solid fa-link me-1"></i>Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_settingsForm.Endpoint"
                                   placeholder="https://api.exemplo.com" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label"><i class="fa-solid fa-microchip me-1"></i>Model</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_settingsForm.Model"
                                   placeholder="nome do modelo" autocomplete="off" />
                        </div>
                    </div>

                    @if (_settings.HasOverride && _settings.OverrideFields.Contains("apiKey"))
                    {
                        <div class="mb-2">
                            <small class="text-muted">Key sobreposta:</small>
                            <code class="ms-1">@_settings.ApiKeyHint</code>
                        </div>
                    }

                    <label class="form-label">
                        <i class="fa-solid fa-key me-1"></i>@(_settings.HasOverride && _settings.OverrideFields.Contains("apiKey") ? "Substituir API key" : "API key")
                    </label>
                    <input type="password" class="form-control font-monospace mb-2"
                           @bind="_settingsForm.ApiKey"
                           placeholder="deixe em branco para manter" autocomplete="off" />
                }

                @* Per-key integration key overrides — only integrations enabled
                   in Settings are listed (disabled ones leave the MCP catalog). *@
                @if (_keyIntegrations.Count > 0)
                {
                    <h6 class="text-muted mb-1 mt-3"><i class="fa-solid fa-plug me-1"></i>Integrações</h6>
                    <p class="small text-muted mb-2">
                        Key própria por integração — em branco a chave usa a key global de Settings.
                    </p>
                    @foreach (var item in _keyIntegrations)
                    {
                        var st = _intForms[item.Provider];
                        var pk = _settings.IntegrationKeys?.GetValueOrDefault(item.Provider);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold">@item.DisplayName</span>
                                @if (pk?.HasKey == true)
                                {
                                    <span class="small"><Badge Color="Color.Success">key própria</Badge> <code>@pk.Hint</code></span>
                                }
                                else
                                {
                                    <small class="text-muted">usa a key global</small>
                                }
                            </div>
                            <div class="input-group input-group-sm kh-icon-btns">
                                <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                                <input type="password" class="form-control font-monospace"
                                       @bind="st.Input"
                                       placeholder="@(pk?.HasKey == true ? "substituir key própria" : "deixe em branco para usar a global")"
                                       autocomplete="off" />
                                <Button Size="Size.Small" Color="Color.Primary" Icon="fa-solid fa-floppy-disk"
                                        Text="Salvar" IsAsync="true" IsDisabled="st.Saving"
                                        OnClick="() => SaveIntegrationKeyAsync(item)" />
                                @if (pk?.HasKey == true)
                                {
                                    <PopConfirmButton Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-trash"
                                                      Text="Remover" Title="Remover key da chave"
                                                      Content="A key própria será removida; a integração volta a usar a key global."
                                                      OnConfirm="() => RemoveIntegrationKeyAsync(item)" />
                                }
                            </div>
                        </div>
                    }
                }

                @if (_settingsError is not null)
                {
                    <div class="alert alert-danger py-2 mt-2 mb-0">@_settingsError</div>
                }
            }
        </BodyTemplate>
        <FooterTemplate>
            @if (_settings is not null && _settings.HasOverride)
            {
                <Button Color="Color.Warning" Text="Remover override" Icon="fa-solid fa-trash"
                        OnClick="RemoveSettingsAsync" />
            }
        </FooterTemplate>
    </ModalDialog>
</Modal>

@code {
    private List<ApiKeyDto>? _keys;
    private Modal? _createModal;
    private Modal? _revealModal;
    private Modal? _usageModal;
    private ApiKeyDto? _usageKey;
    private ApiKeyUsageDto? _usage;
    private bool _usageLoading;
    // SPEC-20260924-api-key-reveal-and-copy RF-003: secret reveal & copy state
    private ApiKeySecretDto? _usageKeySecret;
    private bool _usageKeySecretLoading;
    private bool _revealSecret;
    private readonly RateLimitForm _rl = new();

    private sealed class RateLimitForm
    {
        public int? LlmPermits { get; set; }
        public int? LlmWindowSeconds { get; set; }
        public int? SyncPermits { get; set; }
        public int? SyncWindowSeconds { get; set; }
        public bool Saving { get; set; }
    }
    private string _newName = "";
    private string? _createError;
    private string? _createdKey;

    // SPEC-20260916-api-key-settings RF-006: settings modal state
    private Modal? _settingsModal;
    private ApiKeyDto? _settingsKey;
    private ApiKeyChatSettingsDto? _settings;
    private bool _useGlobal = true;
    private string? _settingsError;
    private readonly SaveApiKeyChatSettingsRequest _settingsForm = new();

    // Per-key integration key overrides — only integrations enabled in
    // Settings are listed (a disabled integration drops out of the MCP
    // tools catalog entirely, so overriding its key would be dead config).
    private List<IntegrationSettingsDto> _keyIntegrations = [];
    private readonly Dictionary<string, IntegrationKeyForm> _intForms = new();

    private sealed class IntegrationKeyForm
    {
        public string Input { get; set; } = "";
        public bool Saving { get; set; }
    }

    // Per-key write gate — read from the listed ApiKeyDto (no extra fetch).
    private bool _keyAllowWrite = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    // SPEC-20260915-table-record-item-factory RF-001: Table materializes a
    // SearchModel on every parameters-set; ApiKeyDto is a positional record
    // (no parameterless ctor) so the factory must be provided explicitly.
    private static ApiKeyDto CreatePlaceholder() =>
        new(Guid.Empty, string.Empty, string.Empty, default, null, null);

    private async Task ReloadAsync()
    {
        try
        {
            _keys = await Api.ListKeysAsync() ?? [];
        }
        catch (Exception ex)
        {
            _keys = [];
            await Toast.Error("Erro", $"Falha ao carregar chaves: {ex.Message}");
        }
    }

    private Task ShowCreate()
    {
        _newName = "";
        _createError = null;
        return _createModal!.Toggle();
    }

    private async Task<bool> CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _createError = "Informe um nome.";
            return false;
        }

        var result = await Api.CreateKeyAsync(_newName.Trim());
        if (!result.IsSuccess || result.Value is null)
        {
            _createError = result.Error ?? "Falha ao criar a chave";
            return false;
        }

        _createdKey = result.Value.Key;
        await ReloadAsync();
        await _revealModal!.Toggle();
        return true;
    }

    private async Task CopyKey()
    {
        if (_createdKey is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _createdKey);
    }

    // SPEC-20260915-apikey-usage-audit RF-006 & SPEC-20260924-api-key-reveal-and-copy RF-003:
    // details + metrics + secret reveal dialog.
    private async Task ShowUsage(ApiKeyDto key)
    {
        _usageKey = key;
        _usage = null;
        _usageLoading = true;
        _usageKeySecret = null;
        _usageKeySecretLoading = true;
        _revealSecret = false;
        _rl.LlmPermits = key.LlmRateLimitPermits;
        _rl.LlmWindowSeconds = key.LlmRateLimitWindowSeconds;
        _rl.SyncPermits = key.SyncRateLimitPermits;
        _rl.SyncWindowSeconds = key.SyncRateLimitWindowSeconds;
        await _usageModal!.Toggle();
        try
        {
            var usageTask = Api.GetKeyUsageAsync(key.Id);
            var secretTask = Api.GetKeySecretAsync(key.Id);
            await Task.WhenAll(usageTask, secretTask);
            _usage = await usageTask;
            _usageKeySecret = await secretTask;
        }
        catch (Exception ex)
        {
            await Toast.Error("Erro", $"Falha ao carregar detalhes: {ex.Message}");
        }
        finally
        {
            _usageLoading = false;
            _usageKeySecretLoading = false;
            StateHasChanged();
        }
    }

    // SPEC-20260924-api-key-reveal-and-copy RF-003: copy complete secret to clipboard.
    private async Task CopySecretAsync()
    {
        if (_usageKeySecret?.Secret is { } secret)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", secret);
                await Toast.Success("Copiado", "Chave completa copiada para a área de transferência.");
            }
            catch
            {
                await Toast.Warning("Aviso", "Não foi possível acessar a área de transferência.");
            }
        }
    }

    // SPEC-20260923-per-key-rate-limits RF-004: save/clear the per-key override.
    private async Task SaveRateLimitAsync()
    {
        if (_usageKey is null)
            return;
        _rl.Saving = true;
        try
        {
            var result = await Api.SetKeyRateLimitAsync(_usageKey.Id,
                new SetApiKeyRateLimitRequest(_rl.LlmPermits, _rl.LlmWindowSeconds, _rl.SyncPermits, _rl.SyncWindowSeconds));
            if (!result.IsSuccess)
            {
                await Toast.Error("Erro", result.Error ?? "Falha ao salvar os limites");
                return;
            }
            await Toast.Success("Salvo", "Rate limit da chave atualizado.");
            await ReloadAsync();
            _usageKey = _keys?.FirstOrDefault(k => k.Id == _usageKey.Id);
        }
        finally
        {
            _rl.Saving = false;
        }
    }

    private async Task ClearRateLimitAsync()
    {
        if (_usageKey is null)
            return;
        var result = await Api.ClearKeyRateLimitAsync(_usageKey.Id);
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error ?? "Falha ao limpar o override");
            return;
        }
        _rl.LlmPermits = _rl.LlmWindowSeconds = _rl.SyncPermits = _rl.SyncWindowSeconds = null;
        await Toast.Success("Limpo", "A chave voltou aos limites globais.");
        await ReloadAsync();
        _usageKey = _keys?.FirstOrDefault(k => k.Id == _usageKey.Id);
    }

    private async Task CopyText(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { /* clipboard API may be unavailable (non-secure context) */ }
    }

    private async Task Revoke(ApiKeyDto key)
    {
        var result = await Api.RevokeKeyAsync(key.Id);
        if (!result.IsSuccess)
        {
            await Toast.Error("Erro", result.Error!);
            return;
        }
        await Toast.Success("Revogada", $"Chave '{key.Name}' revogada.");
        await ReloadAsync();
    }

    // SPEC-20260916-api-key-settings RF-006: settings modal handlers

    private async Task ShowSettings(ApiKeyDto key)
    {
        _settingsKey = key;
        _settings = null;
        _settingsError = null;
        _useGlobal = true;
        _keyAllowWrite = key.AllowWrite;
        _settingsForm.Endpoint = null;
        _settingsForm.Model = null;
        _settingsForm.ApiKey = null;
        _keyIntegrations = [];
        _intForms.Clear();

        await _settingsModal!.Toggle();

        try
        {
            _settings = await SettingsApi.GetApiKeyChatAsync(key.Id);
            _useGlobal = !_settings!.HasOverride;
            if (!_useGlobal)
            {
                _settingsForm.Endpoint = _settings.Endpoint;
                _settingsForm.Model = _settings.Model;
            }
        }
        catch (Exception ex)
        {
            _settingsError = $"Falha ao carregar configuração: {ex.Message}";
        }

        // Integrations list fails soft — the chat section stays usable.
        try
        {
            var ints = await SettingsApi.ListIntegrationsAsync();
            _keyIntegrations = ints?.Integrations.Where(i => i.Enabled).ToList() ?? [];
            foreach (var i in _keyIntegrations)
                _intForms.TryAdd(i.Provider, new IntegrationKeyForm());
        }
        catch { _keyIntegrations = []; }

        StateHasChanged();
    }

    private void OnUseGlobalChanged()
    {
        if (_useGlobal)
        {
            _settingsForm.Endpoint = null;
            _settingsForm.Model = null;
            _settingsForm.ApiKey = null;
        }
        else if (_settings is not null)
        {
            _settingsForm.Endpoint = _settings.Endpoint;
            _settingsForm.Model = _settings.Model;
        }
    }

    private async Task<bool> SaveSettingsAsync()
    {
        if (_settingsKey is null) return false;

        _settingsError = null;
        try
        {
            var result = await SettingsApi.SaveApiKeyChatAsync(
                _settingsKey.Id,
                _useGlobal ? null : _settingsForm.Endpoint,
                _useGlobal ? null : _settingsForm.Model,
                _useGlobal ? null : _settingsForm.ApiKey);

            if (!result.IsSuccess)
            {
                _settingsError = result.Error;
                return false;
            }

            await Toast.Success("Salvo", "Configuração de chat atualizada.");
            return true;
        }
        catch (Exception ex)
        {
            _settingsError = $"Falha ao salvar: {ex.Message}";
            return false;
        }
    }

    /// <summary>PUT /api/api-keys/{id}/write-access — toggle imediato (não
    /// depende do Salvar do modal, igual aos toggles de integração).</summary>
    private async Task SetWriteAccessAsync(bool allowWrite)
    {
        if (_settingsKey is null) return;

        var result = await Api.SetKeyWriteAccessAsync(_settingsKey.Id, allowWrite);
        if (!result.IsSuccess)
        {
            _settingsError = result.Error ?? "Falha ao atualizar a permissão";
            return;
        }

        _keyAllowWrite = allowWrite;
        await Toast.Success("Permissões",
            allowWrite
                ? "Tools de escrita habilitadas para esta chave."
                : "Chave agora é somente-leitura — write retorna 'sem permissão'.");
        await ReloadAsync();
        _settingsKey = _keys?.FirstOrDefault(k => k.Id == _settingsKey.Id) ?? _settingsKey;
    }

    // Per-key integration key overrides — PUT/DELETE
    // /api/api-keys/{id}/settings/integrations/{provider}.

    private async Task SaveIntegrationKeyAsync(IntegrationSettingsDto item)
    {
        if (_settingsKey is null || !_intForms.TryGetValue(item.Provider, out var st))
            return;
        if (string.IsNullOrWhiteSpace(st.Input))
        {
            await Toast.Warning("Key vazia", $"Informe a key de {item.DisplayName} antes de salvar.");
            return;
        }

        _settingsError = null;
        st.Saving = true;
        try
        {
            var result = await SettingsApi.SetApiKeyIntegrationKeyAsync(_settingsKey.Id, item.Provider, st.Input);
            if (!result.IsSuccess)
            {
                _settingsError = result.Error ?? "Falha ao salvar a key";
                return;
            }

            st.Input = "";
            await Toast.Success("Salvo", $"Key de {item.DisplayName} gravada para esta chave.");
            _settings = await SettingsApi.GetApiKeyChatAsync(_settingsKey.Id);
        }
        catch (Exception ex)
        {
            _settingsError = $"Falha ao salvar: {ex.Message}";
        }
        finally
        {
            st.Saving = false;
        }
    }

    private async Task RemoveIntegrationKeyAsync(IntegrationSettingsDto item)
    {
        if (_settingsKey is null) return;

        _settingsError = null;
        try
        {
            var result = await SettingsApi.RemoveApiKeyIntegrationKeyAsync(_settingsKey.Id, item.Provider);
            if (!result.IsSuccess)
            {
                _settingsError = result.Error ?? "Falha ao remover a key";
                return;
            }

            await Toast.Success("Removido", $"{item.DisplayName} voltou a usar a key global.");
            _settings = await SettingsApi.GetApiKeyChatAsync(_settingsKey.Id);
        }
        catch (Exception ex)
        {
            _settingsError = $"Falha ao remover: {ex.Message}";
        }
    }

    private async Task RemoveSettingsAsync()
    {
        if (_settingsKey is null) return;

        _settingsError = null;
        try
        {
            var result = await SettingsApi.RemoveApiKeyChatAsync(_settingsKey.Id);
            if (!result.IsSuccess)
            {
                _settingsError = result.Error;
                return;
            }

            await Toast.Success("Removido", "Override removido — configuração global volta a valer.");
            _settings = await SettingsApi.GetApiKeyChatAsync(_settingsKey.Id);
            _useGlobal = true;
            _settingsForm.Endpoint = null;
            _settingsForm.Model = null;
            _settingsForm.ApiKey = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _settingsError = $"Falha ao remover: {ex.Message}";
        }
    }
}
