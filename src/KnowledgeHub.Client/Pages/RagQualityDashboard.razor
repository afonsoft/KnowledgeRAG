@page "/rag-quality"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["RagQ_PageTitle"]</PageTitle>

<h1 class="h3 mb-3">@L["RagQ_Heading"]</h1>

@if (_loading)
{
    <div class="text-muted">@L["RagQ_Loading"]</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger py-2" role="alert">@_error</div>
}
else if (_stats is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">@L["RagQ_Evals7d"]</div>
                <div class="h4 mb-0">@_stats.TotalEvaluations</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Context Relevance</div>
                <div class="h4 mb-0">@_stats.AverageContextRelevance.ToString("F2")</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Groundedness</div>
                <div class="h4 mb-0">@_stats.AverageGroundedness.ToString("F2")</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Answer Relevance</div>
                <div class="h4 mb-0">@_stats.AverageAnswerRelevance.ToString("F2")</div>
            </div></div>
        </div>
    </div>

    <div class="alert alert-@(_stats.HallucinationRatePercent > 0 ? "warning" : "success") py-2">
        @L["RagQ_HallucinationRate"] <strong>@_stats.HallucinationRatePercent.ToString("F1")%</strong>
    </div>

    <h5>@L["RagQ_Flagged"]</h5>
    @if (_stats.RecentFlaggedQueries.Count == 0)
    {
        <div class="text-muted">@L["RagQ_NoneFlagged"]</div>
    }
    else
    {
        <div class="table-responsive-wrapper">
        <table class="table table-sm align-middle">
            <thead><tr><th>@L["RagQ_Question"]</th><th>Groundedness</th><th>@L["RagQ_FlaggedAt"]</th></tr></thead>
            <tbody>
            @foreach (var q in _stats.RecentFlaggedQueries)
            {
                <tr>
                    <td>@q.Question</td>
                    <td>@q.GroundednessScore.ToString("F2")</td>
                    <td>@q.FlaggedAt.ToString("u")</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
}

@code {
    private RagEvaluationStats? _stats;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await Http.GetFromJsonAsync<RagEvaluationStats>("/api/v1/evaluation/stats", SharedJson.Options);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

}
