@page "/approvals"
@attribute [Authorize]
@using KnowledgeHub.Shared.Contracts
@inject ApprovalsApiClient Api
@inject McpMonitorClient Monitor
@inject ToastService Toast
@implements IAsyncDisposable

<PageTitle>Aprovações — Knowledge</PageTitle>

<div class="d-flex justify-content-between gap-2 align-items-center mb-3">
    <h1 class="h3 mb-0">Aprovações de tools</h1>
    <Button Size="Size.Small" Icon="fa-solid fa-rotate" Text="Atualizar" TooltipText="Atualizar" IsAsync="true"
            OnClick="LoadAsync" IsDisabled="_loading" />
</div>

@if (_items is null)
{
    <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando…</div>
}
else if (_items.Count == 0)
{
    <div class="text-muted">Nenhuma aprovação pendente.</div>
}
else
{
    <div class="list-group">
        @foreach (var a in _items)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-2 align-items-center">
                    <div>
                        <code>@a.ToolName</code>
                        <Badge Color="Color.Info" class="ms-2">@a.RequestedBy</Badge>
                        <small class="text-muted ms-2">@a.CreatedAt.LocalDateTime.ToString("g")</small>
                    </div>
                    <div class="d-flex gap-2">
                        <Button Size="Size.Small" Color="Color.Success" Icon="fa-solid fa-check" Text="Aprovar"
                                TooltipText="Aprovar" IsAsync="true" OnClick="() => ApproveAsync(a)" />
                        <PopConfirmButton Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-xmark" Text="Negar"
                                          TooltipText="Negar"
                                          Title="Negar execução"
                                          Content="A execução desta tool será negada."
                                          IsAsync="true" OnConfirm="() => DenyAsync(a)" />
                    </div>
                </div>
                <pre class="border rounded p-2 mt-2 mb-2 bg-light" style="white-space: pre-wrap;">@a.ArgumentsJson</pre>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted" id="override-label-@a.Id">args override (opcional):</small>
                    <BootstrapInput @bind-Value="_argOverrides[a.Id]"
                                    aria-labelledby="@($"override-label-{a.Id}")"
                                    PlaceHolder="deixe vazio para usar os args originais" />
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ApprovalDto>? _items;
    private readonly Dictionary<Guid, string?> _argOverrides = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        Monitor.Activity += _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        try { await Monitor.StartAsync(); } catch { /* real-time opcional */ }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Api.ListAsync("pending");
            foreach (var a in _items)
                _argOverrides.TryAdd(a.Id, null);
        }
        catch (Exception ex)
        {
            await Toast.Error("Falha ao listar aprovações", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(ApprovalDto a)
    {
        try
        {
            var overrideArgs = _argOverrides.TryGetValue(a.Id, out var o) ? o : null;
            await Api.ApproveAsync(a.Id, string.IsNullOrWhiteSpace(overrideArgs) ? null : overrideArgs);
            // R7 (audit 2026-10-03): auto-resume — a aprovação já é o sinal do
            // operador; exigir POST /api/agent/resume manual era passo extra.
            try
            {
                await Api.ResumeAgentAsync(a.Id);
                await Toast.Success("Aprovada e retomada", $"{a.ToolName} — o agente continuou");
            }
            catch (Exception ex)
            {
                await Toast.Warning("Aprovada", $"{a.ToolName} — retomada falhou, retome manualmente: {ex.Message}");
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.Error("Falha ao aprovar", ex.Message);
        }
    }

    private async Task DenyAsync(ApprovalDto a)
    {
        try
        {
            await Api.DenyAsync(a.Id);
            await Toast.Success("Negada", a.ToolName);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.Error("Falha ao negar", ex.Message);
        }
    }

    public async ValueTask DisposeAsync() => await Monitor.DisposeAsync();
}
