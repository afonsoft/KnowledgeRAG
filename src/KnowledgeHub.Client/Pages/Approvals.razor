@page "/approvals"
@attribute [Authorize]
@using KnowledgeHub.Shared.Contracts
@inject ApprovalsApiClient Api
@inject McpMonitorClient Monitor
@inject ToastService Toast
@inject IStringLocalizer<SharedStrings> L
@implements IAsyncDisposable

<PageTitle>@L["Approvals_PageTitle"]</PageTitle>

<div class="d-flex justify-content-between gap-2 align-items-center mb-3">
    <h1 class="h3 mb-0">@L["Approvals_Heading"]</h1>
    <Button Size="Size.Small" Icon="fa-solid fa-rotate" Text="@L["Common_Refresh"]" TooltipText="@L["Common_Refresh"]" IsAsync="true"
            OnClick="LoadAsync" IsDisabled="_loading" />
</div>

@if (_items is null)
{
    <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Common_Loading"]</div>
}
else if (_items.Count == 0)
{
    <div class="text-muted">@L["Approvals_Empty"]</div>
}
else
{
    <div class="list-group">
        @foreach (var a in _items)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between gap-2 align-items-center">
                    <div>
                        <code>@a.ToolName</code>
                        <Badge Color="Color.Info" class="ms-2">@a.RequestedBy</Badge>
                        <small class="text-muted ms-2">@a.CreatedAt.LocalDateTime.ToString("g")</small>
                    </div>
                    <div class="d-flex gap-2">
                        <Button Size="Size.Small" Color="Color.Success" Icon="fa-solid fa-check" Text="@L["Common_Approve"]"
                                TooltipText="@L["Common_Approve"]" IsAsync="true" OnClick="() => ApproveAsync(a)" />
                        <PopConfirmButton Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-xmark" Text="@L["Common_Deny"]"
                                          TooltipText="@L["Common_Deny"]"
                                          Title="@L["Approvals_DenyTitle"]"
                                          Content="@L["Approvals_DenyContent"]"
                                          IsAsync="true" OnConfirm="() => DenyAsync(a)" />
                    </div>
                </div>
                <pre class="border rounded p-2 mt-2 mb-2 bg-light" style="white-space: pre-wrap;">@a.ArgumentsJson</pre>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted" id="override-label-@a.Id">@L["Approvals_OverrideLabel"]</small>
                    <BootstrapInput @bind-Value="_argOverrides[a.Id]"
                                    aria-labelledby="@($"override-label-{a.Id}")"
                                    PlaceHolder="@L["Approvals_OverridePlaceholder"]" />
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ApprovalDto>? _items;
    private readonly Dictionary<Guid, string?> _argOverrides = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        Monitor.Activity += _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        try { await Monitor.StartAsync(); } catch { /* real-time opcional */ }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Api.ListAsync("pending");
            foreach (var a in _items)
                _argOverrides.TryAdd(a.Id, null);
        }
        catch (Exception ex)
        {
            await Toast.Error(L["Approvals_ListError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(ApprovalDto a)
    {
        try
        {
            var overrideArgs = _argOverrides.TryGetValue(a.Id, out var o) ? o : null;
            await Api.ApproveAsync(a.Id, string.IsNullOrWhiteSpace(overrideArgs) ? null : overrideArgs);
            // R7 (audit 2026-10-03): auto-resume — a aprovação já é o sinal do
            // operador; exigir POST /api/agent/resume manual era passo extra.
            // Flow gates resume server-side inside the approve call — skip the
            // agent resume (it would 4xx since the approval is not a loop gate).
            if (a.RequestedBy == "flow")
            {
                await Toast.Success(L["Approvals_ApprovedResumed"], L["Approvals_ApprovedResumedBody", a.ToolName]);
                await LoadAsync();
                return;
            }
            try
            {
                await Api.ResumeAgentAsync(a.Id);
                await Toast.Success(L["Approvals_ApprovedResumed"], L["Approvals_ApprovedResumedBody", a.ToolName]);
            }
            catch (Exception ex)
            {
                await Toast.Warning(L["Approvals_Approved"], L["Approvals_ResumeFailBody", a.ToolName, ex.Message]);
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.Error(L["Approvals_ApproveError"], ex.Message);
        }
    }

    private async Task DenyAsync(ApprovalDto a)
    {
        try
        {
            await Api.DenyAsync(a.Id);
            await Toast.Success(L["Approvals_Denied"], a.ToolName);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.Error(L["Approvals_DenyError"], ex.Message);
        }
    }

    public async ValueTask DisposeAsync() => await Monitor.DisposeAsync();
}
