@page "/mcp-monitor"
@attribute [Authorize]
@inject McpMonitorClient Monitor
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Monitor MCP — Knowledge</PageTitle>

<h3 class="mb-3">Monitor MCP</h3>

<div class="mb-3 d-flex align-items-center flex-wrap">
    <Badge Color="@StateColor">@StateLabel</Badge>
    <span class="ms-2 text-muted">hub: /hubs/mcp</span>
    <span class="ms-3">
        @* SPEC-20260914-health-checks: aggregated readiness shown in the monitor. *@
        saúde: <Badge Color="@HealthColor">@HealthLabel</Badge>
    </span>
    <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-rotate"
            TooltipText="Atualizar" TooltipPlacement="Placement.Left"
            IsAsync="true" OnClick="RefreshHealthAsync" class="ms-auto" />
</div>

@* SPEC-20260914-signalr-hub-resilience RF-004: degraded, not fatal — the page
   stays usable when the hub can't be reached. *@
@if (Monitor.LastError is { } monitorError)
{
    <div class="alert alert-warning py-2 d-flex justify-content-between gap-2 align-items-center">
        <span>
            Falha na conexão em tempo real: @monitorError<br />
            <small class="text-muted">WebSocket pode estar bloqueado pela rede/proxy — a página continua funcional.</small>
        </span>
        <Button Size="Size.ExtraSmall" Color="Color.Warning" Icon="fa-solid fa-rotate"
                Text="Reconectar" TooltipText="Reconectar" TooltipPlacement="Placement.Left"
                IsAsync="true" OnClick="ReconnectAsync" />
    </div>
}

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <Card>
            <HeaderTemplate>Sessões ativas (@_sessions.Count)</HeaderTemplate>
            <BodyTemplate>
                @if (_sessions.Count == 0)
                {
                    <div class="text-muted">Nenhuma sessão MCP conectada.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var s in _sessions)
                        {
                            <li class="list-group-item">
                                <div><code title="@s.Key">@ShortId(s.Key)</code></div>
                                <small class="text-muted">
                                    @(s.Value.Caller ?? "anônimo") · desde @s.Value.ConnectedAt.LocalDateTime.ToString("T")
                                    (@FormatAge(DateTimeOffset.UtcNow - s.Value.ConnectedAt))
                                </small>
                            </li>
                        }
                    </ul>
                }
            </BodyTemplate>
        </Card>

        @* SPEC-20260925-mcp-monitor-audit: resumo agregado do feed em buffer. *@
        <Card class="mt-3">
            <HeaderTemplate>Resumo (buffer)</HeaderTemplate>
            <BodyTemplate>
                <div class="row small text-center">
                    <div class="col-4"><strong>@_activity.Count</strong><br />eventos</div>
                    <div class="col-4"><strong class="text-success">@OkCount</strong><br />ok</div>
                    <div class="col-4"><strong class="text-danger">@ErrorCount</strong><br />erros</div>
                </div>
                @if (GetAvgMs() is { } avg)
                {
                    <div class="small text-muted mt-2">latência média: @avg.ToString("F0")ms</div>
                }
                @if (GetTopTools() is { Count: > 0 } topTools)
                {
                    <div class="mt-2">
                        <div class="small text-muted mb-1">tools mais chamadas:</div>
                        @foreach (var t in topTools)
                        {
                            <Badge Color="Color.Secondary" class="me-1 mb-1">@t.Key (@t.Value)</Badge>
                        }
                    </div>
                }
                <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-file-csv"
                        Text="Exportar CSV" TooltipText="Exportar CSV" TooltipPlacement="Placement.Top"
                        IsDisabled="_activity.Count == 0" OnClick="ExportCsvAsync" class="mt-2" />
            </BodyTemplate>
        </Card>
    </div>
    <div class="col-12 col-lg-8">
        <Card>
            <HeaderTemplate>Atividade (@FilteredActivity.Count() de @_activity.Count)</HeaderTemplate>
            <BodyTemplate>
                @* SPEC-20260925-mcp-monitor-audit: filtros de auditoria. *@
                <div class="d-flex gap-2 mb-2 flex-wrap">
                    <select class="form-select form-select-sm" style="max-width:170px" @bind="_kindFilter">
                        <option value="">tipo: todos</option>
                        <option value="ToolCall">tools/call</option>
                        <option value="Request">requests</option>
                        <option value="Approval">aprovações</option>
                        <option value="Session">sessões</option>
                    </select>
                    <select class="form-select form-select-sm" style="max-width:140px" @bind="_outcomeFilter">
                        <option value="">resultado: todos</option>
                        <option value="ok">somente ok</option>
                        <option value="erro">somente erros</option>
                    </select>
                    <input class="form-control form-control-sm" style="max-width:240px"
                           placeholder="buscar método/detalhe/quem…" @bind="_textFilter" @bind:event="oninput" />
                </div>
                <div style="max-height: 480px; overflow-y: auto;">
                    <div class="table-responsive-wrapper">
                        <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr><th>Hora</th><th>Quem</th><th>Sessão</th><th>Método</th><th>Detalhe</th><th>ms</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in FilteredActivity)
                            {
                                <tr>
                                    <td class="text-nowrap">@a.Timestamp.LocalDateTime.ToString("T")</td>
                                    <td class="small">@(a.Caller ?? "—")</td>
                                    <td class="small"><code title="@a.SessionId">@(a.SessionId is null ? "—" : ShortId(a.SessionId))</code></td>
                                    <td><code>@a.Method</code></td>
                                    <td class="small">@a.Detail</td>
                                    <td>@(a.DurationMs?.ToString("F0") ?? "—")</td>
                                    <td>
                                        @if (a.Succeeded == true)
                                        {
                                            <Badge Color="Color.Success">ok</Badge>
                                        }
                                        else if (a.Succeeded == false)
                                        {
                                            <Badge Color="Color.Danger">erro</Badge>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                    @if (_activity.Count == 0)
                    {
                        <div class="text-muted p-2">Aguardando chamadas MCP…</div>
                    }
                    else if (!FilteredActivity.Any())
                    {
                        <div class="text-muted p-2">Nenhum evento corresponde aos filtros.</div>
                    }
                </div>
            </BodyTemplate>
        </Card>
    </div>
</div>

@* SPEC-20260915-mcp-monitor-client-config + SPEC-20260926-monitor-client-order:
   ready-to-copy client configs — order Claude Code → Devin → opencode → agy,
   generic SSE block last (Claude Desktop removed per user request). *@
<Card class="mt-3">
    <HeaderTemplate>Como conectar um client</HeaderTemplate>
    <BodyTemplate>
        <p class="text-muted mb-3">
            Crie uma API key em <a href="/api-keys">/api-keys</a> primeiro e substitua
            <code>aft_SUA_CHAVE</code>. Transporte principal: Streamable HTTP em
            <code>@McpUrl</code> — clientes SSE-only usam o legado <code>@SseUrl</code>.
        </p>

        <div class="mb-3">
            <div class="d-flex justify-content-between gap-2 align-items-center mb-1">
                <strong>Claude Code</strong>
                <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-copy"
                        TooltipText="Copiar" TooltipPlacement="Placement.Left"
                        OnClick="() => Copy(ClaudeCodeConfig)" />
            </div>
            <pre class="bg-light border rounded p-2 mb-0 small"><code>@ClaudeCodeConfig</code></pre>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between gap-2 align-items-center mb-1">
                <strong>Devin</strong>
                <small class="text-muted me-auto ms-2">Settings → MCP Servers</small>
                <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-copy"
                        TooltipText="Copiar" TooltipPlacement="Placement.Left"
                        OnClick="() => Copy(DevinConfig)" />
            </div>
            <pre class="bg-light border rounded p-2 mb-0 small"><code>@DevinConfig</code></pre>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between gap-2 align-items-center mb-1">
                <strong>opencode</strong>
                <small class="text-muted me-auto ms-2">opencode.json</small>
                <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-copy"
                        TooltipText="Copiar" TooltipPlacement="Placement.Left"
                        OnClick="() => Copy(OpencodeConfig)" />
            </div>
            <pre class="bg-light border rounded p-2 mb-0 small"><code>@OpencodeConfig</code></pre>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between gap-2 align-items-center mb-1">
                <strong>agy (Antigravity)</strong>
                <small class="text-muted me-auto ms-2">mcp_config.json</small>
                <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-copy"
                        TooltipText="Copiar" TooltipPlacement="Placement.Left"
                        OnClick="() => Copy(AgyConfig)" />
            </div>
            <pre class="bg-light border rounded p-2 mb-0 small"><code>@AgyConfig</code></pre>
        </div>

        <div>
            <div class="d-flex justify-content-between gap-2 align-items-center mb-1">
                <strong>Genérico (qualquer client MCP)</strong>
                <small class="text-muted me-auto ms-2">SSE / mcp-remote</small>
                <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-copy"
                        TooltipText="Copiar" TooltipPlacement="Placement.Left"
                        OnClick="() => Copy(GenericConfig)" />
            </div>
            <pre class="bg-light border rounded p-2 mb-0 small"><code>@GenericConfig</code></pre>
        </div>
    </BodyTemplate>
</Card>

@code {
    private readonly Dictionary<string, McpMonitorReplay.SessionInfo> _sessions = new();
    private readonly List<McpMonitorEventDto> _activity = new();
    private const int MaxActivity = 200;
    private bool? _healthy;
    private bool _disposed;

    // SPEC-20260925-mcp-monitor-audit: filter state.
    private string _kindFilter = "";
    private string _outcomeFilter = "";
    private string _textFilter = "";

    private IEnumerable<McpMonitorEventDto> FilteredActivity =>
        _activity.AsEnumerable().Reverse().Where(MatchesFilters);

    private bool MatchesFilters(McpMonitorEventDto a)
    {
        if (_kindFilter.Length > 0 && !a.Kind.StartsWith(_kindFilter, StringComparison.Ordinal))
            return false;
        if (_outcomeFilter == "ok" && a.Succeeded != true)
            return false;
        if (_outcomeFilter == "erro" && a.Succeeded != false)
            return false;
        if (_textFilter.Length > 0
            && !(a.Method?.Contains(_textFilter, StringComparison.OrdinalIgnoreCase) == true
                 || a.Detail?.Contains(_textFilter, StringComparison.OrdinalIgnoreCase) == true
                 || a.Caller?.Contains(_textFilter, StringComparison.OrdinalIgnoreCase) == true))
            return false;
        return true;
    }

    private int OkCount => _activity.Count(a => a.Succeeded == true);
    private int ErrorCount => _activity.Count(a => a.Succeeded == false);

    private double? GetAvgMs() =>
        _activity.Where(a => a.DurationMs is not null).ToList() is { Count: > 0 } timed
            ? timed.Average(a => a.DurationMs!.Value) : null;

    private List<KeyValuePair<string, int>> GetTopTools() => _activity
        .Where(a => a.Kind == McpMonitorEventKind.ToolCall && a.Method is not null)
        .GroupBy(a => a.Method!)
        .OrderByDescending(g => g.Count())
        .Take(5)
        .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
        .ToList();

    private static string ShortId(string id) =>
        id.Length <= 8 ? id : $"{id[..8]}…";

    private static string FormatAge(TimeSpan age) => age switch
    {
        { TotalMinutes: < 1 } => $"{age.TotalSeconds:F0}s",
        { TotalHours: < 1 } => $"{age.TotalMinutes:F0}min",
        _ => $"{age.TotalHours:F1}h"
    };

    /// <summary>SPEC-20260925-mcp-monitor-audit RF: CSV export of the filtered feed.</summary>
    private async Task ExportCsvAsync()
    {
        var sb = new System.Text.StringBuilder("timestamp,kind,caller,sessionId,method,detail,durationMs,succeeded\n");
        foreach (var a in FilteredActivity)
        {
            sb.Append(a.Timestamp.ToString("O")).Append(',')
                .Append(a.Kind).Append(',')
                .Append(CsvField(a.Caller)).Append(',')
                .Append(CsvField(a.SessionId)).Append(',')
                .Append(CsvField(a.Method)).Append(',')
                .Append(CsvField(a.Detail)).Append(',')
                .Append(a.DurationMs?.ToString("F0")).Append(',')
                .Append(a.Succeeded).Append('\n');
        }
        await JS.InvokeVoidAsync("khDownload",
            $"mcp-activity-{DateTime.Now:yyyyMMdd-HHmmss}.csv", sb.ToString());
    }

    private static string CsvField(string? v)
    {
        if (v is null) return "";
        var esc = v.Replace("\"", "\"\"");
        return esc.Contains(',') || esc.Contains('"') || esc.Contains('\n') ? $"\"{esc}\"" : esc;
    }

    private string McpUrl => $"{Nav.BaseUri.TrimEnd('/')}/mcp";
    private string SseUrl => $"{Nav.BaseUri.TrimEnd('/')}/mcp/sse";

    private string ClaudeCodeConfig =>
        $"claude mcp add --transport http knowledge {McpUrl} --header \"Authorization: Bearer aft_SUA_CHAVE\"";

    private string DevinConfig => $$"""
        {
          "mcpServers": {
            "knowledge": {
              "url": "{{McpUrl}}",
              "headers": {
                "Authorization": "Bearer aft_SUA_CHAVE"
              }
            }
          }
        }
        """;

    private string OpencodeConfig => $$"""
        {
          "mcp": {
            "knowledgehub": {
              "type": "remote",
              "url": "{{McpUrl}}",
              "headers": {
                "Authorization": "Bearer aft_SUA_CHAVE"
              }
            }
          }
        }
        """;

    private string AgyConfig => $$"""
        // ~/.gemini/antigravity/mcp_config.json
        {
          "mcpServers": {
            "knowledgehub": {
              "url": "{{McpUrl}}",
              "headers": {
                "Authorization": "Bearer aft_SUA_CHAVE"
              }
            }
          }
        }
        """;

    private string GenericConfig => $$"""
        # Clients com Streamable HTTP: url = {{McpUrl}}
        # Clients SSE-only:           url = {{SseUrl}}?access_token=aft_SUA_CHAVE
        # Ou via bridge mcp-remote (stdio):
        {
          "mcpServers": {
            "knowledge": {
              "command": "npx",
              "args": [
                "mcp-remote",
                "{{McpUrl}}",
                "--header",
                "Authorization: Bearer aft_SUA_CHAVE"
              ]
            }
          }
        }
        """;

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { /* clipboard API may be unavailable (non-secure context) */ }
    }

    // RF-005: hub events may fire while/after the component is disposed.
    private void NotifyStateChanged()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private string HealthLabel => _healthy switch
    {
        true => "ready",
        false => "indisponível",
        _ => "…"
    };

    private Color HealthColor => _healthy switch
    {
        true => Color.Success,
        false => Color.Danger,
        _ => Color.Secondary
    };

    private async Task RefreshHealthAsync()
    {
        try
        {
            var response = await Http.GetAsync("/health/ready");
            _healthy = response.IsSuccessStatusCode;
        }
        catch
        {
            _healthy = false;
        }
    }

    private string StateLabel => Monitor.State switch
    {
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => "conectado",
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting => "conectando…",
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "reconectando…",
        _ => "desconectado"
    };

    private Color StateColor => Monitor.State switch
    {
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => Color.Success,
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => Color.Warning,
        _ => Color.Secondary
    };

    protected override async Task OnInitializedAsync()
    {
        // SPEC-20260915-mcp-monitor-activity RF-003: replay the buffered feed the
        // hub sends on connect — calls made before the page opened render too.
        Monitor.Snapshot += events =>
        {
            _sessions.Clear();
            _activity.Clear();
            foreach (var e in events)
                McpMonitorReplay.Apply(e, _sessions, _activity, MaxActivity);
            NotifyStateChanged();
        };
        Monitor.SessionOpened += e =>
        {
            _sessions[e.SessionId] = new McpMonitorReplay.SessionInfo(e.ConnectedAt, e.Caller);
            NotifyStateChanged();
        };
        Monitor.SessionClosed += e =>
        {
            _sessions.Remove(e.SessionId);
            NotifyStateChanged();
        };
        Monitor.Activity += e =>
        {
            McpMonitorReplay.Apply(e, _sessions, _activity, MaxActivity);
            NotifyStateChanged();
        };
        Monitor.StateChanged += NotifyStateChanged;
        try { await Monitor.StartAsync(); } catch { /* degraded state via Monitor.LastError */ }
        await RefreshHealthAsync();
    }

    private async Task ReconnectAsync()
    {
        try { await Monitor.StartAsync(); } catch { /* Monitor.LastError surfaces it */ }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await Monitor.DisposeAsync();
    }
}
