@page "/playground"
@attribute [Authorize]
@using System.Text.Json
@using KnowledgeHub.Shared.Contracts
@inject ToolsApiClient Tools
@inject StreamingApiClient Streaming
@inject A2aApiClient A2a
@inject ToastService Toast

<PageTitle>Playground — Knowledge</PageTitle>

<h3 class="mb-3">Playground de tools MCP</h3>

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <Card>
            <HeaderTemplate>
                <div class="d-flex justify-content-between gap-2 align-items-center">
                    <span>Tools (@(_tools?.Count ?? 0))</span>
                    <Button Size="Size.Small" Icon="fa-solid fa-rotate" IsAsync="true"
                            OnClick="LoadToolsAsync" IsDisabled="_loading" />
                </div>
            </HeaderTemplate>
            <BodyTemplate>
                @if (_tools is null)
                {
                    <div class="text-muted kh-action-loading">
                        <i class="fa-solid fa-spinner fa-spin"></i> Carregando catálogo…
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var t in _tools)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action d-flex justify-content-between gap-2 align-items-center @(t.Name == _selected?.Name ? "active" : "")"
                                    @onclick="() => SelectTool(t)">
                                <code>@t.Name</code>
                                @if (!t.ReadOnly)
                                {
                                    <Badge Color="Color.Warning">write</Badge>
                                }
                            </button>
                        }
                    </div>
                }
            </BodyTemplate>
        </Card>
    </div>

    <div class="col-12 col-lg-8">
        @if (_selected is null)
        {
            <div class="text-center text-muted py-5">
                <div class="fs-1 mb-2"><i class="fa-solid fa-arrow-left"></i></div>
                Selecione uma tool à esquerda para testá-la.
            </div>
        }
        else
        {
            <Card class="mb-3">
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span><code>@_selected.Name</code></span>
                        @if (_selected.ReadOnly)
                        {
                            <Badge Color="Color.Success">read-only</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Warning">escrita real</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <p class="text-muted">@_selected.Description</p>

                    @foreach (var field in _fields)
                    {
                        <div class="mb-2">
                            <label class="form-label">
                                <code>@field.Name</code>
                                @if (field.Required)
                                {
                                    <span class="text-danger">*</span>
                                }
                                <small class="text-muted ms-1">@field.TypeLabel@(field.Description is not null ? $" — {field.Description}" : "")</small>
                            </label>
                            @if (field.Kind is ToolFieldKind.Choice)
                            {
                                <Select @bind-Value="field.TextValue" Items="EnumItems(field)" />
                            }
                            else if (field.Simple)
                            {
                                <BootstrapInput @bind-Value="field.TextValue"
                                                PlaceHolder="@(field.Placeholder ?? field.TypeLabel)" />
                            }
                            else
                            {
                                <Textarea @bind-Value="field.TextValue" rows="3"
                                          placeholder="@(field.Placeholder ?? "{ }")" />
                            }
                        </div>
                    }

                    @if (_awaitingWriteConfirm)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <strong>Confirma escrita?</strong> Esta tool modifica a base.
                            <pre class="border rounded p-2 mt-2 mb-2 bg-light" style="white-space: pre-wrap;">@_pendingArgsJson</pre>
                            <div class="d-flex gap-2">
                                <Button Size="Size.Small" Color="Color.Warning" Icon="fa-solid fa-triangle-exclamation"
                                        Text="Confirmar escrita" TooltipText="Confirmar escrita"
                                        IsAsync="true" OnClick="RunToolAsync" />
                                <Button Size="Size.Small" Color="Color.Secondary" Icon="fa-solid fa-xmark"
                                        Text="Cancelar" TooltipText="Cancelar"
                                        OnClick="() => _awaitingWriteConfirm = false" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 mt-3">
                            <Button Color="Color.Primary" Icon="fa-solid fa-play" Text="Executar"
                                    TooltipText="Executar"
                                    IsAsync="true" OnClick="RunToolAsync" IsDisabled="_running" />
                            <Button Color="Color.Secondary" Icon="fa-solid fa-wand-magic-sparkles"
                                    Text="Preencher exemplo" TooltipText="Preencher exemplo" OnClick="FillExample" />
                            @if (_elapsedMs is not null)
                            {
                                <span class="text-muted">@_elapsedMs.Value.ToString("F0") ms</span>
                            }
                        </div>
                    }
                </BodyTemplate>
            </Card>

            @if (_running)
            {
                <div class="alert alert-primary kh-action-loading mb-3" role="status">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <span>Executando <code>@_selected.Name</code>…</span>
                    @if (_selected.Name is "agent_chat" or "ask_knowledge")
                    {
                        <small class="text-muted ms-1">
                            o agente pode levar ~1 min — resposta e etapas aparecem em tempo real abaixo
                        </small>
                    }
                </div>
            }

            @if (_result is not null)
            {
                <Card>
                    <HeaderTemplate>
                        <div class="d-flex justify-content-between gap-2 align-items-center">
                            <span>Resultado</span>
                            <div>
                                @if (_isError)
                                {
                                    <Badge Color="Color.Danger">isError</Badge>
                                }
                                <Switch @bind-Value="_showRaw" DisplayText="JSON" ShowLabel="true" />
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_showRaw)
                        {
                            <pre class="border rounded p-3 bg-light mb-0" style="max-height: 480px; overflow: auto;">@_result.Value.ToString()</pre>
                        }
                        else if (_structuredAnswer is not null)
                        {
                            <div class="mb-2" style="white-space: pre-wrap;">@_structuredAnswer</div>
                            @if (_agentSteps.Count > 0)
                            {
                                <div class="border-top pt-2 mt-2">
                                    <small class="text-muted d-block mb-1">
                                        Etapas do agente — @_agentIterations iteraç(ões) · @_agentLatencyMs.ToString("F0") ms
                                    </small>
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var s in _agentSteps)
                                        {
                                            <li class="d-flex align-items-center gap-2 mb-1">
                                                <Badge Color="Color.Secondary">#@s.Iteration</Badge>
                                                <code>@s.Tool</code>
                                                <small class="text-muted text-truncate" style="max-width: 45%;">@s.ArgsSummary</small>
                                                <small class="text-muted ms-auto">@s.ElapsedMs.ToString("F0") ms</small>
                                                @if (s.IsError)
                                                {
                                                    <Badge Color="Color.Danger">erro</Badge>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (_citations.Count > 0)
                            {
                                <div class="border-top pt-2 mt-2">
                                    <small class="text-muted d-block mb-1">Citações</small>
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var c in _citations)
                                        {
                                            <li>
                                                <code>[@c.Index]</code> @c.Title —
                                                <span class="text-muted">@c.Source</span>
                                                <small class="text-muted">(@c.Uri)</small>
                                                @if (c.SuspicionFlags is not null)
                                                {
                                                    <Badge Color="Color.Warning" title="@c.SuspicionFlags">
                                                        <i class="fa-solid fa-triangle-exclamation"></i> flagged
                                                    </Badge>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else if (_texts.Count > 0)
                        {
                            @foreach (var text in _texts)
                            {
                                <pre class="mb-1 @( _isError ? "text-danger" : "")" style="white-space: pre-wrap;">@text</pre>
                            }
                        }
                        else
                        {
                            <pre class="border rounded p-3 bg-light mb-0" style="max-height: 480px; overflow: auto;">@_result.Value.ToString()</pre>
                        }
                    </BodyTemplate>
                </Card>
            }
        }
    </div>
</div>

@* SPEC-20261001-a2a-task-durability: A2A smoke test — delega uma task ao
   endpoint /a2a (mesmo que os agentes externos usam) e faz poll do estado
   terminal, provando durabilidade/visibilidade do task store. *@
<Card class="mt-3">
    <HeaderTemplate>
        <div class="d-flex justify-content-between gap-2 align-items-center">
            <span>Teste A2A — Agent-to-Agent <small class="text-muted">(/a2a, JSON-RPC)</small></span>
            @if (_a2aPushEnabled is not null)
            {
                <Badge Color="@(_a2aPushEnabled == true ? Color.Success : Color.Secondary)">
                    pushNotifications: @(_a2aPushEnabled == true ? "on" : "off")
                </Badge>
            }
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        <div class="row g-3">
            <div class="col-12 col-md-5">
                <label class="form-label">Skill</label>
                <Select @bind-Value="_a2aSkill" Items="_a2aSkillItems" />
                <label class="form-label mt-2">Mensagem</label>
                <Textarea @bind-Value="_a2aText" rows="3" placeholder="Delegue uma tarefa ao hub…" />
                <label class="form-label mt-2">contextId <small class="text-muted">(opcional — agrupa tasks num contexto)</small></label>
                <BootstrapInput @bind-Value="_a2aContextId" PlaceHolder="32 hex chars ou vazio" />
                <div class="d-flex align-items-center gap-2 mt-3">
                    <Button Color="Color.Primary" Icon="fa-solid fa-paper-plane" Text="Enviar task"
                            TooltipText="SendMessage" IsAsync="true" OnClick="SendA2aAsync"
                            IsDisabled="_a2aRunning || string.IsNullOrWhiteSpace(_a2aText)" />
                    @if (!string.IsNullOrEmpty(_a2aTaskId))
                    {
                        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="GetTask"
                                TooltipText="GetTask" IsAsync="true" OnClick="RefreshA2aAsync" IsDisabled="_a2aRunning" />
                        @if (!_a2aTerminal)
                        {
                            <Button Color="Color.Danger" Icon="fa-solid fa-ban" Text="Cancelar"
                                    TooltipText="CancelTask" IsAsync="true" OnClick="CancelA2aAsync" IsDisabled="_a2aRunning" />
                        }
                    }
                </div>
            </div>
            <div class="col-12 col-md-7">
                @if (_a2aTask is null && !_a2aRunning)
                {
                    <div class="text-muted">Envie uma mensagem — a resposta mostra a task persistida (id, estado, artefatos).</div>
                }
                else
                {
                    @if (_a2aTaskId is not null)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <Badge Color="@A2aStateColor(_a2aState)">@(_a2aState ?? "?")</Badge>
                            <code class="small text-truncate">@_a2aTaskId</code>
                            @if (_a2aRunning)
                            {
                                <i class="fa-solid fa-spinner fa-spin text-primary"></i>
                            }
                        </div>
                    }
                    @foreach (var line in _a2aLines)
                    {
                        <pre class="mb-1" style="white-space: pre-wrap;">@line</pre>
                    }
                    @if (_a2aTask is not null)
                    {
                        <div class="mt-2">
                            <Switch @bind-Value="_a2aShowRaw" DisplayText="JSON" ShowLabel="true" />
                            @if (_a2aShowRaw)
                            {
                                <pre class="border rounded p-3 bg-light mt-2 mb-0" style="max-height: 360px; overflow: auto;">@_a2aTask.Value.ToString()</pre>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </BodyTemplate>
</Card>

@code {
    private IReadOnlyList<ToolDescriptorDto>? _tools;
    private ToolDescriptorDto? _selected;
    private List<ToolField> _fields = [];
    private int _exampleIndex;
    private bool _loading;
    private bool _running;
    private bool _showRaw;
    private bool _isError;
    private JsonElement? _result;
    private List<string> _texts = [];
    private string? _structuredAnswer;
    private readonly System.Text.StringBuilder _agentAnswerSb = new();
    private List<CitationModel> _citations = [];
    private List<AgentStepModel> _agentSteps = [];
    private int _agentIterations;
    private double _agentLatencyMs;
    private double? _elapsedMs;
    private bool _awaitingWriteConfirm;
    private string? _pendingArgsJson;

    // ---- A2A smoke test ----
    private List<SelectedItem> _a2aSkillItems = [new("search_knowledge", "search_knowledge")];
    private string _a2aSkill = "search_knowledge";
    private string? _a2aText;
    private string? _a2aContextId;
    private bool? _a2aPushEnabled;
    private bool _a2aRunning;
    private JsonElement? _a2aTask;
    private string? _a2aTaskId;
    private string? _a2aState;
    private bool _a2aTerminal;
    private bool _a2aShowRaw;
    private List<string> _a2aLines = [];
    private static readonly TimeSpan A2aPollInterval = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan A2aPollTimeout = TimeSpan.FromMinutes(5);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadToolsAsync(), LoadAgentCardAsync());
    }

    private async Task LoadAgentCardAsync()
    {
        try
        {
            var card = await A2a.GetAgentCardAsync();
            if (card.TryGetProperty("capabilities", out var caps) &&
                caps.TryGetProperty("pushNotifications", out var push))
                _a2aPushEnabled = push.ValueKind == JsonValueKind.True;
            if (card.TryGetProperty("skills", out var skills) && skills.ValueKind == JsonValueKind.Array)
            {
                var items = skills.EnumerateArray()
                    .Where(s => s.TryGetProperty("id", out _))
                    .Select(s => new SelectedItem(s.GetProperty("id").GetString()!,
                        s.TryGetProperty("name", out var n) ? n.GetString() ?? s.GetProperty("id").GetString()! : s.GetProperty("id").GetString()!))
                    .ToList();
                if (items.Count > 0)
                {
                    _a2aSkillItems = items;
                    _a2aSkill = items[0].Value;
                }
            }
        }
        catch { /* card is best-effort — fallback skill list stays */ }
    }

    private async Task SendA2aAsync()
    {
        if (string.IsNullOrWhiteSpace(_a2aText)) return;
        _a2aRunning = true;
        _a2aTask = null;
        _a2aTaskId = null;
        _a2aState = null;
        _a2aTerminal = false;
        _a2aLines = [];
        try
        {
            var task = await A2a.SendMessageAsync(_a2aSkill, _a2aText,
                string.IsNullOrWhiteSpace(_a2aContextId) ? null : _a2aContextId.Trim());
            ApplyA2aTask(task);

            // Poll until a terminal state — tasks are durable, so GetTask stays valid.
            var deadline = DateTime.UtcNow + A2aPollTimeout;
            while (!_a2aTerminal && DateTime.UtcNow < deadline && _a2aTaskId is not null)
            {
                await Task.Delay(A2aPollInterval);
                StateHasChanged();
                ApplyA2aTask(await A2a.GetTaskAsync(_a2aTaskId));
            }
        }
        catch (Exception ex)
        {
            await Toast.Error("A2A falhou", ex.Message);
        }
        finally
        {
            _a2aRunning = false;
        }
    }

    private async Task RefreshA2aAsync()
    {
        if (_a2aTaskId is null) return;
        _a2aRunning = true;
        try
        {
            ApplyA2aTask(await A2a.GetTaskAsync(_a2aTaskId));
        }
        catch (Exception ex)
        {
            await Toast.Error("GetTask falhou", ex.Message);
        }
        finally
        {
            _a2aRunning = false;
        }
    }

    private async Task CancelA2aAsync()
    {
        if (_a2aTaskId is null) return;
        try
        {
            ApplyA2aTask(await A2a.CancelTaskAsync(_a2aTaskId));
        }
        catch (Exception ex)
        {
            await Toast.Error("CancelTask falhou", ex.Message);
        }
    }

    private void ApplyA2aTask(JsonElement task)
    {
        _a2aTask = task;
        _a2aTaskId = task.TryGetProperty("id", out var id) ? id.GetString() : _a2aTaskId;
        _a2aState = A2aApiClient.TaskState(task);
        _a2aTerminal = A2aApiClient.IsTerminal(_a2aState);
        _a2aLines = ExtractA2aTexts(task).ToList();
    }

    // Renders the human-readable parts: status message + artifact parts.
    private static IEnumerable<string> ExtractA2aTexts(JsonElement task)
    {
        if (task.TryGetProperty("status", out var status) &&
            status.TryGetProperty("message", out var msg))
            foreach (var t in PartTexts(msg))
                yield return t;
        if (task.TryGetProperty("artifacts", out var artifacts) && artifacts.ValueKind == JsonValueKind.Array)
            foreach (var t in ExtractA2aArtifactTexts(artifacts))
                yield return t;
    }

    private static IEnumerable<string> ExtractA2aArtifactTexts(JsonElement artifacts)
    {
        foreach (var a in artifacts.EnumerateArray())
        {
            var name = a.TryGetProperty("name", out var n) ? n.GetString() : null;
            foreach (var t in PartTexts(a))
                yield return name is null ? t : $"[{name}] {t}";
        }
    }

    private static IEnumerable<string> PartTexts(JsonElement owner)
    {
        if (!owner.TryGetProperty("parts", out var parts) || parts.ValueKind != JsonValueKind.Array)
            return [];
        return parts.EnumerateArray()
            .Where(p => p.TryGetProperty("text", out _))
            .Select(p => p.GetProperty("text").GetString() ?? "");
    }

    private static Color A2aStateColor(string? state) => state switch
    {
        "TASK_STATE_COMPLETED" => Color.Success,
        "TASK_STATE_FAILED" or "TASK_STATE_REJECTED" => Color.Danger,
        "TASK_STATE_CANCELED" => Color.Warning,
        "TASK_STATE_WORKING" or "TASK_STATE_SUBMITTED" => Color.Primary,
        _ => Color.Secondary
    };

    private async Task LoadToolsAsync()
    {
        _loading = true;
        try
        {
            _tools = (await Tools.ListAsync())?.Tools ?? [];
            if (_selected is null)
                _selected = _tools.FirstOrDefault(t => t.Name == "search_knowledge") ?? _tools.FirstOrDefault();
            if (_selected is not null)
                BuildFields();
        }
        catch (Exception ex)
        {
            await Toast.Error("Falha ao listar tools", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectTool(ToolDescriptorDto tool)
    {
        _selected = tool;
        _result = null;
        _elapsedMs = null;
        _awaitingWriteConfirm = false;
        BuildFields();
    }

    private void BuildFields()
    {
        _fields = _selected is null ? [] : ToolArgumentBuilder.ParseFields(_selected.InputSchema).ToList();
        _exampleIndex = 0;
    }

    // SPEC-20260914-playground-tool-form RF-007: fills the form from the schema's
    // `examples` (cycles when >1); schemas without examples get a minimal skeleton.
    private void FillExample()
    {
        if (_selected is null) return;
        var examples = ToolArgumentBuilder.GetExamples(_selected.InputSchema);
        if (examples.Count > 0)
            ToolArgumentBuilder.FillFromArguments(_fields, examples[_exampleIndex++ % examples.Count]);
        else
            ToolArgumentBuilder.FillSkeleton(_fields);
    }

    private static IEnumerable<SelectedItem> EnumItems(ToolField field)
        => new[] { new SelectedItem("", "—") }
            .Concat(field.EnumValues?.Select(v => new SelectedItem(v, v)) ?? []);

    // Upstream proxies may serialize "isError":null (≈ absent) — only a literal
    // true counts; GetBoolean() would throw on Null.
    private static bool IsTrue(JsonElement el, string name) =>
        el.ValueKind == JsonValueKind.Object &&
        el.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.True;

    private async Task RunToolAsync()
    {
        if (_selected is null) return;

        var missing = _fields.Where(f => f.Required && string.IsNullOrWhiteSpace(f.TextValue)).Select(f => f.Name).ToList();
        if (missing.Count > 0)
        {
            await Toast.Error("Campos obrigatórios", string.Join(", ", missing));
            return;
        }

        // Assemble the arguments JSON from the form fields (schema-driven coercion).
        var args = await BuildArgsAsync();
        if (args is null) return;

        // RF-003: mutating tools invoked from the UI require an explicit
        // inline confirmation carrying the assembled args (HITL gate).
        if (!_selected.ReadOnly && !_awaitingWriteConfirm)
        {
            _pendingArgsJson = JsonSerializer.Serialize(
                args, new JsonSerializerOptions { WriteIndented = true });
            _awaitingWriteConfirm = true;
            return;
        }
        _awaitingWriteConfirm = false;

        _running = true;
        _result = null;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        // SPEC-20260914-streaming-answers RF-002: agent/ask run over SSE so tokens
        // and tool steps render incrementally; falls back to the sync call when
        // the stream fails before the first event.
        if (_selected.Name is "agent_chat" or "ask_knowledge" && await TryStreamAsync(args, sw))
            return;

        try
        {
            var result = await Tools.CallAsync(_selected.Name, JsonSerializer.Serialize(args));
            ApplyResult(result, sw);
        }
        catch (Exception ex)
        {
            await Toast.Error("Chamada falhou", ex.Message);
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>Coerces every form field through the schema-driven builder;
    /// returns null after reporting the first invalid field.</summary>
    private async Task<Dictionary<string, JsonElement>?> BuildArgsAsync()
    {
        var args = new Dictionary<string, JsonElement>();
        foreach (var f in _fields)
        {
            if (!ToolArgumentBuilder.TryBuildArgument(f, f.TextValue, out var value, out var error))
            {
                var hint = f.Placeholder is not null ? $" — ex.: {f.Placeholder}" : "";
                await Toast.Error($"Valor inválido em '{f.Name}'", $"{error}{hint}");
                return null;
            }
            if (value.ValueKind != JsonValueKind.Undefined)
                args[f.Name] = value;
        }
        return args;
    }

    private void ApplyResult(JsonElement result, System.Diagnostics.Stopwatch sw)
    {
        _result = result;
        _isError = IsTrue(result, "isError");
        _texts = result.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.Array
            ? content.EnumerateArray()
                .Where(c => c.ValueKind == JsonValueKind.Object &&
                    c.TryGetProperty("type", out var t) && t.GetString() == "text")
                .Select(c => c.TryGetProperty("text", out var tx) ? tx.GetString() ?? "" : "")
                .ToList()
            : [];
        (_structuredAnswer, _citations, _agentSteps, _agentIterations, _agentLatencyMs) = ParseStructured(result);
        _elapsedMs = sw.Elapsed.TotalMilliseconds;
    }

    /// <summary>Consumes the SSE endpoint; returns false when nothing arrived (caller falls back).</summary>
    private async Task<bool> TryStreamAsync(Dictionary<string, JsonElement> args, System.Diagnostics.Stopwatch sw)
    {
        var path = _selected!.Name == "agent_chat" ? "api/agent/stream" : "api/ask/stream";
        _result = JsonSerializer.SerializeToElement(new { });
        _agentAnswerSb.Clear();
        _structuredAnswer = "";
        _citations = [];
        _agentSteps = [];
        _isError = false;
        _texts = [];
        var received = false;
        try
        {
            await foreach (var msg in Streaming.StreamAsync(path, args))
            {
                received = true;
                HandleStreamEvent(msg);
                StateHasChanged();
            }
            _elapsedMs = sw.Elapsed.TotalMilliseconds;
            return true;
        }
        catch (Exception ex)
        {
            if (received)
            {
                _isError = true;
                _texts = [ex.Message];
                return true;
            }
            _result = null;
            _structuredAnswer = null;
            return false; // connection never established — sync fallback
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>Applies one SSE event to the streaming UI state.</summary>
    private void HandleStreamEvent(StreamingApiClient.SseMessage msg)
    {
        var data = msg.Data.TryGetProperty("data", out var d) ? d : msg.Data;
        switch (msg.Event)
        {
            case "token":
                _agentAnswerSb.Append(data.GetProperty("delta").GetString());
                _structuredAnswer = _agentAnswerSb.ToString();
                break;
            case "tool_start":
                _agentSteps.Add(new AgentStepModel
                {
                    Iteration = _agentSteps.Count + 1,
                    Tool = data.TryGetProperty("tool", out var ts) ? ts.GetString() ?? "" : "",
                    ArgsSummary = data.TryGetProperty("args", out var aa) ? aa.GetString() ?? "" : ""
                });
                break;
            case "tool_end":
                var last = _agentSteps.LastOrDefault();
                if (last is not null)
                {
                    _agentSteps[^1] = last with
                    {
                        IsError = IsTrue(data, "isError"),
                        ElapsedMs = data.TryGetProperty("elapsedMs", out var em) ? em.GetDouble() : 0
                    };
                }
                break;
            case "awaiting_approval":
                _agentAnswerSb.Append($"\n\n⏳ Aguardando aprovação da tool '{data.GetProperty("tool").GetString()}' — veja /approvals.");
                _structuredAnswer = _agentAnswerSb.ToString();
                break;
            case "done":
                (_structuredAnswer, _citations, _agentSteps, _agentIterations, _agentLatencyMs) =
                    ParseStructuredContent(data);
                break;
            case "error":
                _isError = true;
                _texts = [data.TryGetProperty("message", out var m) ? m.GetString() ?? "stream error" : "stream error"];
                break;
        }
    }

    private static (string? Answer, List<CitationModel> Citations, List<AgentStepModel> Steps, int Iterations, double LatencyMs)
        ParseStructured(JsonElement result)
    {
        // Upstreams may serialize "structuredContent":null — TryGetProperty on a
        // Null element throws JsonElementHasWrongType, so require a real object.
        if (!result.TryGetProperty("structuredContent", out var sc) ||
            sc.ValueKind != JsonValueKind.Object)
            return (null, [], [], 0, 0);
        return ParseStructuredContent(sc);
    }

    private static (string? Answer, List<CitationModel> Citations, List<AgentStepModel> Steps, int Iterations, double LatencyMs)
        ParseStructuredContent(JsonElement sc)
    {
        if (sc.ValueKind != JsonValueKind.Object ||
            !sc.TryGetProperty("answer", out var a) || a.ValueKind != JsonValueKind.String)
            return (null, [], [], 0, 0);

        var steps = ParseSteps(sc);
        var iterations = sc.TryGetProperty("iterations", out var itr) ? itr.GetInt32() : 0;
        var latencyMs = sc.TryGetProperty("latencyMs", out var lm) ? lm.GetDouble() : 0;
        var citations = ParseCitations(sc);
        return (a.GetString(), citations, steps, iterations, latencyMs);
    }

    private static List<AgentStepModel> ParseSteps(JsonElement sc)
    {
        if (!sc.TryGetProperty("steps", out var st) || st.ValueKind != JsonValueKind.Array)
            return [];
        return st.EnumerateArray()
            .Where(s => s.ValueKind == JsonValueKind.Object)
            .Select(s => new AgentStepModel
            {
                Iteration = s.TryGetProperty("iteration", out var it) ? it.GetInt32() : 0,
                Tool = s.TryGetProperty("tool", out var tn) ? tn.GetString() ?? "" : "",
                ArgsSummary = s.TryGetProperty("argsSummary", out var ag) ? ag.GetString() ?? "" : "",
                IsError = IsTrue(s, "isError"),
                ElapsedMs = s.TryGetProperty("elapsedMs", out var em) ? em.GetDouble() : 0
            })
            .ToList();
    }

    private static List<CitationModel> ParseCitations(JsonElement sc)
    {
        if (!sc.TryGetProperty("citations", out var cs) || cs.ValueKind != JsonValueKind.Array)
            return [];
        return cs.EnumerateArray()
            .Where(c => c.ValueKind == JsonValueKind.Object)
            .Select(c => new CitationModel
            {
                Index = c.TryGetProperty("index", out var i) ? i.GetInt32() : 0,
                Source = c.TryGetProperty("source", out var s) ? s.GetString() ?? "" : "",
                Title = c.TryGetProperty("title", out var t) ? t.GetString() ?? "" : "",
                Uri = c.TryGetProperty("uri", out var u) ? u.GetString() ?? "" : "",
                SuspicionFlags = c.TryGetProperty("suspicionFlags", out var sf)
                    && sf.ValueKind == JsonValueKind.String ? sf.GetString() : null
            })
            .ToList();
    }

    private sealed record AgentStepModel
    {
        public int Iteration { get; init; }
        public string Tool { get; init; } = "";
        public string ArgsSummary { get; init; } = "";
        public bool IsError { get; init; }
        public double ElapsedMs { get; init; }
    }

    private sealed class CitationModel
    {
        public int Index { get; init; }
        public string Source { get; init; } = "";
        public string Title { get; init; } = "";
        public string Uri { get; init; } = "";
        /// <summary>SPEC-20260923-flagged-chunk-badge RF-003 — warning badge.</summary>
        public string? SuspicionFlags { get; init; }
    }

}
