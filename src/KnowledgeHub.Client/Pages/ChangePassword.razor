@page "/change-password"
@layout EmptyLayout
@attribute [Authorize]
@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject KhAuthenticationStateProvider AuthState
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["ChangePwd_PageTitle"]</PageTitle>

<div class="d-flex justify-content-center" style="padding-top: 12vh;">
    <div class="card mx-3" style="width: 100%; max-width: 400px;">
        <div class="card-body">
            <h1 class="h4 card-title mb-1">@L["ChangePwd_Heading"]</h1>
            <p class="text-muted mb-4">@L["ChangePwd_Hint"]</p>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2" role="alert">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label" for="pw-current">@L["ChangePwd_Current"]</label>
                <input class="form-control" id="pw-current" type="password" @bind="_current" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pw-next">@L["ChangePwd_New"]</label>
                <input class="form-control" id="pw-next" type="password" @bind="_next" autocomplete="new-password" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="pw-confirm">@L["ChangePwd_Confirm"]</label>
                <input class="form-control" id="pw-confirm" type="password" @bind="_confirm" autocomplete="new-password" />
            </div>

            <Button Color="Color.Primary" Text="@L["ChangePwd_Submit"]" IsAsync="true" IsBlock="true"
                    OnClick="DoChange" IsDisabled="_busy" />
        </div>
    </div>
</div>

@code {
    private string _current = "";
    private string _next = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;

    private async Task DoChange()
    {
        if (_busy) return;
        _error = null;
        if (_next != _confirm)
        {
            _error = L["ChangePwd_Mismatch"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Auth.ChangePasswordAsync(_current, _next);
            if (!result.IsSuccess)
            {
                _error = result.Error ?? L["ChangePwd_Fail"];
                return;
            }

            var me = await Auth.MeAsync();
            if (me is not null)
                AuthState.SetUser(me);
            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }
}
