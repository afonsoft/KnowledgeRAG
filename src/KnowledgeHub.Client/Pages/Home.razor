@page "/"
@attribute [Authorize]
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toast
@inject IStringLocalizer<SharedStrings> L

<PageTitle>Knowledge</PageTitle>

<h1>Knowledge</h1>

<p class="lead">@L["Home_Lead"]</p>

@* SPEC-20260926-home-mcp-prompt-and-agents-recommendations RF-001:
   Painel central com o prompt para o LLM configurar o servidor MCP. *@
<Card class="mt-4 mb-4 border-primary border-opacity-25 shadow-sm">
    <HeaderTemplate>
        <div class="d-flex justify-content-between gap-2 align-items-center">
            <span class="fw-semibold">
                <i class="fa-solid fa-robot text-primary me-2"></i>@L["Home_CardTitle"]
            </span>
            <Button Size="Size.ExtraSmall" Color="Color.Primary" Icon="fa-solid fa-copy"
                    TooltipText="@L["Home_CopyTooltip"]" TooltipPlacement="Placement.Left"
                    OnClick="CopyPromptAsync" />
        </div>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="text-muted small mb-2">
            @L["Home_CardHelp1"]
            @L["Home_CardHelp2"] <a href="api-keys" class="fw-semibold">/api-keys</a> @L["Home_CardHelp3"] <code>aft_SUA_CHAVE</code>.
        </p>
        <pre class="bg-light border rounded p-3 mb-0 small" style="white-space: pre-wrap; font-family: var(--bs-font-monospace); font-size: 0.85rem; max-height: 380px; overflow-y: auto;"><code>@LlmConfigPrompt</code></pre>
    </BodyTemplate>
</Card>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <Card>
            <HeaderTemplate>@L["Nav_Fontes"]</HeaderTemplate>
            <BodyTemplate>
                @L["Home_CardSourcesBody"]
                <div class="mt-2"><a class="btn btn-primary btn-sm" href="sources">@L["Common_Open"]</a></div>
            </BodyTemplate>
        </Card>
    </div>
    <div class="col-12 col-md-4">
        <Card>
            <HeaderTemplate>@L["Nav_Monitor_MCP"]</HeaderTemplate>
            <BodyTemplate>
                @L["Home_CardMonitorBody"]
                <div class="mt-2"><a class="btn btn-primary btn-sm" href="mcp-monitor">@L["Common_Open"]</a></div>
            </BodyTemplate>
        </Card>
    </div>
    <div class="col-12 col-md-4">
        <Card>
            <HeaderTemplate>@L["Nav_Playground"]</HeaderTemplate>
            <BodyTemplate>
                @L["Home_CardPlaygroundBody"]
                <div class="mt-2"><a class="btn btn-primary btn-sm" href="playground">@L["Common_Open"]</a></div>
            </BodyTemplate>
        </Card>
    </div>
</div>

@code {
    private string LlmConfigPrompt => McpOnboardingPrompt.Build(Nav.BaseUri.TrimEnd('/'));

    private async Task CopyPromptAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", LlmConfigPrompt);
            await Toast.Success(L["Home_Copied"], L["Home_CopiedBody"]);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            await Toast.Warning(L["Common_Warning"], L["Home_ClipboardFail", ex.Message]);
        }
    }
}
