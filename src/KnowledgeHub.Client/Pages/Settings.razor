        if (string.IsNullOrWhiteSpace(_asForm.Endpoint) && !string.IsNullOrWhiteSpace(_chat?.Endpoint))
            _asForm.Endpoint = _chat!.Endpoint;

        if (_asForm.Enabled && string.IsNullOrWhiteSpace(_asForm.Endpoint))
        {
