@page "/settings"
@attribute [Authorize]
@inject SettingsApiClient Api
@inject ToastService Toast

<PageTitle>Settings — Knowledge</PageTitle>

<h3 class="mb-3">Settings</h3>

@* SPEC-20260926-settings-tabs-database-metrics RF-001: seções em abas —
   Chat (LLM) / GraphRAG / Integrações / Cache / Banco de Dados.
   ShowNavigatorButtons: sem os botões ‹ › o header chrome clampa o overflow
   e as abas fora da tela ficam inalcançáveis em janelas estreitas/mobile. *@
<Tab TabStyle="TabStyle.Chrome" ShowNavigatorButtons="true">
    <TabItem Text="Chat (LLM)" Icon="fa-solid fa-comments">

<p class="text-muted">
    Provider OpenAI-compatible usado na síntese de respostas e no loop do agente.
    O endpoint vai sem <code>/v1</code> — o cliente adiciona
    <code>/v1/chat/completions</code>. A API key é criptografada em repouso e
    nunca retorna à interface — só os 4 últimos caracteres são exibidos.
</p>

@if (_chat is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando configuração de chat…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>Provider OpenAI-compatible</span>
                        @if (_chat.Source == "store")
                        {
                            <Badge Color="Color.Success">configurada</Badge>
                        }
                        else if (_chat.Source == "env")
                        {
                            <Badge Color="Color.Info">ambiente</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Secondary">não configurada</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    @if (_chat.Source == "env")
                    {
                        <small class="text-muted d-block mb-2">
                            Usando a configuração do ambiente — salve para sobrepor via interface.
                        </small>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-7">
                            <label class="form-label">Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_chatForm.Endpoint"
                                   placeholder="https://api.exemplo.com" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">Model</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_chatForm.Model"
                                   placeholder="nome do modelo" autocomplete="off" />
                        </div>
                    </div>

                    @if (_chat.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">Key ativa (@_chat.ApiKeySource):</small>
                            <code class="ms-1">@_chat.ApiKeyHint</code>
                        </div>
                    }

                    <label class="form-label">
                        @(_chat.HasApiKey ? "Substituir API key" : "API key")
                    </label>
                    <input type="password" class="form-control font-monospace mb-2"
                           @bind="_chatForm.ApiKey"
                           placeholder="@(_chat.HasApiKey ? "deixe em branco para manter" : "sk-…")"
                           autocomplete="off" />

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                IsAsync="true" IsDisabled="_chatForm.Saving"
                                OnClick="SaveChatAsync" />
                        <Button Color="Color.Secondary" Icon="fa-solid fa-plug" Text="Testar conexão"
                                IsAsync="true" IsDisabled="_chatForm.Testing"
                                OnClick="TestChatAsync" />
                        @if (_chat.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="Remover key" Title="Remover key"
                                              Content="A key salva será removida; a env var (se houver) volta a valer."
                                              OnConfirm="RemoveChatKeyAsync" />
                        }
                        @if (_chat.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Restaurar ambiente" Title="Restaurar ambiente"
                                              Content="A configuração salva (endpoint, model e key) será removida; as variáveis de ambiente voltam a valer."
                                              OnConfirm="ClearChatAsync" />
                        }
                    </div>

                    @if (_chatForm.TestResult is { } test)
                    {
                        <div class="alert @(test.Ok ? "alert-success" : "alert-danger") mt-3 mb-0 py-2">
                            @if (test.Ok)
                            {
                                <span>
                                    Conexão OK em @($"{test.LatencyMs:F0}") ms.@if (test.ModelListed == true)
                                    {<text> Modelo encontrado na lista do provider.</text>}
                                    else if (test.ModelListed == false)
                                    {<text> O modelo informado <strong>não</strong> consta na lista do provider.</text>}
                                </span>
                            }
                            else
                            {
                                <span>Falha na conexão: @test.Detail</span>
                            }
                        </div>
                    }
                </BodyTemplate>
            </Card>
        </div>
    </div>
}

@* SPEC-20260926-settings-ux-embeddings RF-004: embedding/indexing provider —
   mesma linha do chat (LLM): configuração persistida, sem restart. *@
<h5 class="mb-2 text-muted">Embeddings (indexação)</h5>
<p class="text-muted">
    Provider que gera os vetores dos chunks na ingestão e das queries na busca.
    Aplica sem restart <strong>nesta instância</strong> — em multi-réplica,
    re-aplique em cada uma (config por instância).
    <code>dimensions</code> só é aceito quando igual ao schema do vector store —
    e a troca de modelo <strong>exige reindex das fontes</strong>: vetores já
    gravados mantêm as dimensões/modelo antigos.
</p>

@if (_embeddings is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando configuração de embeddings…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>Provider de embeddings</span>
                        @* SPEC-20260926-embeddings-runtime-coherence RF-002:
                           provider build failures surface here — the editor
                           still renders (GET is fail-soft). *@
                        @if (_embeddings.ProviderError is { } perr)
                        {
                            <Badge Color="Color.Danger" title="@perr">provider falhou</Badge>
                        }
                        else if (_embeddings.Source == "store")
                        {
                            <Badge Color="Color.Success">configurada</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Info">ambiente</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-3">
                            <label class="form-label">Provider</label>
                            <select class="form-select font-monospace" @bind="_embForm.Provider">
                                <option value="deterministic">deterministic</option>
                                <option value="ollama">ollama</option>
                                <option value="openai">openai</option>
                                <option value="voyage">voyage</option>
                                <option value="cohere">cohere</option>
                                <option value="onnx">onnx</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_embForm.Endpoint"
                                   placeholder="http://localhost:11434" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Model</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_embForm.Model"
                                   placeholder="nomic-embed-text" autocomplete="off" />
                        </div>
                    </div>

                    @if (_embForm.Provider == "voyage" || _embForm.Provider == "cohere")
                    {
                        <div class="alert alert-info py-2 mb-2 small" role="status">
                            <strong>@(_embForm.Provider == "voyage" ? "Voyage AI" : "Cohere")</strong>:
                            usa <code>input_type</code> assimétrico automaticamente —
                            <code>query</code>/<code>search_query</code> nas buscas e
                            <code>document</code>/<code>search_document</code> na indexação.
                            A API key e o modelo são enviados via <code>Embeddings:@(_embForm.Provider == "voyage" ? "Voyage" : "Cohere")</code>.
                        </div>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label">Dimensions</label>
                            <input type="number" class="form-control font-monospace" min="64" max="4096"
                                   @bind="_embForm.Dimensions" />
                            @if (_embeddings.StoreDimensions is { } sd)
                            {
                                <small class="text-muted">índice: @sd</small>
                            }
                        </div>
                        @if (_embForm.Provider == "onnx")
                        {
                            <div class="col-12 col-md-5">
                                <label class="form-label">Model path</label>
                                <input type="text" class="form-control font-monospace"
                                       @bind="_embForm.ModelPath"
                                       placeholder="models/all-MiniLM-L6-v2" autocomplete="off" />
                            </div>
                        }
                        <div class="col-6 col-md-4">
                            <label class="form-label">API key</label>
                            <input type="password" class="form-control font-monospace"
                                   @bind="_embForm.ApiKey"
                                   placeholder="@(_embeddings.HasApiKey ? "em branco mantém a atual" : "sk-…")"
                                   autocomplete="off" />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label">Max tokens / chunk</label>
                            <input type="number" class="form-control font-monospace" min="100" max="4000"
                                   @bind="_embForm.MaxTokens" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Overlap tokens</label>
                            <input type="number" class="form-control font-monospace" min="0" max="2000"
                                   @bind="_embForm.OverlapTokens" />
                            <small class="text-muted">&lt; max tokens</small>
                        </div>
                    </div>

                    @if (_embeddings.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">Key ativa (@_embeddings.ApiKeySource):</small>
                            <code class="ms-1">@_embeddings.ApiKeyHint</code>
                        </div>
                    }
                    @if (_embeddings.StampedModelId is { } stamped)
                    {
                        <div class="mb-2 small text-muted">
                            Provider efetivo: <code>@stamped</code> — em vigor imediatamente.
                        </div>
                    }
                    @* SPEC-20260926-embeddings-runtime-coherence RF-001: dims
                       ≠ schema do índice — o PUT também bloqueia, mas o aviso
                       ajuda antes de tentar salvar. *@
                    @if (_embeddings.DimsMismatch)
                    {
                        <div class="alert alert-warning small mb-2 py-2">
                            Dimensions @_embeddings.Dimensions ≠ índice @_embeddings.StoreDimensions —
                            o schema do vector store é fixo no startup. Ajuste
                            <code>Embeddings:Dimensions</code> no ambiente, reinicie e rode reindex.
                        </div>
                    }

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                IsAsync="true" IsDisabled="_embForm.Saving"
                                OnClick="SaveEmbeddingsAsync" />
                        @if (_embeddings.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="Remover key" Title="Remover key"
                                              Content="A key salva será removida; a env var (se houver) volta a valer."
                                              OnConfirm="RemoveEmbeddingsKeyAsync" />
                        }
                        @if (_embeddings.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Restaurar ambiente" Title="Restaurar ambiente"
                                              Content="A configuração salva será removida; as variáveis de ambiente voltam a valer."
                                              OnConfirm="ClearEmbeddingsAsync" />
                        }
                    </div>
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
    <TabItem Text="Assistente (A2A)" Icon="fa-solid fa-robot">
@* SPEC-20260929-a2a-assistant-delegation RF-001: modelo assistente de baixo custo
   (ou agente A2A remoto) que executa sub-tarefas baratas — rewrite, grading,
   expansão de query e sumarização — reservando o modelo principal para síntese. *@

<p class="text-muted">
    Provider secundário de baixo custo usado nas sub-tarefas do pipeline
    (rewrite de query, grading de chunks, expansão/HyDE, sumarização de thread).
    Em <code>remote</code>, o endpoint é a URL de um Agent Card A2A e a sub-tarefa
    é delegada via protocolo A2A. Falhas/timeout caem para o modelo principal.
</p>

@if (_assistant is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando configuração do assistente…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>Assistente de baixo custo</span>
                        @if (_assistant.Enabled)
                        {
                            <Badge Color="Color.Success">ativo</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Secondary">desabilitado</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <Switch @bind-Value="_asForm.Enabled"
                                    DisplayText="Habilitado" ShowLabel="true" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Modo</label>
                            <select class="form-select" @bind="_asForm.Mode">
                                <option value="local">local (OpenAI-compatible)</option>
                                <option value="remote">remote (A2A agent)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_asForm.Endpoint"
                                   placeholder="@(_asForm.Mode == "remote" ? "https://agent.exemplo.com" : "https://api.exemplo.com")" autocomplete="off" />
                        </div>
                        @if (_asForm.Mode == "local")
                        {
                            <div class="col-12 col-md-2">
                                <label class="form-label">Model</label>
                                <input type="text" class="form-control font-monospace"
                                       @bind="_asForm.Model" placeholder="gpt-4o-mini" autocomplete="off" />
                            </div>
                        }
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-8">
                            <label class="form-label">Sub-tarefas roteadas</label>
                            <div class="d-flex gap-3 flex-wrap">
                                @foreach (var st in AssistantFormState.AllSubtasks)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@_asForm.Route.Contains(st)"
                                               @onchange="e => ToggleRoute(st, (bool)e.Value!)" />
                                        <label class="form-check-label">@st</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Timeout (s)</label>
                            <input type="number" class="form-control" min="1" max="300"
                                   @bind="_asForm.TimeoutSeconds" />
                        </div>
                    </div>

                    @if (_assistant.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">Key ativa (@_assistant.ApiKeySource):</small>
                            <code class="ms-1">@_assistant.ApiKeyHint</code>
                        </div>
                    }

                    <label class="form-label">
                        @(_assistant.HasApiKey ? "Substituir API key" : "API key")
                    </label>
                    <input type="password" class="form-control font-monospace mb-2"
                           @bind="_asForm.ApiKey"
                           placeholder="@(_assistant.HasApiKey ? "deixe em branco para manter" : "sk-…")"
                           autocomplete="off" />

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                IsAsync="true" IsDisabled="_asForm.Saving"
                                OnClick="SaveAssistantAsync" />
                        <Button Color="Color.Secondary" Icon="fa-solid fa-plug" Text="Testar conexão"
                                IsAsync="true" IsDisabled="_asForm.Testing"
                                OnClick="TestAssistantAsync" />
                        @if (_assistant.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="Remover key" Title="Remover key"
                                              Content="A key salva será removida; a env var (se houver) volta a valer."
                                              OnConfirm="RemoveAssistantKeyAsync" />
                        }
                        @if (_assistant.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Restaurar ambiente" Title="Restaurar ambiente"
                                              Content="A configuração salva será removida; as variáveis de ambiente voltam a valer."
                                              OnConfirm="ClearAssistantAsync" />
                        }
                    </div>

                    @if (_asForm.TestResult is { } atest)
                    {
                        <div class="mt-2">
                            @if (atest.Ok)
                            {
                                <Badge Color="Color.Success">conexão OK — @(atest.LatencyMs.ToString("F0")) ms</Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Danger">falha — @(atest.Detail ?? "sem detalhe")</Badge>
                            }
                        </div>
                    }
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
    <TabItem Text="GraphRAG" Icon="fa-solid fa-diagram-project">

<p class="text-muted">
    Extrai entidades e relações dos chunks indexados e expõe as tools
    <code>find_dependencies</code>, <code>find_dependents</code>, <code>find_path</code>
    e <code>analyze_impact</code> no catálogo MCP. A extração também exige
    <code>"graph": true</code> na configuração de cada source.
</p>

@if (_graph is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando configuração do grafo…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>Extração e travessia do grafo</span>
                        @if (_graph.Source == "store")
                        {
                            <Badge Color="Color.Success">configurada</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Info">ambiente</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-12 col-md-6">
                            <Switch @bind-Value="_graphForm.Enabled"
                                    DisplayText="Ativar GraphRAG" ShowLabel="true" />
                            <small class="text-muted d-block mt-1">
                                Expõe as tools no catálogo MCP e roda a extração na ingestão.
                            </small>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Max chunks por sync</label>
                            <input type="number" class="form-control font-monospace" min="1" max="10000"
                                   @bind="_graphForm.MaxChunksPerSync" />
                            <small class="text-muted">Budget de extração LLM por sync (1–10000)</small>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Max chars por chunk</label>
                            <input type="number" class="form-control font-monospace" min="200" max="50000"
                                   @bind="_graphForm.MaxChunkChars" />
                            <small class="text-muted">Truncamento no prompt de extração (200–50000)</small>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Max resultados</label>
                            <input type="number" class="form-control font-monospace" min="10" max="10000"
                                   @bind="_graphForm.MaxResults" />
                            <small class="text-muted">Teto de arestas por travessia (10–10000)</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                IsAsync="true" IsDisabled="_graphForm.Saving"
                                OnClick="SaveGraphAsync" />
                        @if (_graph.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="Restaurar ambiente" Title="Restaurar ambiente"
                                              Content="A configuração salva será removida; as variáveis de ambiente voltam a valer."
                                              OnConfirm="ClearGraphAsync" />
                        }
                    </div>
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
    <TabItem Text="Resiliência" Icon="fa-solid fa-shield-halved">

<p class="text-muted">
    Política de fallback para providers de chat e tools MCP
    (<code>Resilience:Fallback</code>). Em falhas transitórias (429/5xx/timeout),
    uma chamada pode ser atendida por um candidato equivalente da mesma
    capacidade — nunca cruza permissão ou escopo do caller.
    <code>observe</code> classifica e loga sem trocar; <code>enforce</code> executa
    a troca dentro do budget.
</p>

@if (_resilience is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando política de fallback…</div>
}
else
{
    <section class="border rounded p-3 mb-4">
        <div class="d-flex justify-content-between gap-2 align-items-center mb-3">
            <strong>Fallback policy</strong>
            <Badge Color="@(_resilience.Source == "store" ? Color.Success : Color.Info)">
                @(_resilience.Source == "store" ? "configurada" : "ambiente")
            </Badge>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">Modo</label>
                <Select @bind-Value="_resForm.Mode">
                    <Options>
                        <SelectOption Text="disabled — propaga a falha" Value="disabled" />
                        <SelectOption Text="observe — só classifica e loga" Value="observe" />
                        <SelectOption Text="enforce — executa o fallback" Value="enforce" />
                    </Options>
                </Select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Max alternates por request</label>
                <input type="number" class="form-control font-monospace" min="1" max="5"
                       @bind="_resForm.MaxFallbackAttempts" />
                <small class="text-muted">Budget de tentativas após o primário (1–5)</small>
            </div>
        </div>

        <h6 class="mt-2">Alternates de chat (ordem importa)</h6>
        @foreach (var (fb, i) in _resForm.ChatFallbacks.Select((f, i) => (f, i)))
        {
            <div class="row g-2 mb-2 align-items-center">
                <div class="col-12 col-md-4">
                    <input class="form-control form-control-sm font-monospace" placeholder="endpoint"
                           @bind="fb.Endpoint" />
                </div>
                <div class="col-12 col-md-3">
                    <input class="form-control form-control-sm font-monospace" placeholder="model"
                           @bind="fb.Model" />
                </div>
                <div class="col-12 col-md-4">
                    <input type="password" class="form-control form-control-sm font-monospace"
                           placeholder="apiKey (vazio mantém o salvo)" @bind="fb.ApiKey" />
                </div>
                <div class="col-12 col-md-1">
                    <Button Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-trash"
                            OnClick="() => RemoveFallbackAsync(i)" />
                </div>
            </div>
        }
        <Button Size="Size.Small" Color="Color.Secondary" Icon="fa-solid fa-plus"
                Text="Adicionar alternate" OnClick="AddFallback" />

        <h6 class="mt-3">Capacidades de tools (cadeia de provedores)</h6>
        <small class="text-muted d-block mb-2">
            Uma linha por capacidade. Em falha transitória de <code>prov1_*</code>, a tool
            equivalente do próximo provedor responde. Desmarcar uma capacidade a remove da
            política ao salvar.
        </small>
        @foreach (var (cap, i) in _resForm.CapabilityRows.Select((c, i) => (c, i)))
        {
            <div class="row g-2 mb-2 align-items-center">
                <div class="col-12 col-md-1">
                    <Switch @bind-Value="cap.Enabled" ShowLabel="false"
                            title="@(cap.Enabled ? "Capacidade ativa" : "Capacidade desativada — removida ao salvar")" />
                </div>
                <div class="col-12 col-md-4">
                    <input class="form-control form-control-sm font-monospace" placeholder="capacidade (ex.: WebSearch)"
                           @bind="cap.Name" disabled="@(!cap.Enabled)" />
                </div>
                <div class="col-12 col-md-6">
                    <input class="form-control form-control-sm font-monospace" placeholder="prov1,prov2,… (ordem importa)"
                           @bind="cap.Providers" disabled="@(!cap.Enabled)" />
                </div>
                <div class="col-12 col-md-1">
                    <Button Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-trash"
                            OnClick="() => RemoveCapability(i)" />
                </div>
            </div>
        }
        <Button Size="Size.Small" Color="Color.Secondary" Icon="fa-solid fa-plus"
                Text="Adicionar capacidade" OnClick="AddCapability" />

        <div class="d-flex gap-2 flex-wrap kh-icon-btns mt-3">
            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                    IsAsync="true" IsDisabled="_resForm.Saving"
                    OnClick="SaveResilienceAsync" />
            @if (_resilience.Source == "store")
            {
                <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                  Text="Restaurar ambiente" Title="Restaurar ambiente"
                                  Content="A configuração salva será removida; Resilience:Fallback volta a valer."
                                  OnConfirm="ClearResilienceAsync" />
            }
        </div>
    </section>
}
    </TabItem>
    <TabItem Text="Integrações" Icon="fa-solid fa-plug">

<p class="text-muted">
    API keys de serviços upstream consumidos pelo MCP interno. As chaves são
    criptografadas em repouso e nunca retornam à interface — só os 4 últimos
    caracteres são exibidos.
</p>

@if (_integrations is null)
{
    <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando integrações…</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in _integrations)
        {
            var state = _forms[item.Provider];
            <div class="col-12 col-lg-6">
                <Card>
                    <HeaderTemplate>
                        <div class="d-flex justify-content-between gap-2 align-items-center">
                            <span>@item.DisplayName</span>
                            <div class="d-flex align-items-center gap-2">
                                <Switch Value="item.Enabled" OnValueChanged="v => ToggleAsync(item, v)"
                                        ShowLabel="false" title="@(item.Enabled ? "Desativar integração" : "Ativar integração")" />
                                @if (!item.Enabled)
                                {
                                    <Badge Color="Color.Warning">desativada</Badge>
                                }
                                else if (item.HasKey)
                                {
                                    <Badge Color="Color.Success">configurada</Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.Secondary">sem key</Badge>
                                }
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (item.Note is not null)
                        {
                            <p class="text-muted mb-2">@item.Note</p>
                        }

                        @if (item.HasKey)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Key ativa (@item.Source):</small>
                                <code class="ms-1">@item.KeyHint</code>
                            </div>
                        }

                        <label class="form-label">
                            @(item.HasKey ? "Substituir API key" : "API key")
                        </label>
                        <div class="input-group kh-icon-btns">
                            <input type="password" class="form-control font-monospace"
                                   @bind="state.Input"
                                   placeholder="@ProviderPlaceholder(item.Provider)"
                                   autocomplete="off" />
                            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                                    IsAsync="true" IsDisabled="state.Saving"
                                    OnClick="() => SaveAsync(item)" />
                            @if (item.Source == "store")
                            {
                                <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                                  Text="Remover" Title="Remover key"
                                                  Content="A key salva será removida; a env var (se houver) volta a valer."
                                                  OnConfirm="() => RemoveAsync(item)" />
                            }
                        </div>
                        @if (item.Provider == "deepwiki")
                        {
                            <small class="text-muted d-block mt-2">
                                Sem key o DeepWiki usa o endpoint público (<code>mcp.deepwiki.com/mcp</code>);
                                com key passa a usar o privado (<code>mcp.devin.ai/mcp</code>).
                            </small>
                        }
                        @if (item.Provider == "firecrawl" && !item.HasKey)
                        {
                            <small class="text-muted d-block mt-2">
                                Sem key, as tools <code>firecrawl_*</code> aparecem no catálogo mas
                                retornam erro orientando a configuração aqui.
                            </small>
                        }
                    </BodyTemplate>
                </Card>
            </div>
        }
    </div>
}
    </TabItem>
    <TabItem Text="Cache" Icon="fa-solid fa-bolt">

@* SPEC-20260924-redis-cache-and-tool-caching RF-004: cache inspection + clear. *@
<p class="text-muted">
    Cache distribuído de busca, embeddings e respostas de tools.
    Em modo <code>memory</code> os contadores vivem no processo; em <code>redis</code>
    refletem o estado compartilhado do servidor.
</p>

@if (_cache is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando cache…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-8">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>Provider: <code>@_cache.Provider</code></span>
                        @if (_cache.IsConnected)
                        {
                            <Badge Color="Color.Success">conectado</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Danger">desconectado</Badge>
                        }
                        @* SPEC-20260926-redis-stats-admin-and-connflag RF-003:
                           stats degradation is a separate badge — connectivity
                           follows IsConnected (PING) only. *@
                        @if (!string.IsNullOrEmpty(_cache.StatsError))
                        {
                            <Badge Color="Color.Warning" title="@_cache.StatsError">stats parciais</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row small">
                        <div class="col-6 col-md-3"><strong>Keys</strong><br />@_cache.TotalKeys</div>
                        <div class="col-6 col-md-3"><strong>Tamanho</strong><br />@FormatBytes(_cache.TotalSizeBytes)</div>
                        <div class="col-6 col-md-3"><strong>Hits</strong><br />@_cache.Hits</div>
                        <div class="col-6 col-md-3"><strong>Misses</strong><br />@_cache.Misses</div>
                    </div>
                    @* SPEC-20260925-redis-health-and-scan-stats RF-002: server-side
                       numbers overlay the process-local ones when provider=redis. *@
                    @if (_cache.ServerReported)
                    {
                        <div class="row small mt-2 border-top pt-2">
                            <div class="col-6 col-md-3">
                                <strong>Keys (servidor)</strong><br />
                                @_cache.ServerKeys@(_cache.Partial ? "+" : "")
                            </div>
                            <div class="col-6 col-md-3">
                                <strong>Memória (servidor)</strong><br />@FormatBytes(_cache.ServerUsedMemoryBytes ?? 0)
                            </div>
                            <div class="col-6 col-md-3">
                                <strong>Clientes</strong><br />@(_cache.ServerConnectedClients?.ToString() ?? "—")
                            </div>
                        </div>
                    }
                    @if (_cache.Hits + _cache.Misses > 0)
                    {
                        <div class="small text-muted mt-2">
                            Hit-rate: @((_cache.Hits * 100.0 / (_cache.Hits + _cache.Misses)).ToString("F1"))%
                        </div>
                    }
                </BodyTemplate>
            </Card>
        </div>
        <div class="col-12 col-md-4">
            <Card>
                <HeaderTemplate><span>Ações</span></HeaderTemplate>
                <BodyTemplate>
                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="Atualizar"
                                IsAsync="true" OnClick="ReloadCacheAsync" />
                        <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                          Text="Limpar todo o cache"
                                          Title="Limpar cache"
                                          Content="Todas as keys de busca, embeddings e tools serão removidas. Continuar?"
                                          OnConfirm="ClearCacheAsync" />
                    </div>
                </BodyTemplate>
            </Card>

            @* SPEC-20260925-runtime-log-level RF-004: temporary level raise with
               auto-reset — no redeploy to debug production. *@
            <Card class="mt-3">
                <HeaderTemplate><span>Nível de log</span></HeaderTemplate>
                <BodyTemplate>
                    @if (_logLevel is not null)
                    {
                        <div class="small mb-2">
                            Atual: <Badge Color="@(_logLevel.Level == "Information" ? Color.Info : Color.Warning)">@_logLevel.Level</Badge>
                            @if (_logLevel.AutoResetAt is { } resetAt)
                            {
                                <span class="text-muted"> — volta a @_logLevel.ConfiguredDefault em
                                    @(((resetAt - DateTimeOffset.UtcNow).TotalMinutes).ToString("F0"))min</span>
                            }
                        </div>
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <select class="form-select form-select-sm" style="width:auto" @bind="_logLevelChoice">
                                @foreach (var lvl in new[] { "Verbose", "Debug", "Information", "Warning", "Error" })
                                {
                                    <option value="@lvl">@lvl</option>
                                }
                            </select>
                            <select class="form-select form-select-sm" style="width:auto" @bind="_logLevelMinutes">
                                <option value="5">5 min</option>
                                <option value="15">15 min</option>
                                <option value="30">30 min</option>
                                <option value="60">1 h</option>
                                <option value="120">2 h</option>
                            </select>
                            <Button Size="Size.Small" Color="Color.Primary" Icon="fa-solid fa-check" Text="Aplicar"
                                    TooltipText="Aplicar" IsAsync="true" OnClick="SetLogLevelAsync" />
                        </div>
                        <div class="small text-muted mt-2">Debug volta sozinho — não fica aberto para sempre.</div>
                    }
                    else
                    {
                        <span class="text-muted small">Não foi possível ler o nível atual.</span>
                    }
                </BodyTemplate>
            </Card>
        </div>
        @* SPEC-20260926-settings-ux-embeddings RF-003: per-key eviction —
           cada linha remove a entrada real do cache (L1+L2). *@
        @if (_cache.Keys.Count > 0)
        {
            <div class="col-12">
                <Card>
                    <HeaderTemplate><span>Keys salvas (@_cache.Keys.Count)</span></HeaderTemplate>
                    <BodyTemplate>
                        <div style="max-height:320px;overflow-y:auto">
                            <table class="table table-sm small mb-0">
                                <thead>
                                    <tr><th>Key</th><th class="text-end">Tamanho</th><th class="text-end">TTL</th><th class="text-end" style="width:48px"></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var k in _cache.Keys)
                                    {
                                        <tr>
                                            <td class="font-monospace text-break">@k.Key</td>
                                            <td class="text-end">@FormatBytes(k.SizeBytes)</td>
                                            <td class="text-end">@(k.ExpiresInSeconds is { } ttl ? $"{ttl}s" : "—")</td>
                                            <td class="text-end">
                                                <PopConfirmButton Size="Size.ExtraSmall" Color="Color.Danger"
                                                                  Icon="fa-solid fa-trash" Text=""
                                                                  Title="Limpar key"
                                                                  Content="@($"Remover a entrada '{k.Key}' do cache?")"
                                                                  OnConfirm="() => DeleteCacheKeyAsync(k.Key)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </BodyTemplate>
                </Card>
            </div>
        }
    </div>
}
    </TabItem>
    <TabItem Text="Banco de Dados" Icon="fa-solid fa-database">

@* SPEC-20260926-settings-tabs-database-metrics RF-003: storage snapshot —
   provider, file sizes, PRAGMAs, per-entity counts, migrations, vector store. *@
<p class="text-muted">
    Estado do armazenamento — provider EF, tamanho do arquivo/WAL, contagens por
    entidade e diagnóstico do vector store.
</p>

@if (_dbStats is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> Carregando métricas do banco…</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>Provider: <code>@ShortProvider(_dbStats.Provider)</code></span>
                        <Button Size="Size.Small" Color="Color.Secondary" Icon="fa-solid fa-rotate"
                                Text="Atualizar" IsAsync="true" OnClick="ReloadDatabaseAsync" />
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row small">
                        <div class="col-6 col-md-4"><strong>Banco</strong><br />@FormatBytes(_dbStats.FileSizeBytes ?? 0)</div>
                        <div class="col-6 col-md-4"><strong>WAL</strong><br />@FormatBytes(_dbStats.WalSizeBytes ?? 0)</div>
                        <div class="col-6 col-md-4"><strong>Páginas livres</strong><br />@FreelistPct(_dbStats)</div>
                        <div class="col-6 col-md-4"><strong>Páginas</strong><br />@(_dbStats.PageCount?.ToString("N0") ?? "—")</div>
                        <div class="col-6 col-md-4"><strong>Page size</strong><br />@FormatBytes(_dbStats.PageSizeBytes ?? 0)</div>
                        <div class="col-6 col-md-4"><strong>Cache (páginas)</strong><br />@(_dbStats.CacheSizePages?.ToString("N0") ?? "—")</div>
                    </div>
                    <div class="small text-muted mt-2 font-monospace text-break">@(_dbStats.DataSource ?? "—")</div>
                    <div class="small text-muted mt-1">
                        Migrations: @_dbStats.MigrationsApplied aplicadas
                        @if (_dbStats.LastMigration is { } mig)
                        {
                            <span>— última: <code>@mig</code></span>
                        }
                    </div>
                </BodyTemplate>
            </Card>
        </div>
        <div class="col-12 col-md-6">
            <Card>
                <HeaderTemplate><span>Vector store</span></HeaderTemplate>
                <BodyTemplate>
                    <p class="small text-muted mb-2">
                        Guarda os <em>embeddings</em> — vetores numéricos que representam o significado de
                        cada chunk indexado. Na busca, a pergunta é vetorizada e comparada por similaridade
                        (cosseno): encontra conteúdo relacionado mesmo sem palavras-chave exatas. É o que
                        alimenta o RAG; o índice HNSW torna essa busca rápida em bases grandes.
                    </p>
                    @if (_dbStats.VectorStore is System.Text.Json.JsonElement vs && vs.ValueKind == System.Text.Json.JsonValueKind.Object)
                    {
                        <div class="row small">
                            <div class="col-6 col-md-4"><strong>Provider</strong><br />@JsonStr(vs, "provider")</div>
                            <div class="col-6 col-md-4"><strong>Host</strong><br />@JsonStr(vs, "host")</div>
                            <div class="col-6 col-md-4"><strong>Banco</strong><br />@JsonStr(vs, "database")</div>
                            <div class="col-6 col-md-4"><strong>Chunks</strong><br />@JsonStr(vs, "rows")</div>
                            <div class="col-6 col-md-4"><strong>Dimensões</strong><br />@JsonStr(vs, "dimensions")</div>
                            <div class="col-6 col-md-4"><strong>Índice</strong><br />@JsonStr(vs, "indexType")</div>
                            <div class="col-6 col-md-4"><strong>HNSW</strong><br />@JsonStr(vs, "hnswIndex")</div>
                            <div class="col-6 col-md-4"><strong>Storage</strong><br />@JsonStr(vs, "storageType")</div>
                            <div class="col-6 col-md-4"><strong>pgvector</strong><br />@JsonStr(vs, "pgvectorVersion")</div>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">Diagnóstico do vector store indisponível.</span>
                    }
                </BodyTemplate>
            </Card>
        </div>
        <div class="col-12">
            <Card>
                <HeaderTemplate><span>Entidades (@_dbStats.Tables.Count)</span></HeaderTemplate>
                <BodyTemplate>
                    @* SPEC-20260926-review-docs-and-misc RF-005: clickable
                       column sort — default Linhas desc. *@
                    <table class="table table-sm small mb-0">
                        <thead>
                            <tr>
                                <th role="button" style="cursor:pointer" @onclick="() => ToggleEntitySort(0)">
                                    Tabela @SortGlyph(0)
                                </th>
                                <th class="text-end" role="button" style="cursor:pointer" @onclick="() => ToggleEntitySort(1)">
                                    Linhas @SortGlyph(1)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in SortedEntities())
                            {
                                <tr><td class="font-monospace">@t.Name</td><td class="text-end">@t.RowCount.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
</Tab>

@code {
    private IReadOnlyList<IntegrationSettingsDto>? _integrations;
    private readonly Dictionary<string, FormState> _forms = new();
    private ChatSettingsDto? _chat;
    private readonly ChatFormState _chatForm = new();
    private AssistantSettingsDto? _assistant;
    private readonly AssistantFormState _asForm = new();
    private GraphSettingsDto? _graph;
    private readonly GraphFormState _graphForm = new();
    private ResilienceSettingsDto? _resilience;
    private readonly ResilienceFormState _resForm = new();
    private CacheStatsDto? _cache;
    private DatabaseStatsDto? _dbStats;
    private EmbeddingSettingsDto? _embeddings;
    private readonly EmbFormState _embForm = new();
    private LogLevelState? _logLevel;
    private string _logLevelChoice = "Debug";
    private int _logLevelMinutes = 15;

    private sealed class FormState
    {
        public string Input { get; set; } = "";
        public bool Saving { get; set; }
    }

    private sealed class ChatFormState
    {
        public string Endpoint { get; set; } = "";
        public string Model { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public bool Saving { get; set; }
        public bool Testing { get; set; }
        public TestChatConnectionResponse? TestResult { get; set; }
    }

    private sealed class AssistantFormState
    {
        public static readonly string[] AllSubtasks = ["rewrite", "grade", "expand", "summarize"];
        public bool Enabled { get; set; }
        public string Mode { get; set; } = "local";
        public string Endpoint { get; set; } = "";
        public string Model { get; set; } = "";
        public HashSet<string> Route { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public int TimeoutSeconds { get; set; } = 15;
        public string ApiKey { get; set; } = "";
        public bool Saving { get; set; }
        public bool Testing { get; set; }
        public TestChatConnectionResponse? TestResult { get; set; }
    }

    private sealed class GraphFormState
    {
        public bool Enabled { get; set; }
        public int MaxChunksPerSync { get; set; }
        public int MaxChunkChars { get; set; }
        public int MaxResults { get; set; }
        public bool Saving { get; set; }
    }

    private sealed class ResilienceFormState
    {
        public string Mode { get; set; } = "disabled";
        public int MaxFallbackAttempts { get; set; } = 2;
        public List<FallbackRow> ChatFallbacks { get; set; } = [];
        /// <summary>Uma linha por capacidade — <c>Enabled=false</c> remove a
        /// capacidade da política ao salvar.</summary>
        public List<CapabilityRow> CapabilityRows { get; set; } = [];
        public bool Saving { get; set; }
    }

    /// <summary>Linha mutável de alternate de chat — o DTO é init-only.</summary>
    private sealed class FallbackRow
    {
        public string? Endpoint { get; set; }
        public string? Model { get; set; }
        public string? ApiKey { get; set; }
    }

    /// <summary>Linha mutável de capacidade de tool — toggle por categoria.</summary>
    private sealed class CapabilityRow
    {
        public bool Enabled { get; set; } = true;
        public string Name { get; set; } = "";
        public string Providers { get; set; } = "";
    }

    private sealed class EmbFormState
    {
        public string Provider { get; set; } = "deterministic";
        public string Endpoint { get; set; } = "";
        public string Model { get; set; } = "";
        public string ModelPath { get; set; } = "";
        public int Dimensions { get; set; } = 384;
        public int MaxTokens { get; set; } = 500;
        public int OverlapTokens { get; set; } = 50;
        public string ApiKey { get; set; } = "";
        public bool Saving { get; set; }
    }

    /// <summary>Inicializa a página carregando integrações e as configurações de chat e grafo.</summary>
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await ReloadChatAsync();
        await ReloadAssistantAsync();
        await ReloadGraphAsync();
        await ReloadResilienceAsync();
        await ReloadCacheAsync();
        await ReloadLogLevelAsync();
        await ReloadDatabaseAsync();
        await ReloadEmbeddingsAsync();
    }

    /// <summary>SPEC-20260926-settings-ux-embeddings RF-004.</summary>
    private async Task ReloadEmbeddingsAsync()
    {
        try
        {
            _embeddings = await Api.GetEmbeddingsAsync();
            if (_embeddings is { } e)
            {
                _embForm.Provider = e.Provider;
                _embForm.Endpoint = e.Endpoint ?? "";
                _embForm.Model = e.Model ?? "";
                _embForm.ModelPath = e.ModelPath ?? "";
                _embForm.Dimensions = e.Dimensions;
                _embForm.MaxTokens = e.MaxTokens;
                _embForm.OverlapTokens = e.OverlapTokens;
                _embForm.ApiKey = "";
            }
        }
        catch (Exception ex)
        {
            _embeddings = null;
            await Toast.Error("Erro", $"Falha ao carregar embeddings: {ex.Message}");
        }
    }

    /// <summary>Persiste o provider de embeddings — aplica sem restart; a troca
    /// de model/dims exige reindex manual das fontes.</summary>
    private async Task SaveEmbeddingsAsync()
    {
        if (_embForm.OverlapTokens >= _embForm.MaxTokens)
        {
            await Toast.Error("Validação", "Overlap tokens deve ser menor que max tokens.");
            return;
        }
        _embForm.Saving = true;
        try
        {
            var result = await Api.SaveEmbeddingsAsync(new SaveEmbeddingSettingsRequest
            {
                Provider = _embForm.Provider,
                Endpoint = string.IsNullOrWhiteSpace(_embForm.Endpoint) ? null : _embForm.Endpoint.Trim(),
                Model = string.IsNullOrWhiteSpace(_embForm.Model) ? null : _embForm.Model.Trim(),
                ModelPath = string.IsNullOrWhiteSpace(_embForm.ModelPath) ? null : _embForm.ModelPath.Trim(),
                Dimensions = _embForm.Dimensions,
                MaxTokens = _embForm.MaxTokens,
                OverlapTokens = _embForm.OverlapTokens,
                ApiKey = string.IsNullOrWhiteSpace(_embForm.ApiKey) ? null : _embForm.ApiKey.Trim()
            });
            if (!result.IsSuccess)
            {
                await Toast.Error("Erro", result.Error ?? "Falha ao salvar embeddings");
                return;
            }
            _embForm.ApiKey = "";
            await Toast.Success("Salva",
                "Configuração de embeddings aplicada — se mudou model/dimensions, rode reindex das fontes.");
            await ReloadEmbeddingsAsync();
        }
        finally
        {
            _embForm.Saving = false;
        }
