    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1L << 20 => $"{bytes / (1024.0 * 1024.0):F1} MB",
        >= 1L << 10 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes} B"
    };

