            return;
        }

        _asForm.Saving = true;
        try
        {
            var result = await Api.SaveAssistantAsync(new SaveAssistantSettingsRequest
            {
                Enabled = _asForm.Enabled,
                Mode = _asForm.Mode,
                Endpoint = _asForm.Endpoint,
                Model = _asForm.Model,
                Route = _asForm.Route.ToArray(),
                TimeoutSeconds = _asForm.TimeoutSeconds,
                ApiKey = string.IsNullOrWhiteSpace(_asForm.ApiKey) ? null : _asForm.ApiKey.Trim()
            });
            if (!result.IsSuccess)
            {
                await Toast.Error(L["Common_Error"], result.Error ?? L["Set_SaveFail"].Value);
                return;
            }
            _asForm.ApiKey = "";
            await Toast.Success(L["Set_SavedT"], L["Set_AsstSaved"]);
            await ReloadAssistantAsync();
        }
        finally
        {
            _asForm.Saving = false;
        }
