    /// <summary>Recarrega a política efetiva de fallback e preenche o formulário.</summary>
    private async Task ReloadResilienceAsync()
    {
        try
        {
            _resilience = await Api.GetResilienceAsync();
            _resForm.Mode = _resilience?.Mode ?? "disabled";
            _resForm.MaxFallbackAttempts = _resilience?.MaxFallbackAttempts ?? 2;
            _resForm.ChatFallbacks = (_resilience?.ChatFallbacks ?? [])
                .Select(f => new FallbackRow
                {
                    Endpoint = f.Endpoint,
                    Model = f.Model,
                    ApiKey = f.ApiKey
                }).ToList();
            _resForm.CapabilityRows = _resilience is null
                ? []
                : _resilience.ToolCapabilities
                    .Select(kv => new CapabilityRow
                    {
                        Enabled = true,
                        Name = kv.Key,
                        Providers = string.Join(',', kv.Value)
                    }).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _resilience = null;
            await Toast.Error(L["Common_Error"], L["Set_ResLoadFail", ex.Message]);
        }
    }

    /// <summary>Valida e salva a política de fallback; efeito imediato sem restart.</summary>
    private async Task SaveResilienceAsync()
    {
        var caps = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in _resForm.CapabilityRows.Where(r => r.Enabled))
        {
            var name = row.Name.Trim();
            var providers = row.Providers
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            if (name.Length == 0 || providers.Count == 0)
            {
                await Toast.Error(L["Common_Error"], L["Set_CapErr", row.Name]);
                return;
            }
            caps[name] = providers;
        }

        _resForm.Saving = true;
        try
        {
            var result = await Api.SaveResilienceAsync(new SaveResilienceSettingsRequest
            {
                Mode = _resForm.Mode,
                MaxFallbackAttempts = _resForm.MaxFallbackAttempts,
                ChatFallbacks = _resForm.ChatFallbacks
                    .Select(f => new ChatFallbackOptionDto
                    {
                        // "***"/vazio = mantém a key salva — merge server-side.
                        Endpoint = f.Endpoint, Model = f.Model, ApiKey = f.ApiKey
                    }).ToList(),
                ToolCapabilities = caps
            });
            if (!result.IsSuccess)
            {
                await Toast.Error(L["Common_Error"], result.Error ?? L["Set_ResSaveFail"].Value);
                return;
            }
            await Toast.Success(L["Set_SavedT"], L["Set_ResSaved"]);
            await ReloadResilienceAsync();
        }
        finally
        {
            _resForm.Saving = false;
        }
    }

