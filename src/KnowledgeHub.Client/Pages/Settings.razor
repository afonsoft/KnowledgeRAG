    private int _entitySortCol = 1;
    private bool _entitySortDesc = true;

    private void ToggleEntitySort(int col)
    {
        if (_entitySortCol == col) _entitySortDesc = !_entitySortDesc;
        else { _entitySortCol = col; _entitySortDesc = col == 1; }
    }

    private void OnEntitySortKeyDown(KeyboardEventArgs e, int col)
    {
        if (e.Key is "Enter" or " ")
            ToggleEntitySort(col);
    }

    private IEnumerable<KnowledgeHub.Shared.Contracts.TableCountDto> SortedEntities() =>
        _dbStats is null ? []
        : (_entitySortCol, _entitySortDesc) switch
        {
            (0, true) => _dbStats.Tables.OrderByDescending(t => t.Name),
            (0, false) => _dbStats.Tables.OrderBy(t => t.Name),
            (1, true) => _dbStats.Tables.OrderByDescending(t => t.RowCount),
            _ => _dbStats.Tables.OrderBy(t => t.RowCount)
        };

    private string SortGlyph(int col)
    {
        if (_entitySortCol != col)
            return "";
        return _entitySortDesc ? "▾" : "▴";
    }

