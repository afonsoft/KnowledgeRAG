@page "/settings"
@attribute [Authorize]
@inject SettingsApiClient Api
@inject ToastService Toast
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["Set_PageTitle"]</PageTitle>

<h1 class="h3 mb-3">@L["Nav_Settings"]</h1>

@* SPEC-20260926-settings-tabs-database-metrics RF-001: seções em abas —
   Chat (LLM) / GraphRAG / Integrações / Cache / Banco de Dados.
   ShowNavigatorButtons: sem os botões ‹ › o header chrome clampa o overflow
   e as abas fora da tela ficam inalcançáveis em janelas estreitas/mobile. *@
<Tab TabStyle="TabStyle.Chrome" ShowNavigatorButtons="true">
    <TabItem Text="Chat (LLM)" Icon="fa-solid fa-comments">

<p class="text-muted">@L["Set_ChatIntro"]</p>

@if (_chat is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Set_LoadingChat"]</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>@L["Set_ChatProviderCard"]</span>
                        @if (_chat.Source == "store")
                        {
                            <Badge Color="Color.Success">@L["Set_Configured"]</Badge>
                        }
                        else if (_chat.Source == "env")
                        {
                            <Badge Color="Color.Info">@L["Set_Env"]</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Secondary">@L["Set_NotConfigured"]</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    @if (_chat.Source == "env")
                    {
                        <small class="text-muted d-block mb-2">@L["Set_EnvNote"]</small>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-7">
                            <label class="form-label">Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_chatForm.Endpoint"
                                   placeholder="@L["Keys_ExamplePh"]" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">Model</label>
                            <div class="input-group">
                                <input type="text" class="form-control font-monospace" list="kh-chat-models"
                                       @bind="_chatForm.Model"
                                       placeholder="@L["Set_ModelPh"]" autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary" title="@L["Set_ListModels"]"
                                        @onclick="LoadChatModelsAsync" disabled="@_chatModelsLoading">
                                    <i class="fa-solid @(_chatModelsLoading ? "fa-spinner fa-spin" : "fa-rotate")"></i>
                                </button>
                            </div>
                            <datalist id="kh-chat-models">
                                @foreach (var m in _chatModels)
                                {
                                    <option value="@m"></option>
                                }
                            </datalist>
                            @if (_chatModelsDetail is { } cmd)
                            {
                                <small class="text-muted">@L["Set_ModelListFail", cmd]</small>
                            }
                        </div>
                    </div>

                    @if (_chat.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">@L["Set_ActiveKey", _chat.ApiKeySource]</small>
                            <code class="ms-1">@_chat.ApiKeyHint</code>
                        </div>
                    }

                    <label class="form-label">
                        @(_chat.HasApiKey ? L["Keys_ReplaceKey"].Value : "API key")
                    </label>
                    <input type="password" class="form-control font-monospace mb-2"
                           @bind="_chatForm.ApiKey"
                           placeholder="@(_chat.HasApiKey ? L["Set_KeepPh"].Value : "sk-…")"
                           autocomplete="off" />

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["Common_Save"]"
                                IsAsync="true" IsDisabled="_chatForm.Saving"
                                OnClick="SaveChatAsync" />
                        <Button Color="Color.Secondary" Icon="fa-solid fa-plug" Text="@L["Set_TestConn"]"
                                IsAsync="true" IsDisabled="_chatForm.Testing"
                                OnClick="TestChatAsync" />
                        @if (_chat.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="@L["Set_RemoveKey"]" Title="@L["Set_RemoveKey"]"
                                              Content="@L["Set_RemoveKeyContent"]"
                                              OnConfirm="RemoveChatKeyAsync" />
                        }
                        @if (_chat.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="@L["Set_RestoreEnv"]" Title="@L["Set_RestoreEnv"]"
                                              Content="@L["Set_ClearChatContent"]"
                                              OnConfirm="ClearChatAsync" />
                        }
                    </div>

                    @if (_chatForm.TestResult is { } test)
                    {
                        <div class="alert @(test.Ok ? "alert-success" : "alert-danger") mt-3 mb-0 py-2">
                            @if (test.Ok)
                            {
                                <span>
                                    @L["Set_ConnOk", $"{test.LatencyMs:F0}"]@if (test.ModelListed == true)
                                    {<text>@L["Set_ModelFound"]</text>}
                                    else if (test.ModelListed == false)
                                    {<text>@L["Set_ModelMissing"]</text>}
                                </span>
                            }
                            else
                            {
                                <span>@L["Set_ConnFail", test.Detail ?? ""]</span>
                            }
                        </div>
                    }
                </BodyTemplate>
            </Card>
        </div>
    </div>
}

@* SPEC-20260926-settings-ux-embeddings RF-004: embedding/indexing provider —
   mesma linha do chat (LLM): configuração persistida, sem restart. *@
<h5 class="mb-2 text-muted">@L["Set_EmbTitle"]</h5>
<p class="text-muted">@L["Set_EmbIntro"]</p>

@if (_embeddings is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Set_LoadingEmb"]</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>@L["Set_EmbProviderCard"]</span>
                        @* SPEC-20260926-embeddings-runtime-coherence RF-002:
                           provider build failures surface here — the editor
                           still renders (GET is fail-soft). *@
                        @if (_embeddings.ProviderError is { } perr)
                        {
                            <Badge Color="Color.Danger" title="@perr">@L["Set_ProviderFailed"]</Badge>
                        }
                        else if (_embeddings.Source == "store")
                        {
                            <Badge Color="Color.Success">@L["Set_Configured"]</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Info">@L["Set_Env"]</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-3">
                            <label class="form-label">Provider</label>
                            <select class="form-select font-monospace" @bind="_embForm.Provider">
                                <option value="deterministic">deterministic</option>
                                <option value="ollama">ollama</option>
                                <option value="openai">openai</option>
                                <option value="voyage">voyage</option>
                                <option value="cohere">cohere</option>
                                <option value="onnx">onnx</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">Endpoint</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_embForm.Endpoint"
                                   placeholder="http://localhost:11434" autocomplete="off" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Model</label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="_embForm.Model"
                                   placeholder="nomic-embed-text" autocomplete="off" />
                        </div>
                    </div>

                    @if (_embForm.Provider == "voyage" || _embForm.Provider == "cohere")
                    {
                        <div class="alert alert-info py-2 mb-2 small" role="status">
                            <strong>@(_embForm.Provider == "voyage" ? "Voyage AI" : "Cohere")</strong>:
                            @L["Set_Asym1"]<code>input_type</code>@L["Set_Asym2"]
                            <code>query</code>/<code>search_query</code>@L["Set_Asym3"]
                            <code>document</code>/<code>search_document</code>@L["Set_Asym4"]
                            <code>Embeddings:@(_embForm.Provider == "voyage" ? "Voyage" : "Cohere")</code>.
                        </div>
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label">Dimensions</label>
                            <input type="number" class="form-control font-monospace" min="64" max="4096"
                                   @bind="_embForm.Dimensions" />
                            @if (_embeddings.StoreDimensions is { } sd)
                            {
                                <small class="text-muted">@L["Set_IndexPrefix", sd]</small>
                            }
                        </div>
                        @if (_embForm.Provider == "onnx")
                        {
                            <div class="col-12 col-md-5">
                                <label class="form-label">Model path</label>
                                <input type="text" class="form-control font-monospace"
                                       @bind="_embForm.ModelPath"
                                       placeholder="models/all-MiniLM-L6-v2" autocomplete="off" />
                            </div>
                        }
                        <div class="col-6 col-md-4">
                            <label class="form-label">API key</label>
                            <input type="password" class="form-control font-monospace"
                                   @bind="_embForm.ApiKey"
                                   placeholder="@(_embeddings.HasApiKey ? L["Set_KeepKeyPh"].Value : "sk-…")"
                                   autocomplete="off" />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label">Max tokens / chunk</label>
                            <input type="number" class="form-control font-monospace" min="100" max="4000"
                                   @bind="_embForm.MaxTokens" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Overlap tokens</label>
                            <input type="number" class="form-control font-monospace" min="0" max="2000"
                                   @bind="_embForm.OverlapTokens" />
                            <small class="text-muted">&lt; max tokens</small>
                        </div>
                    </div>

                    @if (_embeddings.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">@L["Set_ActiveKey", _embeddings.ApiKeySource]</small>
                            <code class="ms-1">@_embeddings.ApiKeyHint</code>
                        </div>
                    }
                    @if (_embeddings.StampedModelId is { } stamped)
                    {
                        <div class="mb-2 small text-muted">
                            @L["Set_EffProvider1"]<code>@stamped</code>@L["Set_EffProvider2"]
                        </div>
                    }
                    @* SPEC-20260926-embeddings-runtime-coherence RF-001: dims
                       ≠ schema do índice — o PUT também bloqueia, mas o aviso
                       ajuda antes de tentar salvar. *@
                    @if (_embeddings.DimsMismatch)
                    {
                        <div class="alert alert-warning small mb-2 py-2">
                            Dimensions @_embeddings.Dimensions ≠ @L["Set_IndexPrefix", _embeddings.StoreDimensions ?? 0] —
                            @L["Set_DimsMismatch1"]
                            <code>Embeddings:Dimensions</code>@L["Set_DimsMismatch2"]
                        </div>
                    }

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["Common_Save"]"
                                IsAsync="true" IsDisabled="_embForm.Saving"
                                OnClick="SaveEmbeddingsAsync" />
                        @if (_embeddings.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="@L["Set_RemoveKey"]" Title="@L["Set_RemoveKey"]"
                                              Content="@L["Set_RemoveKeyContent"]"
                                              OnConfirm="RemoveEmbeddingsKeyAsync" />
                        }
                        @if (_embeddings.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="@L["Set_RestoreEnv"]" Title="@L["Set_RestoreEnv"]"
                                              Content="@L["Set_ClearContent"]"
                                              OnConfirm="ClearEmbeddingsAsync" />
                        }
                    </div>
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
    <TabItem Text="@L["Set_TabAssistant"]" Icon="fa-solid fa-robot">
@* SPEC-20260929-a2a-assistant-delegation RF-001: modelo assistente de baixo custo
   (ou agente A2A remoto) que executa sub-tarefas baratas — rewrite, grading,
   expansão de query e sumarização — reservando o modelo principal para síntese. *@

<p class="text-muted">@L["Set_AsstIntro"]</p>

@if (_assistant is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Set_LoadingAsst"]</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>@L["Set_AsstCard"]</span>
                        @if (_assistant.Enabled)
                        {
                            <Badge Color="Color.Success">@L["Set_EnabledBadge"]</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Secondary">@L["Set_OffBadge"]</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-2">
                        <div class="col-6 col-md-3">
                            <Switch @bind-Value="_asForm.Enabled"
                                    DisplayText="@L["Common_Enabled"]" ShowLabel="true" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Model</label>
                            <div class="input-group">
                                <input type="text" class="form-control font-monospace" list="kh-asst-models"
                                       @bind="_asForm.Model" placeholder="gpt-4o-mini" autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary" title="@L["Set_ListModels"]"
                                        @onclick="LoadAssistantModelsAsync" disabled="@_asModelsLoading">
                                    <i class="fa-solid @(_asModelsLoading ? "fa-spinner fa-spin" : "fa-rotate")"></i>
                                </button>
                            </div>
                            <datalist id="kh-asst-models">
                                @foreach (var m in _assistantModels)
                                {
                                    <option value="@m"></option>
                                }
                            </datalist>
                            @if (_asModelsDetail is { } amd)
                            {
                                <small class="text-muted">@L["Set_ModelListFail", amd]</small>
                            }
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-8">
                            <label class="form-label">@L["Set_RoutedTasks"]</label>
                            <div class="d-flex gap-3 flex-wrap">
                                @foreach (var st in AssistantFormState.AllSubtasks)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@_asForm.Route.Contains(st)"
                                               @onchange="e => ToggleRoute(st, (bool)e.Value!)" />
                                        <label class="form-check-label">@st</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Timeout (s)</label>
                            <input type="number" class="form-control" min="1" max="300"
                                   @bind="_asForm.TimeoutSeconds" />
                        </div>
                    </div>

                    @if (_assistant.HasApiKey)
                    {
                        <div class="mb-2">
                            <small class="text-muted">@L["Set_ActiveKey", _assistant.ApiKeySource]</small>
                            <code class="ms-1">@_assistant.ApiKeyHint</code>
                        </div>
                    }

                    <label class="form-label">
                        @(_assistant.HasApiKey ? L["Keys_ReplaceKey"].Value : "API key")
                    </label>
                    <input type="password" class="form-control font-monospace mb-2"
                           @bind="_asForm.ApiKey"
                           placeholder="@(_assistant.HasApiKey ? L["Set_KeepPh"].Value : "sk-…")"
                           autocomplete="off" />

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["Common_Save"]"
                                IsAsync="true" IsDisabled="_asForm.Saving"
                                OnClick="SaveAssistantAsync" />
                        <Button Color="Color.Secondary" Icon="fa-solid fa-plug" Text="@L["Set_TestConn"]"
                                IsAsync="true" IsDisabled="_asForm.Testing"
                                OnClick="TestAssistantAsync" />
                        @if (_assistant.ApiKeySource == "store")
                        {
                            <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                              Text="@L["Set_RemoveKey"]" Title="@L["Set_RemoveKey"]"
                                              Content="@L["Set_RemoveKeyContent"]"
                                              OnConfirm="RemoveAssistantKeyAsync" />
                        }
                        @if (_assistant.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="@L["Set_RestoreEnv"]" Title="@L["Set_RestoreEnv"]"
                                              Content="@L["Set_ClearContent"]"
                                              OnConfirm="ClearAssistantAsync" />
                        }
                    </div>

                    @if (_asForm.TestResult is { } atest)
                    {
                        <div class="mt-2">
                            @if (atest.Ok)
                            {
                                <Badge Color="Color.Success">@L["Set_AsstConnOk", atest.LatencyMs.ToString("F0")]</Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Danger">@L["Set_AsstFail", atest.Detail ?? L["Set_NoDetail"].Value]</Badge>
                            }
                        </div>
                    }
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
    <TabItem Text="GraphRAG" Icon="fa-solid fa-diagram-project">

<p class="text-muted">@L["Set_GraphIntro"]</p>

@if (_graph is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Set_LoadingGraph"]</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12">
            <Card>
                <HeaderTemplate>
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span>@L["Set_GraphCard"]</span>
                        @if (_graph.Source == "store")
                        {
                            <Badge Color="Color.Success">@L["Set_Configured"]</Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Info">@L["Set_Env"]</Badge>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-12 col-md-6">
                            <Switch @bind-Value="_graphForm.Enabled"
                                    DisplayText="@L["Set_GraphEnable"]" ShowLabel="true" />
                            <small class="text-muted d-block mt-1">@L["Set_GraphEnableHint"]</small>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label">@L["Set_GraphMaxChunks"]</label>
                            <input type="number" class="form-control font-monospace" min="1" max="10000"
                                   @bind="_graphForm.MaxChunksPerSync" />
                            <small class="text-muted">@L["Set_GraphMaxChunksHint"]</small>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@L["Set_GraphMaxChars"]</label>
                            <input type="number" class="form-control font-monospace" min="200" max="50000"
                                   @bind="_graphForm.MaxChunkChars" />
                            <small class="text-muted">@L["Set_GraphMaxCharsHint"]</small>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@L["Set_GraphMaxResults"]</label>
                            <input type="number" class="form-control font-monospace" min="10" max="10000"
                                   @bind="_graphForm.MaxResults" />
                            <small class="text-muted">@L["Set_GraphMaxResultsHint"]</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap kh-icon-btns">
                        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["Common_Save"]"
                                IsAsync="true" IsDisabled="_graphForm.Saving"
                                OnClick="SaveGraphAsync" />
                        @if (_graph.Source == "store")
                        {
                            <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                              Text="@L["Set_RestoreEnv"]" Title="@L["Set_RestoreEnv"]"
                                              Content="@L["Set_ClearContent"]"
                                              OnConfirm="ClearGraphAsync" />
                        }
                    </div>
                </BodyTemplate>
            </Card>
        </div>
    </div>
}
    </TabItem>
    <TabItem Text="@L["Set_TabResilience"]" Icon="fa-solid fa-shield-halved">

<p class="text-muted">@L["Set_ResIntro"]</p>

@if (_resilience is null)
{
    <div class="text-muted mb-4 kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Set_LoadingRes"]</div>
}
else
{
    <section class="border rounded p-3 mb-4">
        <div class="d-flex justify-content-between gap-2 align-items-center mb-3">
            <strong>Fallback policy</strong>
            <Badge Color="@(_resilience.Source == "store" ? Color.Success : Color.Info)">
                @(_resilience.Source == "store" ? L["Set_Configured"].Value : L["Set_Env"].Value)
            </Badge>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">@L["Set_Mode"]</label>
                <Select @bind-Value="_resForm.Mode">
                    <Options>
                        <SelectOption Text="@L["Set_ModeDisabled"]" Value="disabled" />
                        <SelectOption Text="@L["Set_ModeObserve"]" Value="observe" />
                        <SelectOption Text="@L["Set_ModeEnforce"]" Value="enforce" />
                    </Options>
                </Select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">@L["Set_MaxAlts"]</label>
                <input type="number" class="form-control font-monospace" min="1" max="5"
                       @bind="_resForm.MaxFallbackAttempts" />
                <small class="text-muted">@L["Set_MaxAltsHint"]</small>
            </div>
        </div>

        <h6 class="mt-2">@L["Set_ChatFallbacks"]</h6>
        @foreach (var (fb, i) in _resForm.ChatFallbacks.Select((f, i) => (f, i)))
        {
            <div class="row g-2 mb-2 align-items-center">
                <div class="col-12 col-md-4">
                    <input class="form-control form-control-sm font-monospace" placeholder="endpoint"
                           @bind="fb.Endpoint" />
                </div>
                <div class="col-12 col-md-3">
                    <input class="form-control form-control-sm font-monospace" placeholder="model"
                           @bind="fb.Model" />
                </div>
                <div class="col-12 col-md-4">
                    <input type="password" class="form-control form-control-sm font-monospace"
                           placeholder="@L["Set_ApiKeyKeepPh"]" @bind="fb.ApiKey" />
                </div>
                <div class="col-12 col-md-1">
                    <Button Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-trash"
                            OnClick="() => RemoveFallbackAsync(i)" />
                </div>
            </div>
        }
        <Button Size="Size.Small" Color="Color.Secondary" Icon="fa-solid fa-plus"
                Text="@L["Set_AddAlternate"]" OnClick="AddFallback" />

        <h6 class="mt-3">@L["Set_Capabilities"]</h6>
        <small class="text-muted d-block mb-2">@L["Set_CapHint"]</small>
        @foreach (var (cap, i) in _resForm.CapabilityRows.Select((c, i) => (c, i)))
        {
            <div class="row g-2 mb-2 align-items-center">
                <div class="col-12 col-md-1">
                    <Switch @bind-Value="cap.Enabled" ShowLabel="false"
                            title="@(cap.Enabled ? L["Set_CapOn"].Value : L["Set_CapOff"].Value)" />
                </div>
                <div class="col-12 col-md-4">
                    <input class="form-control form-control-sm font-monospace" placeholder="@L["Set_CapPh"]"
                           @bind="cap.Name" disabled="@(!cap.Enabled)" />
                </div>
                <div class="col-12 col-md-6">
                    <input class="form-control form-control-sm font-monospace" placeholder="@L["Set_ProvPh"]"
                           @bind="cap.Providers" disabled="@(!cap.Enabled)" />
                </div>
                <div class="col-12 col-md-1">
                    <Button Size="Size.Small" Color="Color.Danger" Icon="fa-solid fa-trash"
                            OnClick="() => RemoveCapability(i)" />
                </div>
            </div>
        }
        <Button Size="Size.Small" Color="Color.Secondary" Icon="fa-solid fa-plus"
                Text="@L["Set_AddCap"]" OnClick="AddCapability" />

        <div class="d-flex gap-2 flex-wrap kh-icon-btns mt-3">
            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="Salvar"
                    IsAsync="true" IsDisabled="_resForm.Saving"
                    OnClick="SaveResilienceAsync" />
            @if (_resilience.Source == "store")
            {
                <PopConfirmButton Color="Color.Warning" Icon="fa-solid fa-rotate-left"
                                  Text="@L["Set_RestoreEnv"]" Title="@L["Set_RestoreEnv"]"
                                  Content="@L["Set_ClearResContent"]"
                                  OnConfirm="ClearResilienceAsync" />
            }
        </div>
    </section>
}
    </TabItem>
    <TabItem Text="@L["Keys_Integrations"]" Icon="fa-solid fa-plug">

<p class="text-muted">@L["Set_IntIntro"]</p>

@if (_integrations is null)
{
    <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Set_LoadingInt"]</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in _integrations)
        {
            var state = _forms[item.Provider];
            <div class="col-12 col-lg-6">
                <Card>
                    <HeaderTemplate>
                        <div class="d-flex justify-content-between gap-2 align-items-center">
                            <span>@item.DisplayName</span>
                            <div class="d-flex align-items-center gap-2">
                                <Switch Value="item.Enabled" OnValueChanged="v => ToggleAsync(item, v)"
                                        ShowLabel="false" title="@(item.Enabled ? L["Set_DeactivateInt"].Value : L["Set_ActivateInt"].Value)" />
                                @if (!item.Enabled)
                                {
                                    <Badge Color="Color.Warning">@L["Set_Disabled"]</Badge>
                                }
                                else if (item.HasKey)
                                {
                                    <Badge Color="Color.Success">@L["Set_Configured"]</Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.Secondary">@L["Set_NoKey"]</Badge>
                                }
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (item.Note is not null)
                        {
                            <p class="text-muted mb-2">@item.Note</p>
                        }

                        @if (item.HasKey)
                        {
                            <div class="mb-2">
                                <small class="text-muted">@L["Set_ActiveKey", item.Source]</small>
                                <code class="ms-1">@item.KeyHint</code>
                            </div>
                        }

                        <label class="form-label">
                            @(item.HasKey ? L["Keys_ReplaceKey"].Value : "API key")
                        </label>
                        <div class="input-group kh-icon-btns">
                            <input type="password" class="form-control font-monospace"
                                   @bind="state.Input"
                                   placeholder="@ProviderPlaceholder(item.Provider)"
                                   autocomplete="off" />
                            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["Common_Save"]"
                                    IsAsync="true" IsDisabled="state.Saving"
                                    OnClick="() => SaveAsync(item)" />
