                            {
                                <PopConfirmButton Color="Color.Danger" Icon="fa-solid fa-trash"
                                                  Text="@L["Keys_Remove"]" Title="@L["Set_RemoveKey"]"
                                                  Content="@L["Set_RemoveKeyContent"]"
                                                  OnConfirm="() => RemoveAsync(item)" />
                            }
                        </div>
                        @if (item.Provider == "deepwiki")
                        {
                            <small class="text-muted d-block mt-2">@L["Set_DeepwikiHint"]</small>
                        }
                        @if (item.Provider == "firecrawl" && !item.HasKey)
                        {
                            <small class="text-muted d-block mt-2">@L["Set_FirecrawlHint"]</small>
                        }
                    </BodyTemplate>
                </Card>
            </div>
        }
