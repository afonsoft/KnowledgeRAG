@page "/flows"
@attribute [Authorize]
@using System.Text.Json
@using System.Text.Json.Nodes
@using KnowledgeHub.Shared
@using KnowledgeHub.Shared.Contracts
@inject FlowsApiClient Api
@inject ToastService Toast
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["Flows_PageTitle"]</PageTitle>

<div class="d-flex justify-content-between gap-2 align-items-center mb-3">
    <h1 class="h3 mb-0">Agent Flows</h1>
    <div class="d-flex gap-2">
        <Button Size="Size.Small" Icon="fa-solid fa-plus" Text="@L["Flows_New"]" TooltipText="@L["Flows_New"]"
                OnClick="NewFlow" />
        <Button Size="Size.Small" Icon="fa-solid fa-rotate" Text="@L["Common_Refresh"]" TooltipText="@L["Common_Refresh"]"
                IsAsync="true" OnClick="LoadAsync" IsDisabled="_loading" />
    </div>
</div>

<p class="text-muted small">
    @L["Flows_Intro1"]<code>flow_&lt;slug&gt;</code>@L["Flows_Intro2"]
</p>

@if (_flows is null)
{
    <div class="text-muted kh-action-loading"><i class="fa-solid fa-spinner fa-spin"></i> @L["Common_Loading"]</div>
}
else if (_flows.Count == 0 && _edit is null)
{
    <div class="text-muted">@L["Flows_Empty"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <caption class="visually-hidden">@L["Flows_Caption"]</caption>
            <thead>
                <tr>
                    <th>@L["Common_Name"]</th>
                    <th>Tool MCP</th>
                    <th>@L["Flows_EnabledCol"]</th>
                    <th>@L["Flows_Version"]</th>
                    <th>@L["Flows_Updated"]</th>
                    <th>@L["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _flows)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td><code>flow_@f.Slug</code></td>
                        <td>
                            @if (f.Enabled)
                            {
                                <Badge Color="Color.Success">@L["Flows_Yes"]</Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Secondary">@L["Flows_No"]</Badge>
                            }
                        </td>
                        <td>v@(f.Version)</td>
                        <td><small class="text-muted">@f.UpdatedAt.LocalDateTime.ToString("g")</small></td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <Button Size="Size.ExtraSmall" Icon="fa-solid fa-pen" Text="@L["Common_Edit"]" TooltipText="@L["Common_Edit"]"
                                        OnClick="() => EditFlowAsync(f)" />
                                <Button Size="Size.ExtraSmall" Color="Color.Primary" Icon="fa-solid fa-play" Text="@L["Flows_Run"]"
                                        TooltipText="@L["Flows_Run"]" IsAsync="true" OnClick="() => OpenRun(f)" />
                                <Button Size="Size.ExtraSmall" Color="Color.Info" Icon="fa-solid fa-clock-rotate-left"
                                        Text="@L["Flows_Runs"]" TooltipText="@L["Flows_RunsTooltip"]" IsAsync="true"
                                        OnClick="() => ShowRunsAsync(f)" />
                                <Button Size="Size.ExtraSmall" Color="Color.Warning" Icon="fa-solid fa-bolt"
                                        Text="@L["Flows_Triggers"]" TooltipText="@L["Flows_TriggersTooltip"]" IsAsync="true"
                                        OnClick="() => ShowTriggersAsync(f)" />
                                <PopConfirmButton Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-trash"
                                                  Text="@L["Common_Delete"]" TooltipText="@L["Common_Delete"]"
                                                  Content="@L["Flows_DeleteConfirm", f.Slug]"
                                                  OnConfirm="() => DeleteFlowAsync(f)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_edit is not null)
{
    <div class="card mt-3" id="flow-editor">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@(_edit.Id is null ? L["Flows_New"] : L["Flows_Edit", _edit.Name])</strong>
            <Button Size="Size.ExtraSmall" Icon="fa-solid fa-xmark" Text="@L["Common_Close"]" TooltipText="@L["Common_Close"]"
                    OnClick="() => _edit = null" />
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <BootstrapInput @bind-Value="_edit.Name" DisplayText="@L["Flows_NameLabel"]" ShowLabel="true" />
                </div>
                <div class="col-12 col-md-6">
                    <BootstrapInput @bind-Value="_edit.Description" DisplayText="@L["Flows_DescLabel"]" ShowLabel="true" />
                </div>
                <div class="col-12 col-md-2">
                    <Switch @bind-Value="_edit.Enabled" DisplayText="@L["Common_Enabled"]" ShowLabel="true" />
                </div>
            </div>

            @if (_edit.View != FlowEditorView.Json)
            {
            <h2 class="h6 mt-4">@L["Flows_InputsTitle"]</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <caption class="visually-hidden">@L["Flows_InputsCaption"]</caption>
                    <thead><tr><th>@L["Common_Name"]</th><th>@L["Common_Type"]</th><th>@L["Flows_RequiredCol"]</th><th>@L["Flows_DefaultCol"]</th><th>@L["Common_Description"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var input in _edit.Inputs)
                        {
                            <tr>
                                <td><BootstrapInput @bind-Value="input.Name" placeholder="customer_id" /></td>
                                <td>
                                    <Select @bind-Value="input.Type" Items="FlowEditModel.InputTypes" />
                                </td>
                                <td><Switch @bind-Value="input.Required" /></td>
                                <td><BootstrapInput @bind-Value="input.DefaultJson" placeholder="JSON" /></td>
                                <td><BootstrapInput @bind-Value="input.Description" /></td>
                                <td>
                                    <Button Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-trash"
                                            TooltipText="@L["Flows_RemoveInput"]" OnClick="() => _edit.Inputs.Remove(input)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Button Size="Size.ExtraSmall" Icon="fa-solid fa-plus" Text="@L["Flows_AddInput"]"
                    OnClick="AddInput" />
            }

            <div class="d-flex align-items-center gap-2 mt-4 mb-2">
                <h2 class="h6 mb-0">@L["Flows_Steps"]</h2>
                <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="@L["Flows_EditorMode"]">
                    <button type="button" class="btn @(_edit.View == FlowEditorView.Canvas ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => _edit.View = FlowEditorView.Canvas">
                        <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Canvas
                    </button>
                    <button type="button" class="btn @(_edit.View == FlowEditorView.List ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => _edit.View = FlowEditorView.List">
                        <i class="fa-solid fa-list" aria-hidden="true"></i> @L["Flows_List"]
                    </button>
                    <button type="button" class="btn @(_edit.View == FlowEditorView.Json ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => { SyncDefinitionJson(); _edit.View = FlowEditorView.Json; }">
                        <i class="fa-solid fa-code" aria-hidden="true"></i> JSON
                    </button>
                </div>
            </div>

            @if (_edit.View == FlowEditorView.Canvas)
            {
                <FlowCanvas Steps="_edit.Steps" Inputs="_edit.Inputs" OnChanged="StateHasChanged" />
            }
            else if (_edit.View == FlowEditorView.Json)
            {
                <Textarea @bind-Value="_edit.DefinitionJson" rows="12" class="font-monospace"
                          DisplayText="@L["Flows_JsonLabel"]" ShowLabel="true" />
            }
            else
            {
                @if (_edit.Steps.Count == 0)
                {
                    <div class="text-muted small">@L["Flows_NoSteps"]</div>
                }
                @for (var i = 0; i < _edit.Steps.Count; i++)
                {
                    var idx = i;
                    var s = _edit.Steps[idx];
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <span class="badge bg-secondary">#@(idx + 1)</span>
                            <BootstrapInput @bind-Value="s.Id" placeholder="id (ex.: fetch)" style="width:10rem" />
                            <Select @bind-Value="s.Type" Items="FlowEditModel.StepTypeItems(L)" style="width:9rem" />
                            <BootstrapInput @bind-Value="s.Name" placeholder="@L["Flows_LabelPh"]" style="width:12rem" />
                            <div class="ms-auto d-flex gap-1">
                                <Button Size="Size.ExtraSmall" Icon="fa-solid fa-arrow-up" TooltipText="@L["Flows_MoveUp"]"
                                        IsDisabled="idx == 0" OnClick="() => MoveStep(idx, -1)" />
                                <Button Size="Size.ExtraSmall" Icon="fa-solid fa-arrow-down" TooltipText="@L["Flows_MoveDown"]"
                                        IsDisabled="idx == _edit.Steps.Count - 1" OnClick="() => MoveStep(idx, 1)" />
                                <Button Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-trash"
                                        TooltipText="@L["Flows_RemoveStep"]" OnClick="() => _edit.Steps.RemoveAt(idx)" />
                            </div>
                        </div>
                        <Textarea @bind-Value="s.ConfigJson" placeholder="@L["Flows_ConfigPh"]"
                                  rows="3" class="font-monospace mt-2" />
                        @if (s.Type is "condition" or "foreach")
                        {
                            <Textarea @bind-Value="s.StepsJson" rows="2" class="font-monospace mt-1"
                                      placeholder="@L["Flows_NestedPh"]" />
                        }
                    </div>
                }
                <Button Size="Size.ExtraSmall" Icon="fa-solid fa-plus" Text="@L["Flows_AddStep"]" OnClick="AddStep" />
            }

            @if (!string.IsNullOrEmpty(_editError))
            {
                <div class="alert alert-danger mt-3" role="alert">@_editError</div>
            }

            <div class="d-flex gap-2 mt-3">
                <Button Color="Color.Secondary" Icon="fa-solid fa-check-double" Text="@L["Flows_Validate"]" IsAsync="true"
                        OnClick="ValidateAsync" />
                <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["Common_Save"]" IsAsync="true"
                        OnClick="SaveAsync" />
            </div>
        </div>
    </div>
}

@if (_runTarget is not null)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@L["Flows_RunTitle", _runTarget.Slug]</strong>
            <Button Size="Size.ExtraSmall" Icon="fa-solid fa-xmark" Text="@L["Common_Close"]" TooltipText="@L["Common_Close"]"
                    OnClick="() => { _runTarget = null; _runResult = null; }" />
        </div>
        <div class="card-body">
            <Textarea @bind-Value="_runInputsJson" DisplayText="@L["Flows_RunInputs"]"
                      ShowLabel="true" rows="4" class="font-monospace" placeholder="{}" />
            <Button Color="Color.Primary" Icon="fa-solid fa-play" Text="@L["Flows_RunGo"]" IsAsync="true"
                    OnClick="RunFlowAsync" class="mt-2" />

            @if (_runResult is not null)
            {
                <div class="mt-3">
                    <Badge Color="@(_runResult.Status switch { "done" => Color.Success, "waiting_approval" => Color.Warning, _ => Color.Danger })">
                        @_runResult.Status
                    </Badge>
                    <small class="text-muted ms-2">@_runResult.DurationMs ms</small>
                    @if (_runResult.ApprovalId is { } approvalId)
                    {
                        <div class="alert alert-warning mt-2 mb-0" role="alert">
                            <i class="fa-solid fa-user-check"></i> @L["Flows_WaitingApproval"]
                            <a href="/approvals" class="alert-link">@L["Flows_OpenApprovals"]</a>
                            <small class="d-block text-muted mt-1"><code>@approvalId</code></small>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_runResult.Error))
                    {
                        <div class="alert alert-danger mt-2" role="alert">@_runResult.Error</div>
                    }
                    <div class="table-responsive mt-2">
                        <table class="table table-sm">
                            <caption class="visually-hidden">@L["Flows_TraceCaption"]</caption>
                            <thead><tr><th>Step</th><th>@L["Common_Type"]</th><th>@L["Common_Status"]</th><th>ms</th><th>@L["Flows_OutputError"]</th></tr></thead>
                            <tbody>
                                @foreach (var s in _runResult.Steps)
                                {
                                    <tr>
                                        <td><code>@s.StepId</code></td>
                                        <td>@s.StepType</td>
                                        <td>@s.Status@(s.Attempts > 1 ? $" ×{s.Attempts}" : "")</td>
                                        <td>@s.DurationMs</td>
                                        <td><small class="text-break">@(s.Error ?? s.Output?.ToJsonString() ?? "")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_runResult.Output is not null)
                    {
                        <pre class="bg-light border rounded p-2 mt-2 small" aria-label="@L["Flows_OutputAria"]"><code>@_runResult.Output.ToJsonString()</code></pre>
                    }
                </div>
            }
        </div>
    </div>
}

@if (_runsTarget is not null)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@L["Flows_RunsTitle", _runsTarget.Slug]</strong>
            <Button Size="Size.ExtraSmall" Icon="fa-solid fa-xmark" Text="@L["Common_Close"]" TooltipText="@L["Common_Close"]"
                    OnClick="() => _runsTarget = null" />
        </div>
        <div class="card-body">
            @if (_runs is null)
            {
                <div class="text-muted"><i class="fa-solid fa-spinner fa-spin"></i> @L["Common_Loading"]</div>
            }
            else if (_runs.Count == 0)
            {
                <div class="text-muted">@L["Flows_NoRuns"]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <caption class="visually-hidden">@L["Flows_RunsCaption"]</caption>
                        <thead><tr><th>@L["Flows_When"]</th><th>@L["Common_Status"]</th><th>v</th><th>ms</th><th>@L["Common_Error"]</th></tr></thead>
                        <tbody>
                            @foreach (var r in _runs)
                            {
                                <tr>
                                    <td><small>@r.CreatedAt.LocalDateTime.ToString("g")</small></td>
                                    <td>@r.Status</td>
                                    <td>v@(r.FlowVersion)</td>
                                    <td>@r.DurationMs</td>
                                    <td><small class="text-break">@r.Error</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (_triggersTarget is not null)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@L["Flows_TriggersTitle", _triggersTarget.Slug]</strong>
            <Button Size="Size.ExtraSmall" Icon="fa-solid fa-xmark" Text="@L["Common_Close"]" TooltipText="@L["Common_Close"]"
                    OnClick="() => _triggersTarget = null" />
        </div>
        <div class="card-body">
            @if (_triggers is null)
            {
                <div class="text-muted"><i class="fa-solid fa-spinner fa-spin"></i> @L["Common_Loading"]</div>
            }
            else
            {
                @if (_triggers.Count == 0)
                {
                    <div class="text-muted mb-2">@L["Flows_NoTriggers"]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <caption class="visually-hidden">@L["Flows_TriggersCaption"]</caption>
                            <thead><tr><th>@L["Common_Type"]</th><th>@L["Flows_TriggerDetail"]</th><th>@L["Common_Enabled"]</th><th>@L["Flows_LastFired"]</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var t in _triggers)
                                {
                                    <tr>
                                        <td><Badge Color="@(t.Kind == "webhook" ? Color.Primary : Color.Info)">@t.Kind</Badge></td>
                                        <td>
                                            @if (t.WebhookUrl is { } url)
                                            {
                                                <code class="small text-break user-select-all">@url</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@L["Flows_EverySeconds", t.IntervalSeconds ?? 0]</span>
                                            }
                                        </td>
                                        <td>
                                            <Switch Value="t.Enabled" ValueChanged="(bool v) => SetTriggerEnabledAsync(t, v)"
                                                    DisplayText="" />
                                        </td>
                                        <td><small class="text-muted">@(t.LastFiredAt?.LocalDateTime.ToString("g") ?? "—")</small></td>
                                        <td>
                                            <PopConfirmButton Size="Size.ExtraSmall" Color="Color.Danger" Icon="fa-solid fa-trash"
                                                              TooltipText="@L["Common_Delete"]"
                                                              Content="@L["Flows_TriggerDeleteConfirm"]"
                                                              OnConfirm="() => DeleteTriggerAsync(t)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="border-top pt-3 mt-2">
                    <h2 class="h6">@L["Flows_NewTrigger"]</h2>
                    <div class="row g-2 align-items-end">
                        <div class="col-6 col-md-3">
                            <Select @bind-Value="_newTriggerKind" Items="_triggerKindItems" DisplayText="@L["Common_Type"]" ShowLabel="true" />
                        </div>
                        @if (_newTriggerKind == "schedule")
                        {
                            <div class="col-6 col-md-3">
                                <BootstrapInput @bind-Value="_newTriggerInterval" DisplayText="@L["Flows_IntervalSeconds"]" ShowLabel="true" type="number" />
                            </div>
                        }
                        <div class="col-12 col-md-4">
                            <BootstrapInput @bind-Value="_newTriggerInputs" DisplayText="@L["Flows_StaticInputs"]" ShowLabel="true"
                                            placeholder="{}" />
                        </div>
                        <div class="col-12 col-md-2">
                            <Button Color="Color.Primary" Icon="fa-solid fa-plus" Text="@L["Flows_AddTrigger"]" IsAsync="true"
                                    OnClick="CreateTriggerAsync" />
                        </div>
                    </div>
                    @if (_newTriggerKind == "webhook")
                    {
                        <small class="text-muted d-block mt-1">@L["Flows_WebhookHint"]</small>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private IReadOnlyList<FlowDto>? _flows;
    private bool _loading;
    private FlowEditModel? _edit;
    private string? _editError;
    private FlowDto? _runTarget;
    private string _runInputsJson = "{}";
    private FlowRunResultDto? _runResult;
    private FlowDto? _runsTarget;
    private IReadOnlyList<FlowRunDto>? _runs;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _flows = await Api.ListAsync(); }
        finally { _loading = false; }
    }

    private void NewFlow() => _edit = FlowEditModel.Empty();

    private async Task EditFlowAsync(FlowDto f)
    {
        var detail = await Api.GetAsync(f.Id);
        if (detail is null)
        {
            await Toast.Error(L["Common_Error"], L["Flows_NotFound"]);
            return;
        }
        _edit = FlowEditModel.From(detail);
    }

    private async Task DeleteFlowAsync(FlowDto f)
    {
        var (ok, error) = await Api.DeleteAsync(f.Id);
        if (ok)
        {
            await Toast.Success(L["Flows_Deleted"], "");
            await LoadAsync();
        }
        else await Toast.Error(L["Common_Error"], error ?? L["Flows_DeleteFail"].Value);
    }

    private void AddInput() => _edit?.Inputs.Add(new FlowInputModel());
    private void AddStep() => _edit?.Steps.Add(new FlowStepModel());

    private void MoveStep(int idx, int delta)
    {
        if (_edit is null) return;
        var j = idx + delta;
        if (j < 0 || j >= _edit.Steps.Count) return;
        (_edit.Steps[idx], _edit.Steps[j]) = (_edit.Steps[j], _edit.Steps[idx]);
    }

    private (FlowDefinitionDto? Def, string? Error) BuildDefinition()
    {
        if (_edit is null) return (null, L["Flows_EditorEmpty"].Value);
        // Raw JSON view wins over the structured editors
        if (_edit.View == FlowEditorView.Json && !string.IsNullOrWhiteSpace(_edit.DefinitionJson))
        {
            try
            {
                var def = JsonSerializer.Deserialize<FlowDefinitionDto>(_edit.DefinitionJson, SharedJson.Options);
                return def is null ? (null, L["Flows_InvalidDef"].Value) : (def, null);
            }
            catch (JsonException ex) { return (null, L["Flows_InvalidJson", ex.Message].Value); }
        }

        var (inputs, inputsError) = BuildInputs();
        if (inputsError is not null) return (null, inputsError);
        var (steps, stepsError) = BuildSteps();
        if (stepsError is not null) return (null, stepsError);
        return (new FlowDefinitionDto(inputs!, steps!), null);
    }

    private (List<FlowInputDto>?, string?) BuildInputs()
    {
        var inputs = new List<FlowInputDto>();
        foreach (var i in _edit!.Inputs)
        {
            if (string.IsNullOrWhiteSpace(i.Name))
                return (null, L["Flows_InputNeedsName"].Value);
            JsonNode? def = null;
            if (!string.IsNullOrWhiteSpace(i.DefaultJson))
            {
                try { def = JsonNode.Parse(i.DefaultJson); }
                catch (JsonException ex) { return (null, L["Flows_InvalidDefault", i.Name, ex.Message].Value); }
            }
            inputs.Add(new FlowInputDto(i.Name.Trim(), i.Type, i.Required, i.Description, def));
        }
        return (inputs, null);
    }

    private (List<FlowStepDto>?, string?) BuildSteps()
    {
        var steps = new List<FlowStepDto>();
        foreach (var s in _edit!.Steps)
        {
            if (string.IsNullOrWhiteSpace(s.Id))
                return (null, L["Flows_StepNeedsId"].Value);
            var (config, configError) = ParseStepConfig(s);
            if (configError is not null) return (null, configError);
            var (nested, nestedError) = ParseNestedSteps(s);
            if (nestedError is not null) return (null, nestedError);
            steps.Add(new FlowStepDto(s.Id.Trim(), s.Type, s.Name, config, nested));
        }
        return (steps, null);
    }

    private (JsonObject?, string?) ParseStepConfig(FlowStepModel s)
    {
        if (string.IsNullOrWhiteSpace(s.ConfigJson))
            return (null, null);
        JsonObject? config;
        try { config = JsonNode.Parse(s.ConfigJson) as JsonObject; }
        catch (JsonException ex) { return (null, L["Flows_InvalidConfig", s.Id, ex.Message].Value); }
        return config is null ? (null, L["Flows_ConfigNotObject", s.Id].Value) : (config, null);
    }

    private (List<FlowStepDto>?, string?) ParseNestedSteps(FlowStepModel s)
    {
        if (string.IsNullOrWhiteSpace(s.StepsJson))
            return (null, null);
        try { return (JsonSerializer.Deserialize<List<FlowStepDto>>(s.StepsJson, SharedJson.Options), null); }
        catch (JsonException ex) { return (null, L["Flows_InvalidNested", s.Id, ex.Message].Value); }
    }

    private async Task ValidateAsync()
    {
        var (def, error) = BuildDefinition();
        if (def is null) { _editError = error; return; }
        var (valid, err) = await Api.ValidateAsync(def);
        _editError = valid ? null : err;
        if (valid) await Toast.Success(L["Flows_Valid"], "");
    }

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        var (def, error) = BuildDefinition();
        if (def is null) { _editError = error; return; }

        if (string.IsNullOrWhiteSpace(_edit.Name))
        {
            _editError = L["Flows_NameRequired"];
            return;
        }

        var (detail, err) = _edit.Id is null
            ? await Api.CreateAsync(new CreateFlowRequest(_edit.Name, _edit.Description, def))
            : await Api.UpdateAsync(_edit.Id.Value,
                new UpdateFlowRequest(_edit.Name, _edit.Description, _edit.Enabled, def));

        if (detail is null)
        {
            _editError = err;
            return;
        }
        _editError = null;
        _edit = null;
        await Toast.Success(L["Flows_Saved"], $"flow_{detail.Flow.Slug}");
        await LoadAsync();
    }

    private void OpenRun(FlowDto f)
    {
        _runTarget = f;
        _runResult = null;
        _runInputsJson = "{}";
    }

    private async Task RunFlowAsync()
    {
        if (_runTarget is null) return;
        JsonObject? inputs;
        try { inputs = JsonNode.Parse(_runInputsJson) as JsonObject; }
        catch (JsonException ex)
        {
            await Toast.Error(L["Common_Error"], L["Flows_InvalidInputs", ex.Message]);
            return;
        }
        var (result, error) = await Api.RunAsync(_runTarget.Id, inputs);
        if (result is not null) _runResult = result;
        else await Toast.Error(L["Common_Error"], error ?? L["Flows_RunFail"].Value);
    }

    private async Task ShowRunsAsync(FlowDto f)
    {
        _runsTarget = f;
        _runs = null;
        _runs = await Api.RunsAsync(f.Id);
    }

    // ── Triggers ──────────────────────────────────────────────────────

    private FlowDto? _triggersTarget;
    private IReadOnlyList<FlowTriggerDto>? _triggers;
    private string _newTriggerKind = "webhook";
    private int _newTriggerInterval = 300;
    private string _newTriggerInputs = "{}";

    private List<SelectedItem> _triggerKindItems =>
    [
        new("webhook", L["Flows_KindWebhook"].Value),
        new("schedule", L["Flows_KindSchedule"].Value),
    ];

    private async Task ShowTriggersAsync(FlowDto f)
    {
        _triggersTarget = f;
        _triggers = null;
        _triggers = await Api.TriggersAsync(f.Id);
    }

    private async Task CreateTriggerAsync()
    {
        if (_triggersTarget is null) return;
        JsonObject? inputs = null;
        if (!string.IsNullOrWhiteSpace(_newTriggerInputs))
        {
            try { inputs = JsonNode.Parse(_newTriggerInputs) as JsonObject; }
            catch (JsonException ex)
            {
                await Toast.Error(L["Common_Error"], L["Flows_InvalidInputs", ex.Message]);
                return;
            }
        }
        var (trigger, error) = await Api.CreateTriggerAsync(
            _triggersTarget.Id,
            new CreateFlowTriggerRequest(_newTriggerKind, _newTriggerInterval, inputs));
        if (trigger is null)
        {
            await Toast.Error(L["Common_Error"], error ?? L["Flows_TriggerFail"].Value);
            return;
        }
        await Toast.Success(L["Flows_TriggerCreated"],
            trigger.WebhookUrl ?? L["Flows_KindSchedule"].Value);
        _triggers = await Api.TriggersAsync(_triggersTarget.Id);
    }

    private async Task SetTriggerEnabledAsync(FlowTriggerDto t, bool enabled)
    {
        var (_, error) = await Api.UpdateTriggerAsync(
            t.Id, new UpdateFlowTriggerRequest(enabled, null, null));
        if (error is not null)
        {
            await Toast.Error(L["Common_Error"], error);
            return;
        }
        if (_triggersTarget is not null)
            _triggers = await Api.TriggersAsync(_triggersTarget.Id);
    }

    private async Task DeleteTriggerAsync(FlowTriggerDto t)
    {
        var (ok, error) = await Api.DeleteTriggerAsync(t.Id);
        if (ok)
        {
            await Toast.Success(L["Flows_TriggerDeleted"], "");
            if (_triggersTarget is not null)
                _triggers = await Api.TriggersAsync(_triggersTarget.Id);
        }
        else await Toast.Error(L["Common_Error"], error ?? L["Flows_TriggerFail"].Value);
    }

    /// <summary>Serialize the structured model back into DefinitionJson so the
    /// JSON view starts from the current list/canvas state (JSON edits then win
    /// while that view is active).</summary>
    private void SyncDefinitionJson()
    {
        if (_edit is null) return;
        var view = _edit.View;
        _edit.View = FlowEditorView.List; // force structured build
        var (def, _) = BuildDefinition();
        _edit.View = view;
        if (def is not null)
            _edit.DefinitionJson = JsonSerializer.Serialize(def, SharedJson.Options);
    }
}
