                break;
            case SourceType.RssFeed:
                WriteRssFeed(config);
                break;
            case SourceType.YouTube:
                WriteYouTube(config);
                break;
            case SourceType.RestApi:
                WriteRestApi(config);
                break;
            case SourceType.SqlDatabase:
                WriteSqlDatabase(config);
                break;
            case SourceType.McpProxy:
