            <BootstrapInput @bind-Value="Model.AccessKeyId" DisplayText="Access Key ID *" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">
                Secret Access Key @(Model.HasStoredKey ? "(armazenada — em branco mantém a atual)" : "*")
            </label>
            <input type="password" class="form-control font-monospace" @bind="Model.SecretAccessKey"
                   autocomplete="new-password" placeholder="@(Model.HasStoredKey ? "••••••••" : "")" />
        </div>
    }
    @if (Model.Type is SourceType.AzureFiles)
    {
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.ShareName" DisplayText="Share name *" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.DirectoryPath" DisplayText="Diretório raiz" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.AccountName" DisplayText="Account name (se não usar connection string)" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.Prefix" DisplayText="Prefixo (opcional)" ShowLabel="true" />
        </div>
        <div class="col-12">
            <label class="form-label">
                Connection string ou Account Key @(Model.HasStoredKey ? "(armazenada — em branco mantém a atual)" : "*")
            </label>
            <input type="password" class="form-control font-monospace" @bind="Model.SecretAccessKey"
                   autocomplete="new-password" placeholder="@(Model.HasStoredKey ? "••••••••" : "")" />
            <div class="form-text">Cole a connection string completa, ou só a account key com o account name acima.</div>
        </div>
    }
    @if (Model.Type is SourceType.AwsS3 or SourceType.AzureFiles or SourceType.OciStorage
        or SourceType.GoogleDrive)
    {
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.Glob" DisplayText="Filtro glob (ex.: **/*.{pdf,docx,md,txt})" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInputNumber @bind-Value="Model.MaxFileSizeMB" DisplayText="Tamanho máx. arquivo (MB, padrão 20)"
                                  ShowLabel="true" IsNullable="true" />
        </div>
    }
    @* SPEC-20260924-gdrive-shared-link-connector RF-007. *@
    @if (Model.Type is SourceType.GoogleDrive)
    {
        <div class="col-12">
            <BootstrapInput @bind-Value="Model.SharedUrl" DisplayText="Link Compartilhado do Google Drive *"
                            ShowLabel="true"
                            PlaceHolder="https://drive.google.com/drive/folders/..." />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInputNumber @bind-Value="Model.MaxFiles" DisplayText="Máximo de arquivos (padrão 200)"
                                  ShowLabel="true" IsNullable="true" Min="1" Max="1000" />
        </div>
        <div class="col-12">
            <label class="form-label">
                API Key do Google @(Model.HasStoredKey ? "(armazenada — em branco mantém a atual)" : "(opcional)")
            </label>
            <input type="password" class="form-control font-monospace" @bind="Model.ApiKey"
                   autocomplete="new-password" placeholder="@(Model.HasStoredKey ? "••••••••" : "AIza…")" />
            <div class="form-text">
                Sem key, links de arquivo único funcionam e pastas usam a listagem pública
                (plana, sem recursão). Com key a listagem é recursiva via Drive API v3.
            </div>
        </div>
    }

    <div class="col-6 col-md-3">
        <Switch @bind-Value="Model.IsActive" DisplayText="Ativa" ShowLabel="true" />
    </div>
    <div class="col-6 col-md-3">
        <Switch @bind-Value="Model.AutoSyncEnabled" DisplayText="Auto-sync" ShowLabel="true" />
    </div>
    @* SPEC-20260925-semantic-chunking-source-ui RF-001/RF-002: per-source
       chunking strategy for document-producing types. *@
    @if (Model.Type is SourceType.ObsidianVault or SourceType.DocumentFile or SourceType.WebPage
        or SourceType.Notion or SourceType.AwsS3 or SourceType.AzureFiles or SourceType.OciStorage
        or SourceType.GoogleDrive or SourceType.UnstructuredDocument or SourceType.GitRepository
        or SourceType.AudioTranscription)
    {
        <div class="col-12 col-md-6">
            <Select @bind-Value="Model.Chunking" Items="ChunkingItems" DisplayText="Estratégia de chunking"
                    ShowLabel="true"
                    PlaceHolder="Auto" />
            <div class="form-text">
                Semantic embedda sentenças e corta por mudança de assunto (mais lento na ingestão).
                VisionLayout preserva tabelas como blocos atômicos com cabeçalho repetido.
            </div>
        </div>
    }
    @if (Model.Type is SourceType.ObsidianVault)
    {
        <div class="col-6 col-md-3">
            <Switch @bind-Value="Model.ReadOnly" DisplayText="Somente leitura" ShowLabel="true" />
        </div>
    }
    <div class="col-12 col-md-6">
        <BootstrapInputNumber @bind-Value="Model.SyncIntervalMinutes" DisplayText="Intervalo (min)" ShowLabel="true" IsNullable="true" />
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="col-12">
            <Alert Color="Color.Danger" ShowDismiss="false">
                <strong>Não foi possível salvar.</strong> @Error
                @if (!string.IsNullOrEmpty(ErrorDetail) && ErrorDetail != Error)
                {
                    <details class="mt-1">
                        <summary>Detalhes técnicos</summary>
                        <pre class="mb-0 small" style="white-space: pre-wrap;">@ErrorDetail</pre>
                    </details>
                }
            </Alert>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
