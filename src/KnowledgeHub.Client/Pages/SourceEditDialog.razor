        @if (Model.AudioProvider == "whisper")
        {
            <div class="col-12 col-md-6">
                <BootstrapInput @bind-Value="Model.Endpoint" DisplayText="Endpoint whisper-compatible"
                                ShowLabel="true" PlaceHolder="https://api.openai.com" />
            </div>
        }
        <div class="col-12 col-md-3">
            <BootstrapInputNumber @bind-Value="Model.TimeoutMinutes" DisplayText="Timeout por arquivo (min)"
                                  ShowLabel="true" IsNullable="true" Min="1" Max="120" />
        </div>
        <div class="col-12 col-md-4 d-flex align-items-end">
            <Switch @bind-Value="Model.EnableSpeakerDiarization" DisplayText="Diarização (speakers)" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-4 d-flex align-items-end">
            <Switch @bind-Value="Model.EnableAutoChapters" DisplayText="Capítulos automáticos" ShowLabel="true" />
        </div>
        <div class="col-12">
            <label class="form-label">
                API Key @(Model.HasStoredKey ? "(armazenada — em branco mantém)" : "(obrigatória p/ AssemblyAI)")
            </label>
            <BootstrapInput type="password" @bind-Value="Model.ApiKey"
                            PlaceHolder="assemblyai / openai api key" />
            <div class="form-text">Armazenada criptografada; nunca retornada pela API.</div>
        </div>
