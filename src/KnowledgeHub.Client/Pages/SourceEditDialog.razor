    @if (Model.Type is SourceType.SqlDatabase)
    {
        <div class="col-12 col-md-6">
            <Select @bind-Value="Model.Provider" Items="SqlProviderItems" DisplayText="Provider *"
                    ShowLabel="true" />
        </div>
        <div class="col-12">
            <label class="form-label">
                Connection string @(Model.HasStoredKey ? "* (armazenada — em branco mantém)" : "*")
            </label>
            <Textarea @bind-Value="Model.ConnectionString" rows="2"
                      PlaceHolder="@(Model.Provider == "postgres"
                          ? "Host=localhost;Database=app;Username=readonly"
                          : "Data Source=notes.db")" />
            <div class="form-text">
                Armazenada criptografada; nunca retornada pela API. SQLite com caminho
                relativo resolve ao lado do executável e abre em modo somente leitura.
            </div>
        </div>
        <div class="col-12">
            <Textarea @bind-Value="Model.Query" DisplayText="Query (SELECT/WITH somente, read-only) *"
                      ShowLabel="true" rows="3" PlaceHolder="SELECT id, title, body FROM notes" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.IdColumn" DisplayText="Coluna(s) do ID (opcional, separadas por vírgula)"
                            ShowLabel="true" PlaceHolder="id" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.TitleColumn" DisplayText="Coluna do título (opcional)"
                            ShowLabel="true" PlaceHolder="title" />
        </div>
        <div class="col-12">
            <Textarea @bind-Value="Model.ContentColumns" DisplayText="Colunas de conteúdo (uma por linha, opcional)"
                      ShowLabel="true" rows="2" PlaceHolder="title&#10;body" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.UrlColumn" DisplayText="Coluna de URL (opcional)"
                            ShowLabel="true" PlaceHolder="url" />
