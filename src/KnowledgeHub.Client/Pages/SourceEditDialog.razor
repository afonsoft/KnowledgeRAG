        public static SourceEditModel FromDto(KnowledgeSourceDto dto) => new()
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            Type = dto.Type,
            IsActive = dto.IsActive,
            AutoSyncEnabled = dto.AutoSyncEnabled,
            ReadOnly = ReadBool(dto.Configuration, "readOnly"),
            SyncIntervalMinutes = dto.SyncIntervalMinutes,
            Path = dto.Configuration?["path"]?.GetValue<string>(),
            Url = dto.Configuration?["url"]?.GetValue<string>(),
            Endpoint = dto.Configuration?["endpoint"]?.GetValue<string>(),
            Headers = dto.Configuration?["headers"]?.GetValue<string>(),
            ConnectionString = dto.Configuration?["connectionString"]?.GetValue<string>(),
            Query = dto.Configuration?["query"]?.GetValue<string>(),
            NamePrefix = dto.Configuration?["namePrefix"]?.GetValue<string>(),
            Transport = dto.Configuration?["transport"]?.GetValue<string>() ?? "auto",
            RootPageIds = ReadStringList(dto.Configuration, "rootPageIds"),
            RootDatabaseIds = ReadStringList(dto.Configuration, "rootDatabaseIds"),
            MaxPages = ReadInt(dto.Configuration, "maxPages"),
            ItemsPath = dto.Configuration?["itemsPath"]?.GetValue<string>(),
            TitleField = dto.Configuration?["titleField"]?.GetValue<string>(),
            ContentFields = ReadStringList(dto.Configuration, "contentFields"),
            IdField = dto.Configuration?["idField"]?.GetValue<string>(),
            UrlField = dto.Configuration?["urlField"]?.GetValue<string>(),
            PageParam = dto.Configuration?["pageParam"]?.GetValue<string>(),
            Provider = ReadStringOr(dto.Configuration, "provider", "sqlite"),
            IdColumn = dto.Configuration?["idColumn"]?.GetValue<string>(),
            TitleColumn = dto.Configuration?["titleColumn"]?.GetValue<string>(),
            ContentColumns = ReadStringList(dto.Configuration, "contentColumns"),
            UrlColumn = dto.Configuration?["urlColumn"]?.GetValue<string>(),
            MaxRows = ReadInt(dto.Configuration, "maxRows"),
            CommandTimeoutSeconds = ReadInt(dto.Configuration, "commandTimeoutSeconds"),
            BucketName = dto.Configuration?["bucketName"]?.GetValue<string>(),
            Region = dto.Configuration?["region"]?.GetValue<string>(),
            Namespace = dto.Configuration?["namespace"]?.GetValue<string>(),
            ShareName = dto.Configuration?["shareName"]?.GetValue<string>(),
            DirectoryPath = dto.Configuration?["directoryPath"]?.GetValue<string>(),
            Prefix = dto.Configuration?["prefix"]?.GetValue<string>(),
            Glob = dto.Configuration?["glob"]?.GetValue<string>(),
            MaxFileSizeMB = ReadInt(dto.Configuration, "maxFileSizeMB"),
            AccessKeyId = dto.Configuration?["accessKeyId"]?.GetValue<string>(),
            AccountName = dto.Configuration?["accountName"]?.GetValue<string>(),
            Chunking = dto.Configuration?["chunking"]?.GetValue<string>(),
            SharedUrl = dto.Configuration?["sharedUrl"]?.GetValue<string>(),
            MaxFiles = ReadInt(dto.Configuration, "maxFiles"),
            FolderPath = dto.Configuration?["folderPath"]?.GetValue<string>(),
            Files = ReadStringList(dto.Configuration, "files"),
            ApiUrl = dto.Configuration?["apiUrl"]?.GetValue<string>(),
            Strategy = ReadStringOr(dto.Configuration, "strategy", "auto"),
            Coordinates = ReadBool(dto.Configuration, "coordinates"),
            TableExtraction = ReadBoolOrTrue(dto.Configuration, "tableExtraction"),
            MaxFileSizeMb = dto.Configuration?["maxFileSizeMb"] is JsonValue msm
                && msm.TryGetValue<int>(out var msmn) ? msmn : null,
            GitProvider = ReadStringOr(dto.Configuration, "provider", "github"),
            RepoUrl = dto.Configuration?["repoUrl"]?.GetValue<string>(),
            Owner = dto.Configuration?["owner"]?.GetValue<string>(),
            RepoName = dto.Configuration?["name"]?.GetValue<string>(),
            InstanceUrl = dto.Configuration?["instanceUrl"]?.GetValue<string>(),
            Branch = dto.Configuration?["branch"]?.GetValue<string>() is { Length: > 0 } br
                ? br : "main",
            IncludePatterns = ReadStringList(dto.Configuration, "includePatterns"),
            ExcludePatterns = ReadStringList(dto.Configuration, "excludePatterns"),
            MaxFileSizeBytes = ReadInt(dto.Configuration, "maxFileSizeBytes"),
            AllowPrivateHosts = ReadBool(dto.Configuration, "allowPrivateHosts"),
            AudioProvider = ReadStringOr(dto.Configuration, "provider", "assemblyai"),
            EnableSpeakerDiarization = ReadBoolOrTrue(dto.Configuration, "enableSpeakerDiarization"),
            EnableAutoChapters = ReadBoolOrTrue(dto.Configuration, "enableAutoChapters"),
