@using System.Text.Json.Nodes

@* SPEC-05 RF-002: create/edit form with per-type dynamic config fields.
   SPEC-20260915-sources-edit-dialog: readOnly flag, indexed-content summary,
   friendly error surface and inline sync. *@

<div class="row g-3">
    @if (Model.Id is not null)
    {
        <div class="col-12">
            <div class="border rounded p-3">
                <div class="d-flex justify-content-between gap-2 align-items-center mb-2">
                    <strong>Resumo</strong>
                    <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-rotate"
                            Text="@(SyncRunning ? "Sincronizando…" : "Sincronizar agora")"
                            TooltipText="Sincronizar agora" TooltipPlacement="Placement.Left"
                            IsDisabled="SyncRunning" OnClick="RequestSyncAsync" />
                </div>
                @if (SummaryLoading)
                {
                    <div class="text-muted small">
                        <i class="fa-solid fa-spinner fa-spin"></i> Carregando resumo…
                    </div>
                }
                else if (SummaryFailed)
                {
                    <div class="text-muted small">Resumo indisponível — não foi possível carregar os documentos.</div>
                }
                else
                {
                    var docs = Documents ?? [];
                    <div class="small">
                        <strong>@docs.Count</strong> documento(s) ·
                        <strong>@docs.Sum(d => d.ChunkCount)</strong> chunks ·
                        última indexação: @(docs.Count > 0 ? docs.Max(d => d.IndexedAt).LocalDateTime.ToString("g") : "—")
                    </div>
                    <div class="small mt-1">
                        Último sync: @(Source?.LastSyncAt?.LocalDateTime.ToString("g") ?? "—")
                        @switch (Source?.LastSyncStatus)
                        {
                            case "completed":
                                <Badge Color="Color.Success">ok</Badge>
                                break;
                            case "failed":
                                <Badge Color="Color.Danger">falhou</Badge>
                                break;
                            case "skipped":
                                <Badge Color="Color.Warning">skip</Badge>
                                break;
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Source?.LastError))
                    {
                        <div class="small text-danger mt-1">Último erro: @Source.LastError</div>
                    }
                    @if (docs.Count > 0)
                    {
                        <details class="mt-1">
                            <summary class="small">Documentos indexados (mostrando @Math.Min(docs.Count, 20) de @docs.Count)</summary>
                            <ul class="small mb-0 mt-1">
                                @foreach (var d in docs.OrderByDescending(x => x.IndexedAt).Take(20))
                                {
                                    <li>@d.Title <span class="text-muted">(@d.ChunkCount chunks)</span></li>
                                }
                            </ul>
                        </details>
                    }
                }
                @if (SyncResult is { } r)
                {
                    <div class="small mt-2 @(r.Status == "failed" ? "text-danger" : "text-muted")">
                        Sync: <strong>@r.Status</strong> — @r.DocumentsProcessed processados,
                        @r.DocumentsSkipped ignorados, @r.DocumentsRemoved removidos,
                        @r.ChunksCreated chunks em @r.DurationMs.ToString("F0")ms
                        @if (!string.IsNullOrEmpty(r.Reason))
                        {
                            <span>(@r.Reason)</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(SyncError))
                {
                    <div class="small text-danger mt-2">Sync falhou: @SyncError</div>
                }
            </div>
        </div>
    }

    <div class="col-12 col-md-6">
        <BootstrapInput @bind-Value="Model.Name" DisplayText="Nome *" ShowLabel="true" />
    </div>
    <div class="col-12 col-md-6">
        <Select @bind-Value="Model.Type" DisplayText="Tipo" ShowLabel="true" />
    </div>
    <div class="col-12">
        <BootstrapInput @bind-Value="Model.Description" DisplayText="Descrição" ShowLabel="true" />
    </div>

    @if (Model.Type is SourceType.ObsidianVault or SourceType.DocumentFile)
    {
        <div class="col-12">
            <BootstrapInput @bind-Value="Model.Path" DisplayText="Caminho (path) *" ShowLabel="true" />
        </div>
    }
    @if (Model.Type is SourceType.WebPage)
    {
        <div class="col-12">
            <BootstrapInput @bind-Value="Model.Url" DisplayText="URL *" ShowLabel="true" />
        </div>
    }
    @if (Model.Type is SourceType.RssFeed)
    {
        <div class="col-12">
            <BootstrapInput @bind-Value="Model.FeedUrl" DisplayText="URL do feed (RSS/Atom) *"
                            ShowLabel="true" PlaceHolder="https://blog.example.com/feed.xml" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInputNumber @bind-Value="Model.MaxItems" DisplayText="Máx. itens (padrão 100)"
                                  ShowLabel="true" IsNullable="true" Min="1" Max="500" />
        </div>
        <div class="col-12 col-md-3">
            <Switch @bind-Value="Model.FetchFullContent" DisplayText="Buscar conteúdo completo"
                    ShowLabel="true" />
        </div>
        <div class="col-12 col-md-3">
            <Switch @bind-Value="Model.ForceRefresh" DisplayText="Forçar refresh"
                    ShowLabel="true" />
        </div>
        <div class="col-12">
            <div class="form-text">
                Sincroniza RSS 2.0 e Atom 1.0. Sync incremental por <code>guid</code> do item.
                "Buscar conteúdo completo" baixa a página linkada de cada item e extrai o texto
                (útil quando o feed só traz teasers). "Forçar refresh" reprocessa todos os itens,
                mesmo sem alterações de <code>guid</code>/data.
            </div>
        </div>
    }
    @if (Model.Type is SourceType.YouTube)
    {
        <div class="col-12">
            <Textarea @bind-Value="Model.Urls" DisplayText="URLs dos vídeos/playlists/canais *"
                      ShowLabel="true" rows="4"
                      PlaceHolder="https://www.youtube.com/watch?v=dQw4w9WgXcQ&#10;https://youtu.be/dQw4w9WgXcQ&#10;https://youtube.com/playlist?list=PL..." />
        </div>
        <div class="col-12 col-md-4">
            <BootstrapInput @bind-Value="Model.Language" DisplayText="Idioma preferido (opcional)"
                            ShowLabel="true" PlaceHolder="pt, en, pt-BR" />
        </div>
        <div class="col-12 col-md-4">
            <BootstrapInputNumber @bind-Value="Model.MaxVideos" DisplayText="Máx. vídeos (padrão 100)"
                                  ShowLabel="true" IsNullable="true" Min="1" Max="500" />
        </div>
        <div class="col-6 col-md-2">
            <Switch @bind-Value="Model.IncludeAutoCaptions" DisplayText="Auto-captions"
                    ShowLabel="true" />
        </div>
        <div class="col-6 col-md-2">
            <Switch @bind-Value="Model.IncludeTimestamps" DisplayText="Timestamps"
                    ShowLabel="true" />
        </div>
        <div class="col-12">
            <Switch @bind-Value="Model.ForceRefresh" DisplayText="Forçar refresh (re-baixar legendas)"
                    ShowLabel="true" />
            <div class="form-text">
                Indexa transcrições (legendas) de vídeos públicos do YouTube via <strong>YoutubeExplode</strong>.
                Aceita URLs de vídeos, playlists e canais (ou IDs crus). Sync incremental por
                <code>yt:{videoId}</code> — vídeos já indexados são pulados. Sem credenciais.
            </div>
        </div>
    }
