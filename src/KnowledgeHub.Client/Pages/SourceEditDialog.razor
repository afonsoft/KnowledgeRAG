                <BootstrapInput @bind-Value="Model.Namespace" DisplayText="Namespace *" ShowLabel="true" />
            </div>
        }
        <div class="col-12 col-md-4">
            <BootstrapInput @bind-Value="Model.BucketName" DisplayText="Bucket *" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-4">
            <BootstrapInput @bind-Value="Model.Region" DisplayText="Região * (ex.: us-east-1, sa-saopaulo-1)" ShowLabel="true" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.Prefix" DisplayText="Prefixo / pasta" ShowLabel="true" />
        </div>
