                      PlaceHolder='{"Authorization":"Bearer …"}' />
            <div class="form-text">
                Objeto JSON de headers — ex.: <code>X-Api-Key</code>, <code>Authorization</code>.
                Armazenado criptografado; nunca retornado pela API.
            </div>
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.ItemsPath" DisplayText="Caminho dos itens (dot-path, opcional)"
                            ShowLabel="true" PlaceHolder="data.results" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.TitleField" DisplayText="Campo do título (opcional)"
                            ShowLabel="true" PlaceHolder="title" />
        </div>
        <div class="col-12">
            <Textarea @bind-Value="Model.ContentFields" DisplayText="Campos de conteúdo (um por linha, opcional)"
                      ShowLabel="true" rows="2" PlaceHolder="title&#10;body" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.IdField" DisplayText="Campo do ID (opcional)"
                            ShowLabel="true" PlaceHolder="id" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.UrlField" DisplayText="Campo da URL (opcional)"
                            ShowLabel="true" PlaceHolder="link" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.PageParam" DisplayText="Parâmetro de paginação (opcional)"
                            ShowLabel="true" PlaceHolder="page" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInputNumber @bind-Value="Model.MaxPages" DisplayText="Máx. páginas (padrão 1)"
                                  ShowLabel="true" IsNullable="true" Min="1" Max="50" />
