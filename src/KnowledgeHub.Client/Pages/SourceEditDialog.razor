            <Textarea @bind-Value="Model.RootPageIds" DisplayText="Page IDs raiz (um por linha — vazio = tudo compartilhado)"
                      ShowLabel="true" rows="3" />
        </div>
        <div class="col-12 col-md-6">
            <Textarea @bind-Value="Model.RootDatabaseIds" DisplayText="Database IDs raiz (um por linha)"
                      ShowLabel="true" rows="3" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInputNumber @bind-Value="Model.MaxPages" DisplayText="Máx. páginas (1–1000, padrão 200)"
