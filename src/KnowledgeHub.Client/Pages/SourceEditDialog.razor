@using System.Text.Json.Nodes
@inject IStringLocalizer<SharedStrings> L

@* SPEC-05 RF-002: create/edit form with per-type dynamic config fields.
   SPEC-20260915-sources-edit-dialog: readOnly flag, indexed-content summary,
   friendly error surface and inline sync. *@

<div class="row g-3">
    @if (Model.Id is not null)
    {
        <div class="col-12">
            <div class="border rounded p-3">
                <div class="d-flex justify-content-between gap-2 align-items-center mb-2">
                    <strong>@L["SrcEd_Summary"]</strong>
                    <Button Size="Size.ExtraSmall" Color="Color.Secondary" Icon="fa-solid fa-rotate"
                            Text="@(SyncRunning ? L["SrcEd_Syncing"].Value : L["SrcEd_SyncNow"].Value)"
                            TooltipText="@L["SrcEd_SyncNow"]" TooltipPlacement="Placement.Left"
                            IsDisabled="SyncRunning" OnClick="RequestSyncAsync" />
                </div>
                @if (SummaryLoading)
                {
                    <div class="text-muted small">
                        <i class="fa-solid fa-spinner fa-spin"></i> @L["SrcEd_LoadingSummary"]
                    </div>
                }
                else if (SummaryFailed)
                {
                    <div class="text-muted small">@L["SrcEd_SummaryFailed"]</div>
                }
                else
                {
                    var docs = Documents ?? [];
                    <div class="small">
                        <strong>@docs.Count</strong> @L["SrcEd_DocsSummary",
                            docs.Sum(d => d.ChunkCount),
                            docs.Count > 0 ? docs.Max(d => d.IndexedAt).LocalDateTime.ToString("g") : "—"]
                    </div>
                    <div class="small mt-1">
                        @L["SrcEd_LastSync", Source?.LastSyncAt?.LocalDateTime.ToString("g") ?? "—"]
                        @switch (Source?.LastSyncStatus)
                        {
                            case "completed":
                                <Badge Color="Color.Success">ok</Badge>
                                break;
                            case "failed":
                                <Badge Color="Color.Danger">@L["SrcEd_Failed"]</Badge>
                                break;
                            case "skipped":
                                <Badge Color="Color.Warning">skip</Badge>
                                break;
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Source?.LastError))
                    {
                        <div class="small text-danger mt-1">@L["SrcEd_LastError", Source.LastError]</div>
                    }
                    @if (docs.Count > 0)
                    {
                        <details class="mt-1">
                            <summary class="small">@L["SrcEd_IndexedDocs", Math.Min(docs.Count, 20), docs.Count]</summary>
                            <ul class="small mb-0 mt-1">
                                @foreach (var d in docs.OrderByDescending(x => x.IndexedAt).Take(20))
                                {
                                    <li>@d.Title <span class="text-muted">(@d.ChunkCount chunks)</span></li>
                                }
                            </ul>
                        </details>
                    }
                }
                @if (SyncResult is { } r)
                {
                    <div class="small mt-2 @(r.Status == "failed" ? "text-danger" : "text-muted")">
                        Sync: <strong>@r.Status</strong> — @L["SrcEd_SyncResult",
                            r.DocumentsProcessed, r.DocumentsSkipped, r.DocumentsRemoved,
                            r.ChunksCreated, r.DurationMs.ToString("F0")]
                        @if (!string.IsNullOrEmpty(r.Reason))
                        {
                            <span>(@r.Reason)</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(SyncError))
                {
                    <div class="small text-danger mt-2">@L["SrcEd_SyncFailed", SyncError]</div>
                }
            </div>
        </div>
    }

