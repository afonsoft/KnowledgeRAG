            </label>
            <input type="password" class="form-control font-monospace" @bind="Model.ApiKey"
                   autocomplete="new-password" placeholder="@(Model.HasStoredKey ? "••••••••" : "")" />
        </div>
    }
    @if (Model.Type is SourceType.Notion)
    {
        <div class="col-12">
            <label class="form-label">
                Integration token * @(Model.HasStoredKey ? "(armazenado — em branco mantém o atual)" : "")
            </label>
            <input type="password" class="form-control font-monospace" @bind="Model.NotionToken"
                   autocomplete="new-password" placeholder="@(Model.HasStoredKey ? "••••••••" : "ntn_…")" />
            <div class="form-text">
                Crie uma integração interna em notion.so/my-integrations e compartilhe as páginas/databases com ela.
