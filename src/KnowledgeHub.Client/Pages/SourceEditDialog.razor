        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.Language" DisplayText="Idioma (código ou auto)"
                            ShowLabel="true" PlaceHolder="pt" />
        </div>
        <div class="col-12">
            <BootstrapInput @bind-Value="Model.FolderPath" DisplayText="Pasta com áudios *"
                            ShowLabel="true" PlaceHolder="/data/recordings" />
            <div class="form-text">
                Diretório local não recursivo. Aceita .mp3 .wav .m4a .mp4 .aac .flac .ogg .webm.
