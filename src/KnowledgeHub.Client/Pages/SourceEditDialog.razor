    /// <summary>Client-side required-field validation mirroring SPEC-02 server rules.</summary>
    public string? Validate()
    {
        if (string.IsNullOrWhiteSpace(Model.Name)) return "Nome é obrigatório";
        return Model.Type switch
        {
            SourceType.ObsidianVault or SourceType.DocumentFile
                when string.IsNullOrWhiteSpace(Model.Path) => "Caminho é obrigatório",
            SourceType.WebPage
                when string.IsNullOrWhiteSpace(Model.Url) => "URL é obrigatória",
            SourceType.RssFeed
                when string.IsNullOrWhiteSpace(Model.FeedUrl) => "URL do feed é obrigatória",
            SourceType.YouTube
                when string.IsNullOrWhiteSpace(Model.Urls) => "URLs são obrigatórias (uma por linha)",
            SourceType.RestApi or SourceType.McpProxy
                when string.IsNullOrWhiteSpace(Model.Endpoint) => "Endpoint é obrigatório",
            SourceType.SqlDatabase
                when string.IsNullOrWhiteSpace(Model.Query) => "Query é obrigatória",
            SourceType.SqlDatabase
                when string.IsNullOrEmpty(Model.ConnectionString) && !Model.HasStoredKey
                => "Connection string é obrigatória (em branco mantém a armazenada)",
            SourceType.Notion
                when string.IsNullOrEmpty(Model.NotionToken) && !Model.HasStoredKey
                => "Integration token é obrigatório",
            SourceType.UnstructuredDocument
                when string.IsNullOrWhiteSpace(Model.FolderPath)
                  && string.IsNullOrWhiteSpace(Model.Files)
                => "Informe uma pasta ou ao menos um arquivo",
            SourceType.GitRepository
                when string.IsNullOrWhiteSpace(Model.RepoUrl)
                  && (string.IsNullOrWhiteSpace(Model.Owner) || string.IsNullOrWhiteSpace(Model.RepoName))
                => "Informe a URL do repositório ou owner + nome",
            SourceType.AudioTranscription
                when string.IsNullOrWhiteSpace(Model.FolderPath)
                  && string.IsNullOrWhiteSpace(Model.Files)
                => "Informe uma pasta ou ao menos um arquivo de áudio",
            SourceType.AwsS3 or SourceType.OciStorage
                when string.IsNullOrWhiteSpace(Model.BucketName)
                  || string.IsNullOrWhiteSpace(Model.Region)
                  || string.IsNullOrWhiteSpace(Model.AccessKeyId)
                => "Bucket, região e access key são obrigatórios",
            SourceType.OciStorage
                when string.IsNullOrWhiteSpace(Model.Namespace)
                => "Namespace é obrigatório para OCI",
            SourceType.AwsS3 or SourceType.OciStorage
                when string.IsNullOrEmpty(Model.SecretAccessKey) && !Model.HasStoredKey
                => "Secret access key é obrigatória",
            SourceType.AzureFiles
                when string.IsNullOrWhiteSpace(Model.ShareName)
                => "Share name é obrigatório",
            SourceType.AzureFiles
                when string.IsNullOrEmpty(Model.SecretAccessKey) && !Model.HasStoredKey
                => "Connection string ou account key é obrigatória",
            _ => null
        };
    }

    /// <summary>Config keys owned by this form — removed before re-adding so stale keys don't survive a type switch.</summary>
    private static readonly string[] ManagedKeys =
        ["path", "url", "endpoint", "headers", "connectionString", "query", "readOnly",
         "transport", "namePrefix", "apiKey", "hasKey",
         "token", "rootPageIds", "rootDatabaseIds", "maxPages",
         "bucketName", "region", "namespace", "shareName", "directoryPath", "prefix",
         "glob", "maxFileSizeMB", "accessKeyId", "secretAccessKey", "accountName", "accountKey",
         "chunking", "sharedUrl", "maxFiles",
         "provider", "itemsPath", "titleField", "contentFields", "urlField", "idField",
         "pageParam", "idColumn", "titleColumn", "contentColumns", "urlColumn",
         "maxRows", "commandTimeoutSeconds",
         "feedUrl", "maxItems", "fetchFullContent", "forceRefresh",
         "urls", "language", "includeAutoCaptions", "includeTimestamps", "maxVideos",
         "folderPath", "files", "apiUrl", "strategy", "coordinates", "tableExtraction",
         "repoUrl", "owner", "name", "instanceUrl", "branch",
         "includePatterns", "excludePatterns", "maxFileSizeBytes", "allowPrivateHosts",
         "enableSpeakerDiarization", "enableAutoChapters", "timeoutMinutes"];

    private static readonly List<SelectedItem> TransportItems =
        [new("auto", "auto"), new("http", "http"), new("sse", "sse")];

    private static readonly List<SelectedItem> ChunkingItems =
        [new("", "Auto (estrutural)"), new("semantic", "Semantic (por assunto)"),
         new("visionlayout", "VisionLayout (tabelas/layout)")];

    private static readonly List<SelectedItem> SqlProviderItems =
        [new("sqlite", "SQLite"), new("postgres", "PostgreSQL")];

    private static readonly List<SelectedItem> UnstructuredStrategyItems =
        [new("auto", "auto"), new("hi_res", "hi_res"), new("ocr_only", "ocr_only"), new("fast", "fast")];

    private static readonly List<SelectedItem> GitProviderItems =
        [new("github", "GitHub"), new("gitlab", "GitLab"), new("gitea", "Gitea")];

    private static readonly List<SelectedItem> AudioProviderItems =
        [new("assemblyai", "AssemblyAI"), new("whisper", "OpenAI Whisper")];

    /// <summary>
    /// Builds the JsonObject configuration payload: starts from the original
    /// configuration (preserving unknown keys), clears managed keys, then
    /// writes the per-type fields plus the ObsidianVault readOnly flag.
    /// </summary>
    public JsonObject BuildConfiguration()
    {
        var config = Model.OriginalConfiguration?.DeepClone() as JsonObject ?? new JsonObject();
        foreach (var key in ManagedKeys)
            config.Remove(key);

        switch (Model.Type)
        {
            case SourceType.ObsidianVault:
            case SourceType.DocumentFile:
                config["path"] = Model.Path;
                break;
            case SourceType.WebPage:
                config["url"] = Model.Url;
                break;
            case SourceType.RssFeed:
                config["feedUrl"] = Model.FeedUrl;
                if (Model.MaxItems is not null)
                    config["maxItems"] = Model.MaxItems;
                if (Model.FetchFullContent)
                    config["fetchFullContent"] = true;
                if (Model.ForceRefresh)
                    config["forceRefresh"] = true;
                break;
            case SourceType.YouTube:
                var urlArray = ToJsonArray(Model.Urls);
                if (urlArray.Count > 0)
                    config["urls"] = urlArray;
                if (!string.IsNullOrWhiteSpace(Model.Language))
                    config["language"] = Model.Language;
                if (Model.IncludeAutoCaptions)
                    config["includeAutoCaptions"] = true;
                if (Model.IncludeTimestamps)
                    config["includeTimestamps"] = true;
                if (Model.MaxVideos is not null)
                    config["maxVideos"] = Model.MaxVideos;
                if (Model.ForceRefresh)
                    config["forceRefresh"] = true;
                break;
            case SourceType.RestApi:
                config["endpoint"] = Model.Endpoint;
                // Empty keeps the stored headers; non-empty replaces them (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrWhiteSpace(Model.Headers))
                    config["headers"] = Model.Headers;
                config["hasKey"] = Model.HasStoredKey;
                if (!string.IsNullOrWhiteSpace(Model.ItemsPath))
                    config["itemsPath"] = Model.ItemsPath;
                if (!string.IsNullOrWhiteSpace(Model.TitleField))
                    config["titleField"] = Model.TitleField;
                var contentFields = ToJsonArray(Model.ContentFields);
                if (contentFields.Count > 0)
                    config["contentFields"] = contentFields;
                if (!string.IsNullOrWhiteSpace(Model.IdField))
                    config["idField"] = Model.IdField;
                if (!string.IsNullOrWhiteSpace(Model.UrlField))
                    config["urlField"] = Model.UrlField;
                if (!string.IsNullOrWhiteSpace(Model.PageParam))
                    config["pageParam"] = Model.PageParam;
                if (Model.MaxPages is not null)
                    config["maxPages"] = Model.MaxPages;
                break;
            case SourceType.SqlDatabase:
                config["provider"] = Model.Provider;
                config["query"] = Model.Query;
                // Empty keeps the stored connection string; non-empty replaces it
                // (server moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.ConnectionString))
                    config["connectionString"] = Model.ConnectionString;
                config["hasKey"] = Model.HasStoredKey;
                if (!string.IsNullOrWhiteSpace(Model.IdColumn))
                    config["idColumn"] = Model.IdColumn;
                if (!string.IsNullOrWhiteSpace(Model.TitleColumn))
                    config["titleColumn"] = Model.TitleColumn;
                var contentColumns = ToJsonArray(Model.ContentColumns);
                if (contentColumns.Count > 0)
                    config["contentColumns"] = contentColumns;
                if (!string.IsNullOrWhiteSpace(Model.UrlColumn))
                    config["urlColumn"] = Model.UrlColumn;
                if (Model.MaxRows is not null)
                    config["maxRows"] = Model.MaxRows;
                if (Model.CommandTimeoutSeconds is not null)
                    config["commandTimeoutSeconds"] = Model.CommandTimeoutSeconds;
                break;
            case SourceType.McpProxy:
                config["endpoint"] = Model.Endpoint;
                if (!string.IsNullOrWhiteSpace(Model.Transport) && Model.Transport != "auto")
                    config["transport"] = Model.Transport;
                if (!string.IsNullOrWhiteSpace(Model.NamePrefix))
                    config["namePrefix"] = Model.NamePrefix;
                // Empty keeps the stored key; non-empty replaces it (server moves
                // the value to the encrypted store — never persisted in config).
                if (!string.IsNullOrEmpty(Model.ApiKey))
                    config["apiKey"] = Model.ApiKey;
                break;
            case SourceType.Notion:
                // Empty keeps the stored token; non-empty replaces it (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.NotionToken))
                    config["token"] = Model.NotionToken;
                config["hasKey"] = Model.HasStoredKey;
                var pageIds = ToJsonArray(Model.RootPageIds);
                if (pageIds.Count > 0)
                    config["rootPageIds"] = pageIds;
                var dbIds = ToJsonArray(Model.RootDatabaseIds);
                if (dbIds.Count > 0)
                    config["rootDatabaseIds"] = dbIds;
                if (Model.MaxPages is not null)
                    config["maxPages"] = Model.MaxPages;
                break;
            case SourceType.AwsS3:
            case SourceType.OciStorage:
                if (Model.Type is SourceType.OciStorage)
                    config["namespace"] = Model.Namespace;
                config["bucketName"] = Model.BucketName;
                config["region"] = Model.Region;
                config["accessKeyId"] = Model.AccessKeyId;
                if (!string.IsNullOrWhiteSpace(Model.Prefix))
                    config["prefix"] = Model.Prefix;
                // Empty keeps the stored secret; non-empty replaces it (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.SecretAccessKey))
                    config["secretAccessKey"] = Model.SecretAccessKey;
                break;
            case SourceType.AzureFiles:
                config["shareName"] = Model.ShareName;
                if (!string.IsNullOrWhiteSpace(Model.DirectoryPath))
                    config["directoryPath"] = Model.DirectoryPath;
                if (!string.IsNullOrWhiteSpace(Model.AccountName))
                    config["accountName"] = Model.AccountName;
                if (!string.IsNullOrWhiteSpace(Model.Prefix))
                    config["prefix"] = Model.Prefix;
                // RF-004 (SPEC-20260926-ingestion-connector-integrity): classify
                // by content, not by '=' — base64 account keys are '='-padded.
                if (!string.IsNullOrEmpty(Model.SecretAccessKey))
                    config[AzureCredentialClassifier.LooksLikeConnectionString(Model.SecretAccessKey)
                        ? "connectionString" : "accountKey"] = Model.SecretAccessKey;
                break;
            case SourceType.UnstructuredDocument:
                // SPEC-20260927-unstructured-document-parser-connector.
                if (!string.IsNullOrWhiteSpace(Model.FolderPath))
                    config["folderPath"] = Model.FolderPath;
                var files = ToJsonArray(Model.Files);
                if (files.Count > 0)
                    config["files"] = files;
                if (!string.IsNullOrWhiteSpace(Model.ApiUrl))
                    config["apiUrl"] = Model.ApiUrl;
                if (!string.IsNullOrWhiteSpace(Model.Strategy) && Model.Strategy != "auto")
                    config["strategy"] = Model.Strategy;
                if (Model.Coordinates)
                    config["coordinates"] = true;
                if (!Model.TableExtraction)
                    config["tableExtraction"] = false;
                if (Model.MaxFileSizeMb is not null)
                    config["maxFileSizeMb"] = Model.MaxFileSizeMb;
                // Empty keeps the stored key; non-empty replaces it (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.ApiKey))
                    config["apiKey"] = Model.ApiKey;
                config["hasKey"] = Model.HasStoredKey || !string.IsNullOrEmpty(Model.ApiKey);
                break;
            case SourceType.GitRepository:
                // SPEC-20260927-git-repository-source-connector.
                config["provider"] = string.IsNullOrWhiteSpace(Model.GitProvider)
                    ? "github" : Model.GitProvider;
                if (!string.IsNullOrWhiteSpace(Model.RepoUrl))
                    config["repoUrl"] = Model.RepoUrl;
                if (!string.IsNullOrWhiteSpace(Model.Owner))
                    config["owner"] = Model.Owner;
                if (!string.IsNullOrWhiteSpace(Model.RepoName))
                    config["name"] = Model.RepoName;
                if (!string.IsNullOrWhiteSpace(Model.InstanceUrl))
                    config["instanceUrl"] = Model.InstanceUrl;
                if (!string.IsNullOrWhiteSpace(Model.Branch) && Model.Branch != "main")
                    config["branch"] = Model.Branch;
                if (!string.IsNullOrWhiteSpace(Model.Path))
                    config["path"] = Model.Path;
                var includePatterns = ToJsonArray(Model.IncludePatterns);
                if (includePatterns.Count > 0)
                    config["includePatterns"] = includePatterns;
                var excludePatterns = ToJsonArray(Model.ExcludePatterns);
                if (excludePatterns.Count > 0)
                    config["excludePatterns"] = excludePatterns;
                if (Model.MaxFiles is not null)
                    config["maxFiles"] = Model.MaxFiles;
                if (Model.MaxFileSizeBytes is not null)
                    config["maxFileSizeBytes"] = Model.MaxFileSizeBytes;
                if (Model.AllowPrivateHosts)
                    config["allowPrivateHosts"] = true;
                // Empty keeps the stored PAT; non-empty replaces it (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.GitToken))
                    config["token"] = Model.GitToken;
                config["hasKey"] = Model.HasStoredKey || !string.IsNullOrEmpty(Model.GitToken);
                break;
            case SourceType.AudioTranscription:
                // SPEC-20260927-audio-transcription-connector.
                config["provider"] = string.IsNullOrWhiteSpace(Model.AudioProvider)
                    ? "assemblyai" : Model.AudioProvider;
                if (!string.IsNullOrWhiteSpace(Model.FolderPath))
                    config["folderPath"] = Model.FolderPath;
                var audioFiles = ToJsonArray(Model.Files);
                if (audioFiles.Count > 0)
                    config["files"] = audioFiles;
                if (!string.IsNullOrWhiteSpace(Model.Language))
                    config["language"] = Model.Language;
                if (Model.AudioProvider == "whisper" && !string.IsNullOrWhiteSpace(Model.Endpoint))
                    config["endpoint"] = Model.Endpoint;
                if (!Model.EnableSpeakerDiarization)
                    config["enableSpeakerDiarization"] = false;
                if (!Model.EnableAutoChapters)
                    config["enableAutoChapters"] = false;
                if (Model.TimeoutMinutes is not null)
                    config["timeoutMinutes"] = Model.TimeoutMinutes;
                // Empty keeps the stored key; non-empty replaces it (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.ApiKey))
                    config["apiKey"] = Model.ApiKey;
                config["hasKey"] = Model.HasStoredKey || !string.IsNullOrEmpty(Model.ApiKey);
                break;
            case SourceType.GoogleDrive:
                config["sharedUrl"] = Model.SharedUrl;
                // Empty keeps the stored key; non-empty replaces it (server
                // moves the value to the encrypted store — never persisted).
                if (!string.IsNullOrEmpty(Model.ApiKey))
                    config["apiKey"] = Model.ApiKey;
                else if (Model.HasStoredKey)
                    config["apiKey"] = "***";
                if (Model.MaxFiles is not null)
                    config["maxFiles"] = Model.MaxFiles;
                break;
        }

        if (Model.Type is SourceType.AwsS3 or SourceType.AzureFiles or SourceType.OciStorage
            or SourceType.GoogleDrive)
        {
            if (!string.IsNullOrWhiteSpace(Model.Glob))
                config["glob"] = Model.Glob;
            if (Model.MaxFileSizeMB is not null)
                config["maxFileSizeMB"] = Model.MaxFileSizeMB;
        }

        if (Model.Type is SourceType.ObsidianVault && Model.ReadOnly)
            config["readOnly"] = true;

        if (!string.IsNullOrWhiteSpace(Model.Chunking))
            config["chunking"] = Model.Chunking;

        return config;
    }

    /// <summary>Line/comma-separated textarea → JSON string array.</summary>
    private static JsonArray ToJsonArray(string? raw) =>
        new((raw ?? "")
            .Split(['\n', '\r', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => (JsonNode?)JsonValue.Create(s)).ToArray());

