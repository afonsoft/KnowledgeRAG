        </div>
        <div class="col-12">
            <label class="form-label">
                API Key @(Model.HasStoredKey ? "(armazenada — em branco mantém)" : "(opcional para endpoints locais)")
            </label>
            <BootstrapInput type="password" @bind-Value="Model.ApiKey"
                            PlaceHolder="unstructured-api-key" />
            <div class="form-text">Armazenada criptografada; nunca retornada pela API.</div>
        </div>
