            </div>
        </div>
        <div class="col-12">
            <Textarea @bind-Value="Model.Files" DisplayText="Arquivos avulsos (um por linha, opcional)"
                      ShowLabel="true" rows="2" PlaceHolder="/data/report.pdf&#10;/data/deck.pptx" />
        </div>
        <div class="col-12 col-md-6">
            <BootstrapInput @bind-Value="Model.ApiUrl" DisplayText="Endpoint da API (opcional)"
