@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject KhAuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject IStringLocalizer<SharedStrings> L

<PageTitle>@L["Login_PageTitle"]</PageTitle>
<h1 class="visually-hidden">@L["Login_PageTitle"]</h1>

@* SPEC-20260926-login-split-layout: split panel — login card on the left/top,
   "Conectar Agente de IA ao MCP" first item of the right column followed by the
   client snippets; mobile stacks login first, prompt after. *@
<div class="row min-vh-100 align-items-start g-4 py-4">
    <div class="col-12 col-lg-5 order-1">
        <div class="card shadow-sm mx-auto" style="max-width: 380px;">
            <div class="card-body">
                <h4 class="card-title mb-1">Knowledge</h4>
                <p class="text-muted mb-4">@L["Login_Subtitle"]</p>

                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_error</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="login-username">@L["Login_Username"]</label>
                    <input class="form-control" id="login-username" @bind="_username" @bind:event="oninput" autocomplete="username" />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="login-password">@L["Login_Password"]</label>
                    <input class="form-control" id="login-password" type="password" @bind="_password" @bind:event="oninput"
                           autocomplete="current-password" @onkeydown="OnEnter" />
                </div>

                <Button Color="Color.Primary" Text="@L["Login_Submit"]" IsAsync="true" IsBlock="true"
                        OnClick="DoLogin" IsDisabled="_busy" />
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7 order-2">
        <div class="mx-auto" style="max-width: 640px;">
            <div class="card border-primary border-opacity-25 shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <span class="fw-semibold">
                            <i class="fa-solid fa-robot text-primary me-2"></i>@L["Home_CardTitle"]
                        </span>
                        <Button Size="Size.ExtraSmall" Color="Color.Primary" Icon="fa-solid fa-copy"
                                TooltipText="@L["Home_CopyTooltip"]" TooltipPlacement="Placement.Left"
                                OnClick="() => CopySnippet(LlmConfigPrompt)" />
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        @L["Login_PromptHelp1"] <code>aft_*</code> @L["Login_PromptHelp2"] <strong>API Keys</strong> @L["Login_PromptHelp3"]
                    </p>
                    <pre class="bg-light border rounded p-3 mb-0 small" style="white-space: pre-wrap; font-family: var(--bs-font-monospace); font-size: 0.85rem; max-height: 300px; overflow-y: auto;"><code>@LlmConfigPrompt</code></pre>
                </div>
            </div>

            <h5 class="mb-1">@L["Login_ClientsTitle"]</h5>
            <p class="text-muted small mb-3">
                @L["Login_ClientsIntro1"] <code>aft_*</code> @L["Login_ClientsIntro2"] <strong>API Keys</strong> @L["Login_ClientsIntro3"]
            </p>
            <div class="border rounded bg-body-tertiary p-2 mb-3 small">
                <div><strong>Streamable HTTP</strong> @L["Login_Recommended"]: <code>@_mcpUrl</code></div>
                @if (_legacySse)
                {
                    <div class="mt-1"><strong>Legacy SSE</strong>: <code>@_sseUrl</code>
                        <span class="text-muted">@L["Login_NoHeader"] <code>?access_token=aft_...</code></span></div>
                }
            </div>

            @foreach (var c in _clients)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between gap-2 align-items-center">
                        <strong class="small">@c.Name</strong>
                        <Button Size="Size.ExtraSmall" Color="Color.Secondary" IsOutline="true"
                                Icon="fa-solid fa-copy" TooltipText="@L["Common_Copy"]"
                                TooltipPlacement="Placement.Left"
                                OnClick="() => CopySnippet(c.Snippet)" />
                    </div>
                    <pre class="small mb-0 mt-1 text-muted" style="white-space:pre-wrap;word-break:break-all">@c.Snippet</pre>
                </div>
            }

            @if (_legacySse)
            {
                <p class="text-muted small mt-3 mb-0">
                    @L["Login_SseNote1"] <code>@_sseUrl</code>@L["Login_SseNote2"] <code>?access_token=</code> @L["Login_SseNote3"]
                </p>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _busy;
    private string _mcpUrl = "";
    private string _sseUrl = "";
    private List<(string Name, string Snippet)> _clients = [];
    private bool _legacySse = true;

    private string LlmConfigPrompt => McpOnboardingPrompt.Build(Nav.BaseUri.TrimEnd('/'));

    protected override async Task OnInitializedAsync()
    {
        var baseUri = Nav.BaseUri.TrimEnd('/');
        _mcpUrl = $"{baseUri}/mcp";
        _sseUrl = $"{baseUri}/mcp/sse";
        _legacySse = await Auth.LegacySseEnabledAsync();

        // SPEC-20260926-login-split-layout RF-003: ordered Claude Code → Devin →
        // opencode → agy (Claude Desktop intentionally omitted).
        _clients =
        [
            ("Claude Code",
             $"claude mcp add --transport http knowledgehub {_mcpUrl} \\\n  --header \"Authorization: Bearer aft_...\""),
            ("Devin",
             $"Org/user settings → MCP servers → add custom server:\n" +
             $"  URL: {_mcpUrl}\n  Header: Authorization: Bearer aft_...\n" +
             (_legacySse ? $"(SSE-only flows: {_sseUrl}?access_token=aft_...)" : "")),
            ("opencode",
             "// opencode.json\n{\n  \"mcp\": {\n    \"knowledgehub\": {\n" +
             $"      \"type\": \"remote\",\n      \"url\": \"{_mcpUrl}\",\n" +
             "      \"headers\": { \"Authorization\": \"Bearer aft_...\" }\n    }\n  }\n}"),
            ("agy (Antigravity)",
             "// ~/.gemini/antigravity/mcp_config.json\n{\n  \"mcpServers\": {\n" +
             $"    \"knowledgehub\": {{\n      \"url\": \"{_mcpUrl}\",\n" +
             "      \"headers\": { \"Authorization\": \"Bearer aft_...\" }\n    }\n  }\n}"),
        ];
    }

    private async Task CopySnippet(string snippet)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", snippet); }
        catch { /* clipboard API may be unavailable (non-secure context) */ }
    }

    private async Task OnEnter(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.LoginAsync(_username.Trim(), _password);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.Error ?? L["Login_Fail"];
                return;
            }

            AuthState.SetUser(new MeResponse(result.Value.Username, result.Value.MustChangePassword));
            var target = "change-password";
            if (!result.Value.MustChangePassword)
            {
                // ReturnUrl vem da query string — rebuild como path relativo à
                // BaseUri e navega só em PathAndQuery: o destino é local por
                // construção (scheme/host nunca podem virar externos).
                var returnPath = ReturnUrl?.Replace('\\', '/').TrimStart('/');
                target = returnPath is not null
                    && !returnPath.Contains(':')
                    && !returnPath.Contains('%')
                    && Uri.TryCreate(new Uri(Nav.BaseUri), returnPath, out var uri)
                    ? uri.PathAndQuery
                    : "";
            }
            Nav.NavigateTo(target);
        }
        finally
        {
            _busy = false;
        }
    }
}
