{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/knowledgehub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {RequestId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Host": {
    "ShutdownTimeoutSeconds": 30
  },
  "Mcp": {
    "MaxConcurrentCallsPerSession": 8,
    "ActivityFeedCapacity": 500
  },
  "Search": {
    "Lexical": {
      "Enabled": true
    },
    "LimitMode": "autocut",
    "Autocut": {
      "Sensitivity": 1,
      "MaxClamp": 20
    },
    "Expansion": {
      "WindowThresholdPercent": 80
    },
    "Relaxation": {
      "Enabled": true,
      "MinResults": 1
    }
  },
  "Ingestion": {
    "Chunking": {
      "PreserveTableHeaders": true,
      "MaxTableChunkRows": 30,
      "EnableVisionCaptioning": false
    }
  },
  "Chat": {
    "Provider": "none",
    "TimeoutSeconds": 120
  },
  "DeepWiki": {
    "Enabled": true,
    "Endpoint": "https://mcp.deepwiki.com/mcp",
    "PrivateEndpoint": "https://mcp.devin.ai/mcp",
    "ApiKey": "",
    "TimeoutSeconds": 60
  },
  "Firecrawl": {
    "Enabled": true,
    "Endpoint": "https://mcp.firecrawl.dev/v2/mcp",
    "ApiKey": "",
    "TimeoutSeconds": 300,
    "ToolsCacheSeconds": 300
  },
  "Tavily": {
    "Enabled": true,
    "Endpoint": "https://mcp.tavily.com/mcp",
    "ApiKey": "",
    "TimeoutSeconds": 120,
    "ToolsCacheSeconds": 300
  },
  "Context7": {
    "Enabled": true,
    "Endpoint": "https://mcp.context7.com/mcp",
    "ApiKey": "",
    "TimeoutSeconds": 60,
    "ToolsCacheSeconds": 300
  },
  "Cache": {
    "Provider": "memory",
    "Redis": {
      "ConnectionString": ""
    },
    "AnswerCache": {
      "Enabled": false,
      "TtlSeconds": 600
    }
  },
  "Telemetry": {
    "Otlp": {
      "Endpoint": ""
    },
    "Metrics": {
      "Prometheus": false
    }
  },
  "Graph": {
    "Enabled": true,
    "MaxChunksPerSync": 200,
    "MaxChunkChars": 2000,
    "MaxResults": 200
  },
  "Resilience": {
    "Fallback": {
      "Mode": "disabled",
      "MaxFallbackAttempts": 2,
      "ChatFallbacks": [],
      "ToolCapabilities": {
        "WebSearch": [
          "tavily",
          "firecrawl",
          "duckduckgo"
        ],
        "DeepDocLookup": [
          "deepwiki",
          "context7",
          "internal_fts"
        ]
      }
    }
  },
  "Agent": {
    "ContextManagement": {
      "EnableChainCompaction": true,
      "MaxTotalHistoryBytes": 65536,
      "MaxBodyPairBytes": 16384,
      "KeepMinLastSections": 2,
      "AutoRepairBrokenToolCalls": true
    },
    "EnableDynamicActionBridge": true,
    "MaxChainedDynamicCalls": 3
  }
}
