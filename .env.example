# .env.example — KnowledgeHub environment template (SPEC-20260916-deploy-env-docs).
# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
# docker compose and install.sh read .env automatically. Defaults below match
# docker-compose.yml — commented values are optional.

# --- Deployment -------------------------------------------------------------
# Host port published for the container (container listens on :8080).
KNOWLEDGEHUB_PORT=5000
# Kestrel AllowedHosts — '*' behind a tunnel/reverse proxy, or pin the public
# hostname (e.g. rag.example.com).
ALLOWED_HOSTS=*

# --- Default Obsidian vault ---------------------------------------------------
# First-boot seed: while no ObsidianVault source exists, one is registered at
# VAULT_PATH (the compose `vault` named volume is mounted there). Vault tools
# (write_note / write_knowledge / read_document) then work out of the box.
# Opt out: VAULT_PATH= (empty). Remove the seeded source in the UI later and
# it stays gone only while another ObsidianVault source exists — otherwise the
# seeder recreates it on the next boot unless VAULT_PATH is empty.
VAULT_PATH=/vaults/default
VAULT_NAME=Default Vault

# --- Embeddings --------------------------------------------------------------
# deterministic (zero-infra default) | ollama | openai
EMBEDDINGS_PROVIDER=deterministic
# Required for ollama/openai — host.docker.internal reaches services on the host.
EMBEDDINGS_ENDPOINT=http://host.docker.internal:11434
EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_APIKEY=

# --- Unified database provider (catalog EF + vector store) --------------------
# auto (default) probes POSTGRES_* and falls back to SQLite when unreachable;
# postgres forces it (missing connstring = startup error); sqlite forces local.
DATABASE_PROVIDER=auto
# For postgres, the connection string is composed from these discrete vars
# (proxyLLM-AI pattern). host.docker.internal reaches Postgres on the Docker
# host — its pg_hba.conf must allow this container's subnet for the db/user.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
# POSTGRES_PASSWORD=
# Escape hatch: when set, takes precedence over the POSTGRES_* composition,
# e.g. Host=...;Database=...;Username=...;Password=...;SSL Mode=Require
# DATABASE_CONNECTIONSTRING=

# --- Vector store (override) ---------------------------------------------------
# Leave unset to follow DATABASE_PROVIDER (recommended). Set explicitly only
# for mixed mode: sqlite (default) | sqlite-vec | postgres (pgvector).
# VECTORSTORE_PROVIDER=
# VECTORSTORE_CONNECTIONSTRING= (same escape hatch for the vector store)

# --- LLM chat (server-side answer synthesis / agent loop) ---------------------
# Not wired in docker-compose.yml — any ASP.NET Core setting can be injected
# via environment: Chat__Provider=ollama, Chat__Endpoint=..., Chat__Model=...,
# Chat__ApiKey=... (see README "Configuration").
# CHAT__PROVIDER=ollama
# CHAT__ENDPOINT=http://host.docker.internal:11434
# CHAT__MODEL=llama3.1
# CHAT__APIKEY=

# --- DeepWiki upstream MCP proxy ----------------------------------------------
DEEPWIKI_ENABLED=true
DEEPWIKI_ENDPOINT=https://mcp.deepwiki.com/mcp
DEEPWIKI_PRIVATE_ENDPOINT=https://mcp.devin.ai/mcp
# DEEPWIKI_APIKEY=

# --- Firecrawl upstream MCP proxy ----------------------------------------------
FIRECRAWL_ENABLED=true
FIRECRAWL_ENDPOINT=https://mcp.firecrawl.dev/v2/mcp
# FIRECRAWL_APIKEY=
FIRECRAWL_TIMEOUT_SECONDS=300

# --- Tavily upstream MCP proxy -------------------------------------------------
TAVILY_ENABLED=true
TAVILY_ENDPOINT=https://mcp.tavily.com/mcp
# TAVILY_APIKEY=
TAVILY_TIMEOUT_SECONDS=120

# --- Context7 upstream MCP proxy ------------------------------------------------
CONTEXT7_ENABLED=true
CONTEXT7_ENDPOINT=https://mcp.context7.com/mcp
# CONTEXT7_APIKEY=
CONTEXT7_TIMEOUT_SECONDS=60

# --- Distributed cache ----------------------------------------------------------
# memory (default, zero-infra) | redis
CACHE_PROVIDER=memory
# Required when CACHE_PROVIDER=redis. Host Redis example:
#   REDIS_CONNECTIONSTRING=host.docker.internal:6379,defaultDatabase=3
# Add ",password=<secret>" when the server requires auth — see README
# "Redis security" (an unauthenticated Redis exposes cached data).
# REDIS_CONNECTIONSTRING=

# --- MCP server transport --------------------------------------------------------
# Streamable HTTP session mode on /mcp. StatefulForInitializeClients (default,
# hybrid): initialize-handshake clients (≤2025-11-25, incl. legacy /mcp/sse) keep
# full sessions + list_changed push; 2026-07-28 clients are served statelessly
# (no session, re-list tools on demand). Stateless: no sessions at all (legacy
# SSE disabled). Stateful: back-compat only — refuses 2026-07-28 clients.
# MCP__SESSIONMODE=StatefulForInitializeClients
# Max concurrent tools/call per session (sessionless calls share one bucket):
# MCP__MAXCONCURRENTCALLSPERSESSION=8

# --- Auth ----------------------------------------------------------------------
# Seed password for the `admin` user created on first startup. The forced
# password change applies on first login regardless — still override this.
AUTH_ADMIN_INITIAL_PASSWORD=123qwe
