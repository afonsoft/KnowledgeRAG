<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Audit 2026-10-03: source-generated code (STJ SharedJsonContext etc.)
               inflates the instrumented line count without any testable logic —
               exclude *.g.cs so the ratchet measures hand-written code. -->
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
