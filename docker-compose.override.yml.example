# docker-compose.override.yml.example — host-specific layer for the base
# docker-compose.yml (SPEC-20260916-compose-vault-mount).
#
# Docker Compose applies `docker-compose.override.yml` automatically on top of
# the base file. Copy this file to `docker-compose.override.yml` (gitignored)
# and adjust the host paths for your machine:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# A clean checkout WITHOUT the override deploys fine — the base compose mounts
# the `vault` named volume at /vaults/default and the first-boot seeder
# (Vault:Path) registers it as an ObsidianVault source. Use this override only
# to mount ADDITIONAL vaults (host dirs, WebDAV mounts) under /vaults/*.
services:
  knowledgerag:
    volumes:
      # Local Obsidian vault, mounted rw so the obsidian_write MCP tool can
      # persist notes. Host path is machine-specific — this one is the
      # OpenClaw workspace vault on the production VPS.
      - /home/ubuntu/.openclaw/workspace/vault:/vaults/obsidian
      # Remote vault via WebDAV: mount it on the HOST first (davfs2/rclone —
      # see README "Obsidian via WebDAV"), then bind it read-only:
      #   - /srv/webdav/obsidian:/vaults/webdav:ro
    environment:
      # Chat provider wiring (SPEC-20260918-compose-override-chat-example).
      # The base docker-compose.yml intentionally does NOT map Chat__* —
      # chat is a host-local choice and lives in this override layer.
      # Values resolve from .env (CHAT__PROVIDER/ENDPOINT/MODEL/APIKEY —
      # see .env.example). Without this block, .env's CHAT__* never reach
      # the container and chat stays disabled.
      Chat__Provider: ${CHAT__PROVIDER:-none}
      Chat__Endpoint: ${CHAT__ENDPOINT:-}
      Chat__Model: ${CHAT__MODEL:-}
      Chat__ApiKey: ${CHAT__APIKEY:-}
